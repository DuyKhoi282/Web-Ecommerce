@model WebEcommerce.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Bảng điều khiển Tổng quan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="font-headline font-black text-2xl sm:text-3xl text-slate-900 tracking-tight">Bảng điều khiển tổng quan</h1>
        @if (User.IsInRole("Administrator"))
        {
            <p class="text-xs sm:text-sm text-slate-600 mt-1 font-medium">Xin chào Quản trị viên! Dưới đây là tình hình hoạt động tổng thể hệ thống và người dùng ShopeChill.</p>
        }
        else
        {
            <p class="text-xs sm:text-sm text-slate-600 mt-1 font-medium">Xin chào Người bán! Dưới đây là tình hình kinh doanh, doanh thu, đơn hàng và hàng hóa của bạn.</p>
        }
    </div>
    @if (User.IsInRole("Administrator"))
    {
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Index", "Product")" class="px-5 py-2.5 bg-[#d70018] hover:bg-[#b91c1c] text-white text-xs font-black rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-2 border-2 border-[#d70018]">
                <span class="material-symbols-outlined text-base">inventory_2</span>
                <span>Quản lý sản phẩm</span>
            </a>
            <a href="@Url.Action("Index", "AdminUser")" class="px-4 py-2.5 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl shadow-sm border border-slate-300 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-base text-slate-500">person_search</span>
                <span>Quản lý người dùng</span>
            </a>
        </div>
    }
    else if (User.IsInRole("StoreManager"))
    {
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Create", "Product")" class="px-5 py-2.5 bg-[#d70018] hover:bg-[#b91c1c] text-white text-xs font-black rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-2 border-2 border-[#d70018]">
                <span class="material-symbols-outlined text-base">add_circle</span>
                <span>Thêm sản phẩm</span>
            </a>
            <a href="@Url.Action("Index", "AdminOrder")" class="px-4 py-2.5 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl shadow-sm border border-slate-300 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-base text-slate-500">receipt_long</span>
                <span>Xem đơn hàng</span>
            </a>
        </div>
    }
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="mb-6 rounded-2xl bg-amber-50 text-amber-900 border-2 border-amber-300 p-4 text-xs sm:text-sm flex items-center gap-2.5 shadow-sm">
        <span class="material-symbols-outlined text-amber-600 text-xl font-bold">info</span>
        <span class="font-semibold">@ViewBag.ErrorMessage</span>
    </div>
}

<!-- 4 KPI Metric Cards (Viền rõ nét, Tách nền tuyệt đối trên #e9eff6) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Card 1: Revenue -->
    <div class="bg-white rounded-2xl border border-slate-300 border-t-4 border-t-emerald-500 hover:border-emerald-500 p-5 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.08)] hover:shadow-lg transition-all duration-200 flex items-center justify-between">
        <div>
            <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Tổng doanh thu</span>
            <span class="block text-2xl font-black font-headline text-slate-900 mt-1">@Model.TotalRevenue.ToString("N0") ₫</span>
            <span class="block text-[11px] text-emerald-600 font-bold mt-1.5 flex items-center gap-0.5">
                <span class="material-symbols-outlined text-sm font-bold">trending_up</span> +18.2% so với tháng trước
            </span>
        </div>
        <div class="w-13 h-13 rounded-2xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center p-3 shadow-xs">
            <span class="material-symbols-outlined text-2xl font-bold">payments</span>
        </div>
    </div>

    <!-- Card 2: Orders -->
    <a href="@Url.Action("Index", "AdminOrder")" class="block bg-white rounded-2xl border border-slate-300 border-t-4 border-t-[#ff4d4d] hover:border-[#ff4d4d] p-5 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.08)] hover:shadow-lg transition-all duration-200 flex items-center justify-between group cursor-pointer">
        <div>
            <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Tổng đơn hàng</span>
            <span class="block text-2xl font-black font-headline text-slate-900 mt-1">@Model.TotalOrders.ToString("N0")</span>
            <span class="block text-[11px] text-[#ff4d4d] font-bold mt-1.5 flex items-center gap-0.5 group-hover:underline">
                <span class="material-symbols-outlined text-sm font-bold">shopping_cart</span> Đơn mua hàng &rarr;
            </span>
        </div>
        <div class="w-13 h-13 rounded-2xl bg-rose-50 text-[#ff4d4d] border border-rose-200 flex items-center justify-center p-3 shadow-xs group-hover:scale-105 transition-transform">
            <span class="material-symbols-outlined text-2xl font-bold">receipt_long</span>
        </div>
    </a>

    <!-- Card 3: Customers -->
    @if (User.IsInRole("Administrator"))
    {
        <a href="@Url.Action("Index", "AdminUser")" class="block bg-white rounded-2xl border border-slate-300 border-t-4 border-t-[#d70018] hover:border-[#d70018] p-5 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.08)] hover:shadow-lg transition-all duration-200 flex items-center justify-between group cursor-pointer">
            <div>
                <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Khách hàng</span>
                <span class="block text-2xl font-black font-headline text-slate-900 mt-1">@Model.TotalCustomers.ToString("N0")</span>
                <span class="block text-[11px] text-[#d70018] font-bold mt-1.5 flex items-center gap-0.5 group-hover:underline">
                    <span class="material-symbols-outlined text-sm font-bold">group</span> Thành viên đăng ký &rarr;
                </span>
            </div>
            <div class="w-13 h-13 rounded-2xl bg-red-50 text-[#d70018] border border-red-200 flex items-center justify-center p-3 shadow-xs group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-2xl font-bold">person</span>
            </div>
        </a>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-slate-300 border-t-4 border-t-[#d70018] hover:border-[#d70018] p-5 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.08)] hover:shadow-lg transition-all duration-200 flex items-center justify-between">
            <div>
                <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Khách hàng</span>
                <span class="block text-2xl font-black font-headline text-slate-900 mt-1">@Model.TotalCustomers.ToString("N0")</span>
                <span class="block text-[11px] text-[#d70018] font-bold mt-1.5 flex items-center gap-0.5">
                    <span class="material-symbols-outlined text-sm font-bold">group</span> Thành viên đăng ký
                </span>
            </div>
            <div class="w-13 h-13 rounded-2xl bg-red-50 text-[#d70018] border border-red-200 flex items-center justify-center p-3 shadow-xs">
                <span class="material-symbols-outlined text-2xl font-bold">person</span>
            </div>
        </div>
    }

    <!-- Card 4: Products -->
    <a href="@Url.Action("Index", "Product")" class="block bg-white rounded-2xl border border-slate-300 border-t-4 border-t-purple-600 hover:border-purple-600 p-5 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.08)] hover:shadow-lg transition-all duration-200 flex items-center justify-between group cursor-pointer">
        <div>
            <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Sản phẩm trong kho</span>
            <span class="block text-2xl font-black font-headline text-slate-900 mt-1">@Model.TotalProducts.ToString("N0")</span>
            <span class="block text-[11px] text-purple-600 font-bold mt-1.5 flex items-center gap-0.5 group-hover:underline">
                <span class="material-symbols-outlined text-sm font-bold">inventory_2</span> Danh mục hàng hóa &rarr;
            </span>
        </div>
        <div class="w-13 h-13 rounded-2xl bg-purple-50 text-purple-600 border border-purple-200 flex items-center justify-center p-3 shadow-xs group-hover:scale-105 transition-transform">
            <span class="material-symbols-outlined text-2xl font-bold">category</span>
        </div>
    </a>
</div>

<!-- Revenue & Order Status Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <div class="bg-white rounded-2xl border border-slate-300 p-6 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.06)]">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200">
            <div>
                <h2 class="font-headline font-black text-lg text-slate-900">Biểu đồ doanh thu</h2>
                <p class="text-xs text-slate-500 font-medium">Doanh thu kinh doanh 6 tháng gần nhất</p>
            </div>
            <span class="text-xs font-black text-[#d70018] bg-red-50 px-3.5 py-1.5 rounded-full border border-red-200">
                Năm @DateTime.Now.Year
            </span>
        </div>
        <div class="w-full h-72">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>
    
    <div class="bg-white rounded-2xl border border-slate-300 p-6 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.06)]">
        <div class="mb-4 pb-3 border-b border-slate-200">
            <h2 class="font-headline font-black text-lg text-slate-900">Trạng thái đơn hàng</h2>
            <p class="text-xs text-slate-500 font-medium">Tỷ lệ các trạng thái đơn hàng hiện tại</p>
        </div>
        <div class="w-full h-72 flex justify-center">
            <canvas id="orderStatusChart"></canvas>
        </div>
    </div>
</div>

<!-- 2-Column: Recent Orders & Top Selling Products -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left: Recent Orders (7 cols) -->
    <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-300 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.06)] overflow-hidden">
        <div class="p-5 border-b border-slate-200 flex items-center justify-between bg-slate-50/70">
            <h3 class="font-headline font-black text-base text-slate-900">Đơn hàng mới nhất</h3>
            @if (User.IsInRole("StoreManager"))
            {
                <a href="@Url.Action("Index", "AdminOrder")" class="text-xs font-bold text-[#d70018] hover:underline flex items-center gap-1">
                    Xem tất cả <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </a>
            }
            else
            {
                <span class="text-xs font-bold text-[#d70018] bg-red-50 px-2.5 py-1 rounded-lg border border-red-200">Gần đây</span>
            }
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-100 text-slate-700 uppercase tracking-wider text-[11px] font-black border-b border-slate-200">
                        <th class="py-3.5 px-4">Mã đơn</th>
                        <th class="py-3.5 px-4">Khách hàng</th>
                        <th class="py-3.5 px-4">Ngày đặt</th>
                        <th class="py-3.5 px-4">Tổng tiền</th>
                        <th class="py-3.5 px-4">Trạng thái</th>
                    </tr>
                </thead>
                <tbody class="divide-y-2 divide-slate-100">
                    @if (Model.RecentOrders == null || !Model.RecentOrders.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-500 font-medium">Chưa có đơn hàng nào trong hệ thống.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var ord in Model.RecentOrders)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-3.5 px-4 font-black text-[#d70018]">#@ord.OrderID</td>
                                <td class="py-3.5 px-4 text-slate-900 font-bold">@ord.CustomerName</td>
                                <td class="py-3.5 px-4 text-slate-600 font-medium">@ord.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td class="py-3.5 px-4 font-black text-slate-900">@ord.FinalAmount.ToString("N0") ₫</td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800 border border-emerald-300">
                                        @ord.OrderStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right: Top Products (5 cols) -->
    <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-300 shadow-[0_4px_16px_-2px_rgba(15,23,42,0.06)] p-5">
        <div class="mb-4 pb-3 border-b border-slate-200 flex items-center justify-between">
            <h3 class="font-headline font-black text-base text-slate-900">Sản phẩm nổi bật trong kho</h3>
            @if (User.IsInRole("StoreManager"))
            {
                <a href="@Url.Action("Index", "Product")" class="text-xs font-bold text-[#d70018] hover:underline flex items-center gap-1">
                    Quản lý kho <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </a>
            }
        </div>
        <div class="space-y-3">
            @if (Model.TopProducts == null || !Model.TopProducts.Any())
            {
                <p class="text-xs text-slate-500 font-medium text-center py-6">Chưa có sản phẩm nào trong kho.</p>
            }
            else
            {
                foreach (var prod in Model.TopProducts)
                {
                    <div class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 border border-slate-200 transition-colors">
                        <div class="w-11 h-11 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-[#d70018] shrink-0 font-bold">
                            <span class="material-symbols-outlined text-xl">devices</span>
                        </div>
                        <div class="flex-1 truncate">
                            <h4 class="text-xs font-bold text-slate-900 truncate">@prod.ProductName</h4>
                            <span class="text-[11px] font-black text-[#d70018]">@prod.Price.ToString("N0") ₫</span>
                        </div>
                        <span class="text-xs font-black text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">Còn hàng</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            $.getJSON('@Url.Action("GetRevenueData", "AdminDashboard")', function(data) {
                // Bar Chart
                const ctxRev = document.getElementById('revenueChart').getContext('2d');
                new Chart(ctxRev, {
                    type: 'bar',
                    data: {
                        labels: data.months,
                        datasets: [{
                            label: 'Doanh thu (VNĐ)',
                            data: data.revenues,
                            backgroundColor: 'rgba(215, 0, 24, 0.8)',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(val) {
                                        return (val / 1000000).toLocaleString() + ' Tr';
                                    }
                                }
                            }
                        }
                    }
                });

                // Doughnut Chart
                const ctxStatus = document.getElementById('orderStatusChart').getContext('2d');
                new Chart(ctxStatus, {
                    type: 'doughnut',
                    data: {
                        labels: data.statusLabels,
                        datasets: [{
                            data: data.statusData,
                            backgroundColor: [
                                '#d70018',
                                '#ff4d4d',
                                '#fca5a5',
                                '#f87171',
                                '#b91c1c'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'right' }
                        }
                    }
                });
            }).fail(function() {
                console.error("Lỗi tải data chart");
            });
        });
    </script>
}

