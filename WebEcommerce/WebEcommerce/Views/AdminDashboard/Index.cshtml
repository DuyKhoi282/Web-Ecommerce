@model WebEcommerce.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Bảng điều khiển Tổng quan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="font-headline font-bold text-2xl sm:text-3xl text-slate-900 tracking-tight">Bảng điều khiển tổng quan</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Xin chào! Dưới đây là tình hình hoạt động kinh doanh và người dùng của TheChillShop.</p>
    </div>
    <div class="flex items-center gap-3">
        <a href="@Url.Action("Index", "AdminUser")" class="px-4 py-2 bg-[#0d47a1] hover:bg-[#0a3880] text-white text-xs font-semibold rounded-xl shadow-sm transition-all flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base">person_search</span>
            <span>Quản lý người dùng</span>
        </a>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="mb-6 rounded-2xl bg-amber-50 text-amber-800 border border-amber-200 p-4 text-xs sm:text-sm flex items-center gap-2">
        <span class="material-symbols-outlined text-amber-600 text-lg">info</span>
        <span>@ViewBag.ErrorMessage</span>
    </div>
}

<!-- 4 KPI Metric Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Card 1: Revenue -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm flex items-center justify-between">
        <div>
            <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Tổng doanh thu</span>
            <span class="block text-2xl font-bold font-headline text-slate-900 mt-1">@Model.TotalRevenue.ToString("N0") ₫</span>
            <span class="block text-[11px] text-emerald-600 font-semibold mt-1 flex items-center gap-0.5">
                <span class="material-symbols-outlined text-sm">trending_up</span> +18.2% so với tháng trước
            </span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">payments</span>
        </div>
    </div>

    <!-- Card 2: Orders -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm flex items-center justify-between">
        <div>
            <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Tổng đơn hàng</span>
            <span class="block text-2xl font-bold font-headline text-slate-900 mt-1">@Model.TotalOrders.ToString("N0")</span>
            <span class="block text-[11px] text-[#00b4d8] font-semibold mt-1 flex items-center gap-0.5">
                <span class="material-symbols-outlined text-sm">shopping_cart</span> Đơn mua hàng
            </span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-cyan-50 text-[#00b4d8] flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">receipt_long</span>
        </div>
    </div>

    <!-- Card 3: Customers -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm flex items-center justify-between">
        <div>
            <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Khách hàng</span>
            <span class="block text-2xl font-bold font-headline text-slate-900 mt-1">@Model.TotalCustomers.ToString("N0")</span>
            <span class="block text-[11px] text-[#0d47a1] font-semibold mt-1 flex items-center gap-0.5">
                <span class="material-symbols-outlined text-sm">group</span> Thành viên đăng ký
            </span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-blue-50 text-[#0d47a1] flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">person</span>
        </div>
    </div>

    <!-- Card 4: Products -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm flex items-center justify-between">
        <div>
            <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Sản phẩm trong kho</span>
            <span class="block text-2xl font-bold font-headline text-slate-900 mt-1">@Model.TotalProducts.ToString("N0")</span>
            <span class="block text-[11px] text-purple-600 font-semibold mt-1 flex items-center gap-0.5">
                <span class="material-symbols-outlined text-sm">inventory_2</span> Danh mục hàng hóa
            </span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">category</span>
        </div>
    </div>
</div>

<!-- Revenue Chart Section -->
<div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm mb-8">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="font-headline font-bold text-lg text-slate-900">Biểu đồ doanh thu</h2>
            <p class="text-xs text-slate-500">Doanh thu kinh doanh 6 tháng gần nhất</p>
        </div>
        <span class="text-xs font-semibold text-[#0d47a1] bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
            Năm @DateTime.Now.Year
        </span>
    </div>
    <div class="w-full h-72">
        <canvas id="revenueChart"></canvas>
    </div>
</div>

<!-- 2-Column: Recent Orders & Top Selling Products -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left: Recent Orders (7 cols) -->
    <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-headline font-bold text-base text-slate-900">Đơn hàng mới nhất</h3>
            <span class="text-xs text-slate-400">Gần đây</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px]">
                        <th class="py-3 px-4">Mã đơn</th>
                        <th class="py-3 px-4">Khách hàng</th>
                        <th class="py-3 px-4">Ngày đặt</th>
                        <th class="py-3 px-4">Tổng tiền</th>
                        <th class="py-3 px-4">Trạng thái</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.RecentOrders == null || !Model.RecentOrders.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-400">Chưa có đơn hàng nào trong hệ thống.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var ord in Model.RecentOrders)
                        {
                            <tr class="hover:bg-slate-50/50">
                                <td class="py-3 px-4 font-bold text-[#0d47a1]">#@ord.OrderID</td>
                                <td class="py-3 px-4 text-slate-800">@ord.CustomerName</td>
                                <td class="py-3 px-4 text-slate-500">@ord.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td class="py-3 px-4 font-semibold text-slate-900">@ord.FinalAmount.ToString("N0") ₫</td>
                                <td class="py-3 px-4">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-700">
                                        @ord.OrderStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right: Top Products (5 cols) -->
    <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5">
        <h3 class="font-headline font-bold text-base text-slate-900 mb-4">Sản phẩm nổi bật trong kho</h3>
        <div class="space-y-3">
            @if (Model.TopProducts == null || !Model.TopProducts.Any())
            {
                <p class="text-xs text-slate-400 text-center py-6">Chưa có sản phẩm nào trong kho.</p>
            }
            else
            {
                foreach (var prod in Model.TopProducts)
                {
                    <div class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                        <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400 shrink-0">
                            <span class="material-symbols-outlined text-lg">checkroom</span>
                        </div>
                        <div class="flex-1 truncate">
                            <h4 class="text-xs font-semibold text-slate-800 truncate">@prod.ProductName</h4>
                            <span class="text-[11px] text-slate-500">@prod.Price.ToString("N0") ₫</span>
                        </div>
                        <span class="text-xs font-bold text-emerald-600">Còn hàng</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart').getContext('2d');
        const labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartLabels));
        const dataValues = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartRevenueData));

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels.length ? labels : ['T4/2026', 'T5/2026', 'T6/2026', 'T7/2026', 'T8/2026', 'T9/2026'],
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: dataValues.length ? dataValues : [12000000, 18500000, 24000000, 31000000, 29000000, 45000000],
                    borderColor: '#0d47a1',
                    backgroundColor: 'rgba(13, 71, 161, 0.08)',
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#00b4d8',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            callback: function(val) {
                                return (val / 1000000).toLocaleString() + ' Tr';
                            }
                        }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    </script>
}
