@{
    ViewBag.Title = "404 - Không tìm thấy trang";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[70vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl w-full text-center">

        <!-- Error Illustration / Icon -->
        <div class="relative inline-flex items-center justify-center mb-8">
            <div class="w-32 h-32 rounded-full bg-blue-50 border-4 border-blue-100 flex items-center justify-center shadow-inner">
                <span class="material-symbols-outlined text-6xl text-[#0d47a1]">travel_explore</span>
            </div>
            <div class="absolute -top-1 -right-1 w-10 h-10 rounded-full bg-cyan-500 text-white flex items-center justify-center shadow-lg text-sm font-bold ring-4 ring-white">
                ?
            </div>
        </div>

        <!-- Error Code Tag -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100/80 text-[#0d47a1] mb-4 tracking-wide uppercase">
            <span class="w-2 h-2 rounded-full bg-[#0d47a1] animate-pulse"></span>
            Mã lỗi: 404 Not Found
        </div>

        <!-- Headline -->
        <h1 class="font-headline font-extrabold text-3xl sm:text-4xl text-slate-900 tracking-tight mb-4">
            Không tìm thấy trang yêu cầu
        </h1>

        <!-- Description -->
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-8 max-w-lg mx-auto">
            Trang hoặc đường dẫn bạn đang tìm kiếm có thể đã bị di chuyển, đổi tên hoặc tạm thời không khả dụng trong hệ thống <strong class="text-slate-800">TheChillShop</strong>.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
            <a href="@Url.Action("Index", "Home")" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-[#0d47a1] to-[#00b4d8] text-white font-semibold text-sm shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-lg">home</span>
                Quay lại Trang chủ
            </a>
            <button onclick="window.history.back()" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-white border border-slate-300 text-slate-700 font-semibold text-sm shadow-sm hover:bg-slate-50 transition-all duration-200 flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                Trở về trang trước
            </button>
        </div>

    </div>
</div>
