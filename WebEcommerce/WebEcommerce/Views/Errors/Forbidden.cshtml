@{
    ViewBag.Title = "403 - Truy cập bị từ chối";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[70vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl w-full text-center">

        <!-- Error Illustration / Icon -->
        <div class="relative inline-flex items-center justify-center mb-8">
            <div class="w-32 h-32 rounded-full bg-red-50 border-4 border-red-100 flex items-center justify-center shadow-inner">
                <span class="material-symbols-outlined text-6xl text-red-500">lock</span>
            </div>
            <div class="absolute -top-1 -right-1 w-10 h-10 rounded-full bg-amber-500 text-white flex items-center justify-center shadow-lg text-sm font-bold ring-4 ring-white">
                !
            </div>
        </div>

        <!-- Error Code Tag -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-100/80 text-red-700 mb-4 tracking-wide uppercase">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            Mã lỗi: 403 Forbidden
        </div>

        <!-- Headline -->
        <h1 class="font-headline font-extrabold text-3xl sm:text-4xl text-slate-900 tracking-tight mb-4">
            Truy cập bị từ chối
        </h1>

        <!-- Description -->
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-8 max-w-lg mx-auto">
            Tài khoản của bạn hiện không có quyền truy cập vào phân hệ này. Khu vực này chỉ dành riêng cho tài khoản có vai trò <strong class="text-slate-800">Quản trị viên (Administrator)</strong> hoặc <strong class="text-slate-800">Quản lý cửa hàng (StoreManager)</strong>.
        </p>

        <!-- Current User Status Info -->
        @if (Request.IsAuthenticated)
        {
            <div class="bg-white border border-slate-200 rounded-xl p-4 mb-8 text-left text-sm shadow-sm flex items-center justify-between gap-4">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 rounded-full bg-[#0d47a1]/10 text-[#0d47a1] flex items-center justify-center font-bold flex-shrink-0">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <div class="truncate">
                        <p class="font-semibold text-slate-800 truncate">@User.Identity.Name</p>
                        <p class="text-xs text-slate-500">Đã đăng nhập vai trò Khách hàng (Customer)</p>
                    </div>
                </div>
                <a href="@Url.Action("Profile", "Manage")" class="text-xs font-semibold text-[#0d47a1] hover:underline whitespace-nowrap">
                    Xem hồ sơ &rarr;
                </a>
            </div>
        }

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
            <a href="@Url.Action("Index", "Home")" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-[#0d47a1] to-[#00b4d8] text-white font-semibold text-sm shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-lg">home</span>
                Quay lại Trang chủ
            </a>

            @if (Request.IsAuthenticated)
            {
                using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm403", @class = "w-full sm:w-auto inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-white border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50 hover:border-slate-400 transition-all duration-200 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-lg">switch_account</span>
                        Đổi tài khoản khác
                    </button>
                }
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-white border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50 hover:border-slate-400 transition-all duration-200 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-lg">login</span>
                    Đăng nhập tài khoản Admin
                </a>
            }
        </div>

        <!-- Help Info -->
        <div class="pt-6 border-t border-slate-200 text-xs text-slate-500">
            Cần cấp quyền quản trị? Vui lòng liên hệ <span class="font-medium text-slate-700">admin@thechillshop.vn</span> hoặc Hotline <span class="font-medium text-slate-700">1900 6868</span>.
        </div>

    </div>
</div>
