@model IEnumerable<WebEcommerce.Models.Product>

@{
    ViewBag.Title = "Sản phẩm yêu thích";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Page Header -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-red-50 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">favorite</span>
                </div>
                <h1 class="font-headline font-extrabold text-2xl sm:text-3xl text-[#1a1a2e]">
                    Sản phẩm yêu thích
                </h1>
            </div>
            <p class="text-sm text-slate-500">
                Những sản phẩm bạn đã lưu để xem lại hoặc mua sau.
            </p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold self-start sm:self-auto">
                <span class="material-symbols-outlined text-base text-primary">favorite</span>
                <span><strong class="text-slate-900" id="wishlistCount">@Model.Count()</strong> sản phẩm</span>
            </div>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl border border-red-200 bg-red-50 text-red-700 text-sm font-semibold flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">error</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="bg-white border-2 border-slate-200/80 rounded-3xl p-10 sm:p-14 text-center shadow-sm max-w-2xl mx-auto">
            <div class="w-24 h-24 mx-auto mb-6 rounded-2xl bg-red-50/70 border border-red-100 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-5xl">heart_broken</span>
            </div>
            <h2 class="font-headline font-extrabold text-2xl text-slate-900 mb-2">
                Bạn chưa lưu sản phẩm nào
            </h2>
            <p class="text-sm text-slate-500 mb-8">
                Bấm biểu tượng trái tim trên sản phẩm để lưu vào đây.
            </p>
            <a href="@Url.Action("Index", "Shop")" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-white font-bold text-sm hover:bg-brand-red-vibrant transition-colors">
                <span class="material-symbols-outlined text-lg">storefront</span>
                Khám phá sản phẩm
            </a>
        </div>
    }
    else
    {
        <div id="wishlistGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            @foreach (var p in Model)
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    }
</div>
