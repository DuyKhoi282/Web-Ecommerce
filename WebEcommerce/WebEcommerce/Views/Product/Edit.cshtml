@model WebEcommerce.Models.ProductFormViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isEdit = Model.ProductID > 0;
    ViewBag.Title = isEdit ? "Chỉnh sửa Sản phẩm" : "Thêm Sản phẩm mới";
}

<div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="flex items-center gap-3 mb-6">
        <a href="@Url.Action("Index", "Product")" class="p-2 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
            <span class="material-symbols-outlined text-slate-600">arrow_back</span>
        </a>
        <div>
            <h1 class="text-2xl font-headline font-extrabold text-slate-900">@ViewBag.Title</h1>
            <p class="text-sm text-slate-500 mt-0.5">@(isEdit ? "Cập nhật thông tin sản phẩm" : "Điền thông tin để tạo sản phẩm mới")</p>
        </div>
    </div>

    <!-- Form -->
    <div class="admin-card rounded-2xl p-6">
        @using (Html.BeginForm(isEdit ? "Edit" : "Create", "Product", FormMethod.Post, new { @class = "space-y-5", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ProductID)

            @Html.ValidationSummary(true, "", new { @class = "bg-red-50 text-red-600 text-sm p-4 rounded-xl border border-red-200 mb-4" })

            <!-- Tên sản phẩm -->
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1.5">Tên sản phẩm <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Name, new { @class = "w-full px-4 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary focus:bg-white outline-none transition-all", placeholder = "VD: iPhone 15 Pro Max..." })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-red-500 text-xs mt-1" })
            </div>

            <!-- Mô tả -->
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1.5">Mô tả sản phẩm</label>
                @Html.TextAreaFor(m => m.Description, new { @class = "w-full px-4 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary focus:bg-white outline-none transition-all", rows = "4", placeholder = "Mô tả chi tiết sản phẩm..." })
            </div>

            <!-- Danh mục -->
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1.5">Danh mục <span class="text-red-500">*</span></label>
                @Html.DropDownListFor(m => m.CategoryID, Model.CategoryList, new { @class = "w-full px-4 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary outline-none transition-all" })
                @Html.ValidationMessageFor(m => m.CategoryID, "", new { @class = "text-red-500 text-xs mt-1" })
            </div>

            <!-- Giá cả -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1.5">Giá gốc (₫) <span class="text-red-500">*</span></label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "w-full px-4 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary focus:bg-white outline-none transition-all", type = "number", min = "0", step = "1000" })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1.5">Giá khuyến mãi (₫)</label>
                    @Html.TextBoxFor(m => m.DiscountPrice, new { @class = "w-full px-4 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary focus:bg-white outline-none transition-all", type = "number", min = "0", step = "1000", placeholder = "Để trống nếu không KM" })
                    @Html.ValidationMessageFor(m => m.DiscountPrice, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1.5">Số lượng tồn kho <span class="text-red-500">*</span></label>
                    @Html.TextBoxFor(m => m.StockQuantity, new { @class = "w-full px-4 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary focus:bg-white outline-none transition-all", type = "number", min = "0" })
                    @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>
            </div>

            <!-- Trạng thái -->
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1.5">Trạng thái <span class="text-red-500">*</span></label>
                @Html.DropDownListFor(m => m.Status, new List<SelectListItem>
                {
                    new SelectListItem { Value = "1", Text = "Còn hàng" },
                    new SelectListItem { Value = "2", Text = "Hết hàng" },
                    new SelectListItem { Value = "3", Text = "Ngừng bán" }
                }, new { @class = "w-full px-4 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary outline-none transition-all" })
            </div>

            <!-- Upload hình ảnh -->
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1.5">Tải lên hình ảnh sản phẩm</label>
                <div class="border-2 border-dashed border-slate-300 rounded-xl p-6 text-center hover:border-chill-primary transition-colors bg-slate-50">
                    <input type="file" name="UploadImages" multiple accept=".jpg,.jpeg,.png,.gif,.webp"
                           class="w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-chill-primary file:text-white hover:file:bg-chill-primaryDark" id="imageUpload" />
                    <p class="text-xs text-slate-400 mt-2">Chấp nhận: JPG, PNG, GIF, WebP • Tối đa 5MB/ảnh • Có thể chọn nhiều ảnh</p>
                </div>
                <!-- Preview ảnh mới -->
                <div id="imagePreview" class="grid grid-cols-4 sm:grid-cols-6 gap-3 mt-3"></div>
            </div>

            <!-- Ảnh hiện tại (khi chỉnh sửa) -->
            @if (isEdit && Model.ExistingImages.Any())
            {
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1.5">Ảnh hiện tại (chọn ảnh đại diện IsMain)</label>
                    <div class="grid grid-cols-4 sm:grid-cols-6 gap-3">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="relative group">
                                <img src="@img.ImageURL" alt="Ảnh" class="w-full aspect-square object-cover rounded-xl border-2 @(img.IsMain ? "border-chill-primary ring-2 ring-chill-accent" : "border-slate-200")" />
                                <div class="absolute top-1 right-1 flex gap-1">
                                    <!-- Radio chọn ảnh đại diện -->
                                    <label class="cursor-pointer p-1 bg-white/90 rounded-lg shadow-sm hover:bg-blue-100" title="Đặt làm ảnh đại diện">
                                        <input type="radio" name="MainImageID" value="@img.ImageID" @(img.IsMain ? "checked" : "") class="sr-only peer" />
                                        <span class="material-symbols-outlined text-sm peer-checked:text-chill-primary text-slate-400">star</span>
                                    </label>
                                    <!-- Checkbox xóa -->
                                    <label class="cursor-pointer p-1 bg-white/90 rounded-lg shadow-sm hover:bg-red-100" title="Đánh dấu xóa">
                                        <input type="checkbox" name="DeleteImageIDs" value="@img.ImageID" class="sr-only peer" />
                                        <span class="material-symbols-outlined text-sm text-slate-400 peer-checked:text-red-500">delete</span>
                                    </label>
                                </div>
                                @if (img.IsMain)
                                {
                                    <span class="absolute bottom-1 left-1 bg-chill-primary text-white text-[10px] px-2 py-0.5 rounded-md font-bold">Đại diện</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Buttons -->
            <div class="flex items-center gap-3 pt-4 border-t border-slate-200">
                <button type="submit" class="bg-chill-primary hover:bg-chill-primaryDark text-white px-6 py-2.5 rounded-xl font-semibold text-sm flex items-center gap-2 transition-all shadow-lg">
                    <span class="material-symbols-outlined text-lg">save</span>
                    @(isEdit ? "Cập nhật" : "Tạo sản phẩm")
                </button>
                <a href="@Url.Action("Index", "Product")" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold text-sm transition-all">Hủy</a>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        // Preview ảnh trước khi upload
        document.getElementById('imageUpload').addEventListener('change', function(e) {
            var preview = document.getElementById('imagePreview');
            preview.innerHTML = '';
            var files = e.target.files;
            for (var i = 0; i < files.length; i++) {
                var reader = new FileReader();
                reader.onload = function(ev) {
                    var div = document.createElement('div');
                    div.className = 'relative';
                    var img = document.createElement('img');
                    img.src = ev.target.result;
                    img.className = 'w-full aspect-square object-cover rounded-xl border-2 border-slate-200';
                    div.appendChild(img);
                    preview.appendChild(div);
                };
                reader.readAsDataURL(files[i]);
            }
        });
    </script>
}
