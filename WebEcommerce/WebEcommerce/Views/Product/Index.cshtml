@model WebEcommerce.Models.ProductListViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Toast -->
@if (TempData["SuccessMessage"] != null)
{
    <div id="toast-success" class="fixed top-6 right-6 z-50 bg-emerald-600 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3 animate-slide-in">
        <span class="material-symbols-outlined">check_circle</span>
        <span class="font-semibold text-sm">@TempData["SuccessMessage"]</span>
        <button onclick="this.parentElement.remove()" class="ml-2 hover:text-emerald-200"><span class="material-symbols-outlined text-lg">close</span></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div id="toast-error" class="fixed top-6 right-6 z-50 bg-red-600 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3 animate-slide-in">
        <span class="material-symbols-outlined">error</span>
        <span class="font-semibold text-sm">@TempData["ErrorMessage"]</span>
        <button onclick="this.parentElement.remove()" class="ml-2 hover:text-red-200"><span class="material-symbols-outlined text-lg">close</span></button>
    </div>
}

<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-headline font-extrabold text-slate-900">Quản lý Sản phẩm</h1>
        <p class="text-sm text-slate-500 mt-1">Tổng cộng <span class="font-bold text-chill-primary">@Model.TotalCount</span> sản phẩm</p>
    </div>
    <a href="@Url.Action("Create", "Product")" class="bg-chill-primary hover:bg-chill-primaryDark text-white px-5 py-2.5 rounded-xl font-semibold text-sm flex items-center gap-2 transition-all shadow-lg hover:shadow-xl">
        <span class="material-symbols-outlined text-lg">add_circle</span>
        Thêm sản phẩm
    </a>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
    <div class="admin-card rounded-2xl p-4 text-center">
        <span class="material-symbols-outlined text-3xl text-blue-500 mb-1 block">inventory_2</span>
        <p class="text-2xl font-extrabold text-slate-900">@Model.TotalProducts</p>
        <p class="text-xs text-slate-500 font-medium">Tổng SP</p>
    </div>
    <div class="admin-card rounded-2xl p-4 text-center">
        <span class="material-symbols-outlined text-3xl text-emerald-500 mb-1 block">check_circle</span>
        <p class="text-2xl font-extrabold text-emerald-600">@Model.InStockCount</p>
        <p class="text-xs text-slate-500 font-medium">Còn hàng</p>
    </div>
    <div class="admin-card rounded-2xl p-4 text-center">
        <span class="material-symbols-outlined text-3xl text-red-500 mb-1 block">remove_shopping_cart</span>
        <p class="text-2xl font-extrabold text-red-600">@Model.OutOfStockCount</p>
        <p class="text-xs text-slate-500 font-medium">Hết hàng</p>
    </div>
    <div class="admin-card rounded-2xl p-4 text-center">
        <span class="material-symbols-outlined text-3xl text-slate-400 mb-1 block">block</span>
        <p class="text-2xl font-extrabold text-slate-500">@Model.DiscontinuedCount</p>
        <p class="text-xs text-slate-500 font-medium">Ngừng bán</p>
    </div>
    <div class="admin-card rounded-2xl p-4 text-center">
        <span class="material-symbols-outlined text-3xl text-amber-500 mb-1 block">warning</span>
        <p class="text-2xl font-extrabold text-amber-600">@Model.LowStockCount</p>
        <p class="text-xs text-slate-500 font-medium">Sắp hết (&lt;5)</p>
    </div>
</div>

<!-- Bộ lọc -->
<div class="admin-card rounded-2xl p-4 mb-6">
    @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { @class = "flex flex-wrap items-end gap-3" }))
    {
        <div class="flex-1 min-w-[200px]">
            <label class="text-xs font-bold text-slate-600 mb-1 block">Tìm kiếm</label>
            <input type="text" name="search" value="@Model.SearchTerm" placeholder="Tên sản phẩm..."
                   class="w-full px-4 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary focus:bg-white outline-none transition-all" />
        </div>
        <div class="w-48">
            <label class="text-xs font-bold text-slate-600 mb-1 block">Danh mục</label>
            @Html.DropDownList("categoryId", Model.CategoryList, new { @class = "w-full px-3 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary outline-none transition-all" })
        </div>
        <div class="w-40">
            <label class="text-xs font-bold text-slate-600 mb-1 block">Trạng thái</label>
            @Html.DropDownList("status", Model.StatusList, new { @class = "w-full px-3 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary outline-none transition-all" })
        </div>
        <div class="w-40">
            <label class="text-xs font-bold text-slate-600 mb-1 block">Sắp xếp</label>
            <select name="sortBy" class="w-full px-3 py-2.5 text-sm bg-slate-50 border-2 border-slate-200 rounded-xl focus:border-chill-primary outline-none transition-all">
                <option value="">Mới nhất</option>
                <option value="name_asc" @(Model.SortBy == "name_asc" ? "selected" : "")>Tên A-Z</option>
                <option value="name_desc" @(Model.SortBy == "name_desc" ? "selected" : "")>Tên Z-A</option>
                <option value="price_asc" @(Model.SortBy == "price_asc" ? "selected" : "")>Giá tăng</option>
                <option value="price_desc" @(Model.SortBy == "price_desc" ? "selected" : "")>Giá giảm</option>
                <option value="stock_asc" @(Model.SortBy == "stock_asc" ? "selected" : "")>Tồn kho tăng</option>
            </select>
        </div>
        <button type="submit" class="bg-chill-primary hover:bg-chill-primaryDark text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition-all">Lọc</button>
    }
</div>

<!-- Bảng sản phẩm -->
<div class="admin-card rounded-2xl overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-slate-50 border-b-2 border-slate-200">
                <th class="text-left px-5 py-3.5 font-bold text-slate-700">Sản phẩm</th>
                <th class="text-left px-5 py-3.5 font-bold text-slate-700">Danh mục</th>
                <th class="text-right px-5 py-3.5 font-bold text-slate-700">Giá gốc</th>
                <th class="text-right px-5 py-3.5 font-bold text-slate-700">Giá KM</th>
                <th class="text-center px-5 py-3.5 font-bold text-slate-700">Tồn kho</th>
                <th class="text-center px-5 py-3.5 font-bold text-slate-700">Trạng thái</th>
                <th class="text-center px-5 py-3.5 font-bold text-slate-700">Đánh giá</th>
                <th class="text-center px-5 py-3.5 font-bold text-slate-700">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Products.Any())
            {
                foreach (var p in Model.Products)
                {
                    <tr class="border-b border-slate-100 hover:bg-blue-50/50 transition-colors">
                        <td class="px-5 py-3">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(p.MainImageUrl))
                                {
                                    <img src="@p.MainImageUrl" alt="@p.Name" class="w-12 h-12 rounded-xl object-cover border border-slate-200 shadow-sm" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center">
                                        <span class="material-symbols-outlined text-slate-400">image</span>
                                    </div>
                                }
                                <div>
                                    <a href="@Url.Action("Details", "Product", new { id = p.ProductID })" class="font-semibold text-slate-800 hover:text-chill-primary transition-colors">@p.Name</a>
                                    <p class="text-xs text-slate-400 mt-0.5">@p.ImageCount ảnh • @p.ViewCount lượt xem</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-5 py-3 text-slate-600">@p.CategoryName</td>
                        <td class="px-5 py-3 text-right font-bold text-slate-800">@p.Price.ToString("N0")₫</td>
                        <td class="px-5 py-3 text-right">
                            @if (p.DiscountPrice.HasValue)
                            {
                                <span class="font-bold text-red-600">@p.DiscountPrice.Value.ToString("N0")₫</span>
                            }
                            else
                            {
                                <span class="text-slate-400">—</span>
                            }
                        </td>
                        <td class="px-5 py-3 text-center">
                            @{
                                var stockClass = p.StockQuantity == 0 ? "bg-red-100 text-red-700" : (p.StockQuantity < 5 ? "bg-amber-100 text-amber-700" : "bg-emerald-100 text-emerald-700");
                            }
                            <span class="@stockClass px-3 py-1 rounded-lg text-xs font-bold">@p.StockQuantity</span>
                        </td>
                        <td class="px-5 py-3 text-center">
                            @{
                                var statusClass = p.Status == 1 ? "bg-emerald-100 text-emerald-700" : (p.Status == 2 ? "bg-red-100 text-red-600" : "bg-slate-200 text-slate-600");
                            }
                            <span class="@statusClass px-3 py-1 rounded-full text-xs font-bold">@p.StatusText</span>
                        </td>
                        <td class="px-5 py-3 text-center">
                            @if (p.ReviewCount > 0)
                            {
                                <div class="flex items-center justify-center gap-1">
                                    <span class="material-symbols-outlined text-amber-400 text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                                    <span class="text-xs font-bold text-slate-700">@p.AverageRating.ToString("F1")</span>
                                    <span class="text-xs text-slate-400">(@p.ReviewCount)</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">—</span>
                            }
                        </td>
                        <td class="px-5 py-3 text-center">
                            <div class="flex items-center justify-center gap-1">
                                <a href="@Url.Action("Details", "Product", new { id = p.ProductID })" class="p-1.5 text-slate-500 hover:bg-slate-100 rounded-lg transition-colors" title="Chi tiết">
                                    <span class="material-symbols-outlined text-lg">visibility</span>
                                </a>
                                <a href="@Url.Action("Edit", "Product", new { id = p.ProductID })" class="p-1.5 text-blue-600 hover:bg-blue-100 rounded-lg transition-colors" title="Sửa">
                                    <span class="material-symbols-outlined text-lg">edit</span>
                                </a>
                                <button onclick="openDeleteModal(@p.ProductID, '@p.Name.Replace("'", "\\'")')" class="p-1.5 text-red-500 hover:bg-red-100 rounded-lg transition-colors" title="Xóa">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-12 text-slate-400">
                        <span class="material-symbols-outlined text-5xl mb-2 block">inventory_2</span>
                        <span class="text-base font-medium">Chưa có sản phẩm nào</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang -->
@if (Model.TotalPages > 1)
{
    <div class="flex justify-center items-center gap-2 mt-6">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            var activeClass = i == Model.CurrentPage ? "bg-chill-primary text-white shadow-lg" : "bg-white text-slate-700 border-2 border-slate-200 hover:bg-slate-50";
            <a href="@Url.Action("Index", "Product", new { search = Model.SearchTerm, categoryId = Model.SelectedCategoryID, status = Model.SelectedStatus, sortBy = Model.SortBy, page = i })"
               class="@activeClass w-9 h-9 rounded-lg flex items-center justify-center text-sm font-bold transition-all">@i</a>
        }
    </div>
}

<!-- Modal xóa -->
<div id="deleteModal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md mx-4">
        <div class="text-center mb-4">
            <span class="material-symbols-outlined text-5xl text-red-500 mb-2 block">warning</span>
            <h3 class="text-lg font-bold text-slate-900">Xác nhận xóa sản phẩm</h3>
            <p id="deleteMessage" class="text-sm text-slate-500 mt-2"></p>
        </div>
        <div class="flex gap-3 justify-center">
            <button onclick="closeDeleteModal()" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold text-sm transition-all">Hủy</button>
            <button id="confirmDeleteBtn" class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-xl font-semibold text-sm transition-all">Xóa</button>
        </div>
    </div>
</div>

<style>
    @@keyframes slideIn { from { transform: translateX(100px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    .animate-slide-in { animation: slideIn 0.3s ease-out; }
</style>

@section scripts {
    <script>
        setTimeout(function () {
            var t = document.getElementById('toast-success'); if (t) t.remove();
            var e = document.getElementById('toast-error'); if (e) e.remove();
        }, 5000);

        var deleteId = 0;
        var antiForgeryToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

        function openDeleteModal(id, name) {
            deleteId = id;
            document.getElementById('deleteMessage').textContent = 'Bạn có chắc chắn muốn xóa sản phẩm "' + name + '"?';
            document.getElementById('deleteModal').classList.remove('hidden');
        }
        function closeDeleteModal() { document.getElementById('deleteModal').classList.add('hidden'); }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            fetch('@Url.Action("Delete", "Product")/' + deleteId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(antiForgeryToken)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                closeDeleteModal();
                if (data.success) { location.reload(); } else { alert(data.message); }
            })
            .catch(function () { alert('Có lỗi xảy ra.'); closeDeleteModal(); });
        });
    </script>
}
