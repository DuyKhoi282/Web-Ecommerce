@model WebEcommerce.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Đổi mật khẩu & Bảo mật";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = User.Identity.Name ?? "Khách hàng";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
        <a href="@Url.Action("Index", "Home")" class="hover:text-[#0d47a1] transition-colors">Trang chủ</a>
        <span>/</span>
        <a href="@Url.Action("Profile", "Manage")" class="hover:text-[#0d47a1] transition-colors">Tài khoản</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Đổi mật khẩu</span>
    </nav>

    <!-- Success & Error Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded-2xl bg-emerald-50 text-emerald-800 border border-emerald-200 p-4 text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
                <span class="font-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-800">
                <span class="material-symbols-outlined text-base">close</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 rounded-2xl bg-red-50 text-red-800 border border-red-200 p-4 text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-red-600 text-xl shrink-0">error</span>
                <span class="font-medium">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800">
                <span class="material-symbols-outlined text-base">close</span>
            </button>
        </div>
    }

    <!-- 2-Column Main Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- ============================================== -->
        <!-- LEFT COLUMN: Account Sidebar (4 cols on lg)     -->
        <!-- ============================================== -->
        <aside class="lg:col-span-4 space-y-6">

            <!-- Profile Summary Card -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm text-center">
                <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-[#0d47a1] to-[#00b4d8] text-white flex items-center justify-center font-bold text-2xl shadow-md mx-auto mb-3">
                    @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
                </div>
                <h2 class="font-headline font-bold text-base text-slate-900 leading-tight">@userName</h2>
                <p class="text-xs text-slate-500 mt-1">Đổi mật khẩu định kỳ giúp bảo vệ tài khoản</p>
            </div>

            <!-- Account Navigation Links -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-3 shadow-sm">
                <nav class="space-y-1">
                    <a href="@Url.Action("Profile", "Manage")" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-[#0d47a1] transition-colors">
                        <span class="material-symbols-outlined text-lg text-slate-400">person</span>
                        <span>Thông tin tài khoản</span>
                    </a>
                    <a href="@Url.Action("ChangePassword", "Manage")" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold bg-[#0d47a1] text-white shadow-sm">
                        <span class="material-symbols-outlined text-lg">lock_reset</span>
                        <span>Đổi mật khẩu & Bảo mật</span>
                    </a>
                    <a href="#" class="flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-[#0d47a1] transition-colors">
                        <span class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-lg text-slate-400">receipt_long</span>
                            <span>Đơn hàng của tôi</span>
                        </span>
                        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">0</span>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- ============================================== -->
        <!-- RIGHT COLUMN: Change Password Form (8 cols)    -->
        <!-- ============================================== -->
        <main class="lg:col-span-8 space-y-6">

            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
                <!-- Section Title -->
                <div class="border-b border-slate-100 pb-5 mb-6">
                    <h1 class="font-headline font-bold text-2xl text-slate-900 tracking-tight">Đổi mật khẩu</h1>
                    <p class="text-slate-500 text-sm mt-1">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu của bạn cho bất kỳ ai.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-5 rounded-xl bg-red-50 text-red-800 border border-red-200 p-4 text-xs sm:text-sm">
                        @Html.ValidationSummary(false, "", new { @class = "space-y-1 list-disc list-inside font-medium" })
                    </div>
                }

                @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { @class = "space-y-5 max-w-lg" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- Old Password -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="OldPassword">
                            Mật khẩu hiện tại
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <span class="material-symbols-outlined text-lg">lock</span>
                            </div>
                            @Html.PasswordFor(m => m.OldPassword, new {
                                @class = "block w-full pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                                placeholder = "Nhập mật khẩu hiện tại",
                                autocomplete = "current-password",
                                required = "required"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-red-600 text-xs mt-1 block" })
                    </div>

                    <!-- New Password -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="NewPassword">
                            Mật khẩu mới (tối thiểu 6 ký tự)
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <span class="material-symbols-outlined text-lg">key</span>
                            </div>
                            @Html.PasswordFor(m => m.NewPassword, new {
                                @class = "block w-full pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                                placeholder = "Tối thiểu 6 ký tự",
                                autocomplete = "new-password",
                                required = "required"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-red-600 text-xs mt-1 block" })
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="ConfirmPassword">
                            Xác nhận mật khẩu mới
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <span class="material-symbols-outlined text-lg">lock_reset</span>
                            </div>
                            @Html.PasswordFor(m => m.ConfirmPassword, new {
                                @class = "block w-full pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                                placeholder = "Nhập lại mật khẩu mới",
                                autocomplete = "new-password",
                                required = "required"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-red-600 text-xs mt-1 block" })
                    </div>

                    <!-- Password Tips Card -->
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-slate-600 space-y-1.5">
                        <div class="font-semibold text-slate-800 flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-sm text-[#00b4d8]">info</span>
                            <span>Mật khẩu an toàn nên:</span>
                        </div>
                        <ul class="list-disc list-inside space-y-1 text-slate-500 pl-1">
                            <li>Có độ dài ít nhất 6 ký tự</li>
                            <li>Bao gồm chữ hoa, chữ thường và chữ số</li>
                            <li>Không trùng với mật khẩu cũ hoặc thông tin cá nhân</li>
                        </ul>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
                        <button type="submit" class="px-6 py-2.5 text-xs font-semibold text-white bg-[#0d47a1] hover:bg-[#0a3880] rounded-xl shadow-sm hover:shadow transition-all flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-base">check_circle</span>
                            <span>Cập nhật mật khẩu</span>
                        </button>
                        <a href="@Url.Action("Profile", "Manage")" class="px-5 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl border border-slate-300 transition-colors">
                            Hủy bỏ
                        </a>
                    </div>
                }
            </div>
        </main>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}