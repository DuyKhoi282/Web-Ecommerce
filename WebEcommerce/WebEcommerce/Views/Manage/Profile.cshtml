@model WebEcommerce.Models.ProfileViewModel
@{
    ViewBag.Title = "Thông tin cá nhân & Tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var avatarSrc = string.IsNullOrEmpty(Model.Avatar)
        ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.FullName ?? "User") + "&background=d70018&color=fff&size=128"
        : Url.Content(Model.Avatar);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
        <a href="@Url.Action("Index", "Home")" class="hover:text-[#0d47a1] transition-colors">Trang chủ</a>
        <span>/</span>
        <a href="@Url.Action("Profile", "Manage")" class="hover:text-[#0d47a1] transition-colors">Tài khoản</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Thông tin cá nhân</span>
    </nav>

    <!-- Success & Error Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded-2xl bg-emerald-50 text-emerald-800 border border-emerald-200 p-4 text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
                <span class="font-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-800">
                <span class="material-symbols-outlined text-base">close</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 rounded-2xl bg-red-50 text-red-800 border border-red-200 p-4 text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-red-600 text-xl shrink-0">error</span>
                <span class="font-medium">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800">
                <span class="material-symbols-outlined text-base">close</span>
            </button>
        </div>
    }

    <!-- 2-Column Main Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- ============================================== -->
        <!-- LEFT COLUMN: Account Sidebar (4 cols on lg)     -->
        <!-- ============================================== -->
        <aside class="lg:col-span-4 space-y-4">
            @Html.Partial("_AccountSidebar", new ViewDataDictionary { { "AccountActive", "profile" }, { "AccountAvatar", avatarSrc } })
        </aside>

        <!-- ============================================== -->
        <!-- RIGHT COLUMN: Profile Edit Form (8 cols on lg) -->
        <!-- ============================================== -->
        <main class="lg:col-span-8 space-y-6">

            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
                <!-- Section Title -->
                <div class="border-b border-slate-100 pb-5 mb-6">
                    <h1 class="font-headline font-bold text-2xl text-slate-900 tracking-tight">Hồ sơ cá nhân</h1>
                    <p class="text-slate-500 text-sm mt-1">Quản lý và cập nhật thông tin cá nhân của bạn để nhận dịch vụ tốt nhất.</p>
                </div>

                @using (Html.BeginForm("Profile", "Manage", FormMethod.Post, new { enctype = "multipart/form-data", @class = "space-y-6" }))
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="rounded-xl bg-red-50 text-red-800 border border-red-200 p-4 text-xs sm:text-sm">
                            @Html.ValidationSummary(false, "", new { @class = "space-y-1 list-disc list-inside font-medium" })
                        </div>
                    }

                    <!-- Avatar Uploader Bar -->
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 flex flex-col sm:flex-row items-center gap-4">
                        <img id="avatar-preview-main" 
                             src="@avatarSrc" 
                             alt="Avatar" 
                             class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-sm shrink-0" />
                        
                        <div class="flex-1 text-center sm:text-left">
                            <span class="block text-sm font-semibold text-slate-800">Ảnh đại diện</span>
                            <span class="block text-xs text-slate-500 mt-0.5">Định dạng hỗ trợ: JPG, PNG, GIF. Kích thước tối đa: 2MB.</span>
                        </div>

                        <div>
                            <label for="AvatarFile" class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-xl border border-slate-300 shadow-sm cursor-pointer transition-all inline-flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-base">upload</span>
                                <span>Tải ảnh mới</span>
                            </label>
                            @Html.TextBoxFor(m => m.AvatarFile, new {
                                type = "file",
                                id = "AvatarFile",
                                accept = "image/*",
                                @class = "hidden",
                                onchange = "previewAvatar(this)"
                            })
                        </div>
                    </div>
                    @Html.ValidationMessageFor(m => m.AvatarFile, "", new { @class = "text-red-600 text-xs block" })

                    <!-- Grid Form Fields -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        
                        <!-- FullName -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="FullName">
                                Họ và tên
                            </label>
                            @Html.TextBoxFor(m => m.FullName, new {
                                @class = "block w-full px-4 py-2.5 text-sm text-slate-900 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                                placeholder = "Nguyễn Văn A"
                            })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-red-600 text-xs mt-1 block" })
                        </div>

                        <!-- Readonly Email with Lock icon -->
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider">
                                    Địa chỉ Email
                                </label>
                                <span class="text-[11px] text-slate-400 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs">lock</span> Cố định
                                </span>
                            </div>
                            <input type="email" value="@Model.Email" readonly 
                                   class="block w-full px-4 py-2.5 text-sm text-slate-500 bg-slate-100 rounded-xl border border-slate-200 cursor-not-allowed outline-none select-none" />
                            <span class="text-[11px] text-slate-400 mt-1 block">Email dùng để xác thực và nhận thông báo đơn hàng.</span>
                        </div>

                        <!-- Phone Number -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="PhoneNumber">
                                Số điện thoại
                            </label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new {
                                @class = "block w-full px-4 py-2.5 text-sm text-slate-900 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                                placeholder = "0912 345 678",
                                type = "tel"
                            })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-red-600 text-xs mt-1 block" })
                        </div>

                        <!-- Empty space or placeholder for future date/gender -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                                Trạng thái tài khoản
                            </label>
                            <div class="px-4 py-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center gap-2">
                                <span class="material-symbols-outlined text-base text-emerald-600">check_circle</span>
                                <span>Đang hoạt động bình thường</span>
                            </div>
                        </div>

                        <!-- Address (full width) -->
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="Address">
                                Địa chỉ giao hàng mặc định
                            </label>
                            @Html.TextAreaFor(m => m.Address, 3, 0, new {
                                @class = "block w-full px-4 py-2.5 text-sm text-slate-900 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                                placeholder = "Số nhà, tên đường, Phường/Xã, Quận/Huyện, Tỉnh/Thành phố..."
                            })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-red-600 text-xs mt-1 block" })
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                        <a href="@Url.Action("ChangePassword", "Manage")" class="px-5 py-2.5 text-xs font-semibold text-[#0d47a1] hover:bg-blue-50 rounded-xl border border-[#0d47a1] transition-colors">
                            Đổi mật khẩu
                        </a>
                        <button type="submit" class="px-6 py-2.5 text-xs font-semibold text-white bg-[#0d47a1] hover:bg-[#0a3880] rounded-xl shadow-sm hover:shadow transition-all flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-base">save</span>
                            <span>Lưu thay đổi</span>
                        </button>
                    </div>
                }
            </div>

            <!-- Quick Security Card Banner -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm flex items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#0d47a1] flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-2xl">shield_lock</span>
                    </div>
                    <div>
                        <h3 class="font-headline font-bold text-base text-slate-900">Bảo mật tài khoản</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Thay đổi mật khẩu định kỳ giúp bảo vệ tài khoản và đơn hàng của bạn tốt hơn.</p>
                    </div>
                </div>
                <a href="@Url.Action("ChangePassword", "Manage")" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors shrink-0">
                    Cập nhật mật khẩu
                </a>
            </div>

        </main>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function previewAvatar(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var mainImg = document.getElementById('avatar-preview-main');
                    var sidebarImg = document.getElementById('avatar-preview-sidebar');
                    if (mainImg) mainImg.src = e.target.result;
                    if (sidebarImg) sidebarImg.src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
