@model List<WebEcommerce.Models.Order>
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentStatus = ViewBag.CurrentStatus as string ?? "";
}

<div class="p-6 lg:p-8">
    <div class="mb-8">
        <h1 class="font-headline font-extrabold text-2xl text-slate-900">Quản lý đơn hàng</h1>
        <p class="text-sm text-slate-500 mt-1">Xem và cập nhật trạng thái tất cả đơn hàng.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl border border-green-200 bg-green-50 text-green-700 text-sm font-semibold">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl border border-red-200 bg-red-50 text-red-700 text-sm font-semibold">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Status Filter -->
    <div class="flex flex-wrap gap-2 mb-6">
        @{
            var statuses = new[] {
                new { Value = "", Label = "Tất cả", Icon = "list" },
                new { Value = "Pending", Label = "Chờ xác nhận", Icon = "schedule" },
                new { Value = "Confirmed", Label = "Đã xác nhận", Icon = "check_circle" },
                new { Value = "Shipped", Label = "Đang giao", Icon = "local_shipping" },
                new { Value = "Delivered", Label = "Hoàn thành", Icon = "verified" },
                new { Value = "Cancelled", Label = "Đã hủy", Icon = "cancel" }
            };
        }
        @foreach (var s in statuses)
        {
            var active = (currentStatus == s.Value) ? "bg-[#0d47a1] text-white border-[#0d47a1]" : "bg-white text-slate-700 border-slate-300 hover:border-[#0d47a1]";
            <a href="@Url.Action("Index", "AdminOrder", new { status = s.Value })"
               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold border-2 @active transition-all">
                <span class="material-symbols-outlined text-sm">@s.Icon</span>
                @s.Label
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-white border-2 border-slate-200 rounded-2xl p-10 text-center">
            <span class="material-symbols-outlined text-4xl text-slate-300 mb-3">inbox</span>
            <p class="text-sm text-slate-500">Không có đơn hàng nào.</p>
        </div>
    }
    else
    {
        <div class="bg-white border-2 border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-slate-50 border-b-2 border-slate-200">
                            <th class="text-left px-5 py-3 font-bold text-slate-700">Mã ĐH</th>
                            <th class="text-left px-5 py-3 font-bold text-slate-700">Khách hàng</th>
                            <th class="text-left px-5 py-3 font-bold text-slate-700">Ngày đặt</th>
                            <th class="text-right px-5 py-3 font-bold text-slate-700">Tổng tiền</th>
                            <th class="text-center px-5 py-3 font-bold text-slate-700">Trạng thái</th>
                            <th class="text-center px-5 py-3 font-bold text-slate-700">Thanh toán</th>
                            <th class="text-center px-5 py-3 font-bold text-slate-700"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        @foreach (var order in Model)
                        {
                            var sColor = "bg-slate-100 text-slate-600";
                            switch (order.Status)
                            {
                                case "Pending": sColor = "bg-amber-100 text-amber-700"; break;
                                case "Confirmed": sColor = "bg-blue-100 text-blue-700"; break;
                                case "Shipped": sColor = "bg-purple-100 text-purple-700"; break;
                                case "Delivered": sColor = "bg-green-100 text-green-700"; break;
                                case "Cancelled": sColor = "bg-red-100 text-red-700"; break;
                            }
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-5 py-3 font-bold text-slate-900">#@order.OrderID</td>
                                <td class="px-5 py-3 text-slate-600">@(order.User?.FullName ?? order.User?.Email ?? "N/A")</td>
                                <td class="px-5 py-3 text-slate-600">@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-5 py-3 text-right font-bold text-slate-900">@string.Format("{0:N0}đ", order.FinalAmount)</td>
                                <td class="px-5 py-3 text-center">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold @sColor">@order.Status</span>
                                </td>
                                <td class="px-5 py-3 text-center text-xs font-semibold text-slate-600">@order.PaymentStatus</td>
                                <td class="px-5 py-3 text-center">
                                    <a href="@Url.Action("Detail", "AdminOrder", new { id = order.OrderID })" class="px-3 py-1.5 rounded-lg bg-blue-50 text-[#0d47a1] hover:bg-[#0d47a1] hover:text-white font-bold text-xs border border-blue-200 transition-all">
                                        Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="text-xs text-slate-500 mt-3">Tổng: @Model.Count đơn hàng</p>
    }
</div>
