@model WebEcommerce.Models.CartViewModel

@{
    ViewBag.Title = "Giỏ hàng";
}

<!-- Anti-forgery Token for Cart Ajax Actions -->
@Html.AntiForgeryToken()

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Page Header -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#0d47a1] flex items-center justify-center shadow-xs">
                    <span class="material-symbols-outlined text-2xl">
                        shopping_cart
                    </span>
                </div>
                <h1 class="font-headline font-extrabold text-2xl sm:text-3xl text-[#1a1a2e]">
                    Giỏ hàng của bạn
                </h1>
            </div>
            <p class="text-sm text-slate-500">
                Kiểm tra sản phẩm và số lượng trước khi tiến hành thanh toán.
            </p>
        </div>

        @if (Model != null && Model.Items != null && Model.Items.Any())
        {
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold self-start sm:self-auto">
                <span class="material-symbols-outlined text-base text-[#0d47a1]">inventory_2</span>
                <span><strong class="text-slate-900" id="cart-item-count-badge">@Model.AvailableItemCount</strong> sản phẩm khả dụng</span>
            </div>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl border border-red-200 bg-red-50 text-red-700 text-sm font-semibold flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">error</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (Model != null && Model.HasOutOfStockItems)
    {
        <div class="mb-6 p-4 rounded-2xl border border-amber-200 bg-amber-50 text-amber-900 text-sm font-medium flex items-start gap-3 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-lg">inventory_2</span>
            </div>
            <div class="flex-1">
                <div class="font-bold text-amber-950 mb-0.5">Lưu ý giỏ hàng:</div>
                <div>Có <strong class="text-amber-950">@Model.OutOfStockCount</strong> sản phẩm tạm thời hết hàng (đã được làm mờ). Các sản phẩm này sẽ <strong class="text-amber-950">không được tính tiền</strong> và <strong class="text-amber-950">tự động loại khỏi đơn thanh toán</strong>. Bạn có thể bấm biểu tượng thùng rác để xóa sản phẩm khỏi giỏ.</div>
            </div>
        </div>
    }

    @if (Model == null || Model.Items == null || !Model.Items.Any())
    {
        <!-- Empty Cart State -->
        <div class="bg-white border-2 border-slate-200/80 rounded-3xl p-10 sm:p-14 text-center shadow-sm max-w-2xl mx-auto">
            <div class="w-24 h-24 mx-auto mb-6 rounded-2xl bg-blue-50/70 border border-blue-100 flex items-center justify-center text-[#0d47a1]">
                <span class="material-symbols-outlined text-5xl">
                    remove_shopping_cart
                </span>
            </div>

            <h2 class="font-headline font-extrabold text-2xl text-slate-900 mb-2">
                Giỏ hàng của bạn đang trống
            </h2>

            <p class="text-sm text-slate-500 max-w-md mx-auto mb-8 leading-relaxed">
                Bạn chưa thêm sản phẩm nào vào giỏ hàng. Hãy khám phá ngay các sản phẩm hot đang có ưu đãi lớn hôm nay!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="@Url.Action("Index", "Shop")"
                   class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl
                          bg-[#0d47a1] hover:bg-[#0a3880] active:scale-98
                          text-white font-bold text-sm shadow-md shadow-blue-900/10 transition-all">
                    <span class="material-symbols-outlined text-lg">
                        storefront
                    </span>
                    Khám phá cửa hàng
                </a>
                <a href="@Url.Action("Index", "Home")"
                   class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl
                          border-2 border-slate-200 hover:border-slate-300 hover:bg-slate-50
                          text-slate-700 font-bold text-sm transition-all">
                    <span class="material-symbols-outlined text-lg">
                        home
                    </span>
                    Trang chủ
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

            <!-- Left: Cart Items List -->
            <div class="lg:col-span-2 space-y-4">
                @foreach (var item in Model.Items)
                {
                    var isOut = item.IsOutOfStock;
                    <div class="cart-item bg-white border @(isOut ? "border-slate-300 bg-slate-100/70 opacity-60 grayscale-[35%] hover:opacity-85 hover:grayscale-0" : "border-slate-200/90 hover:border-slate-300")
                                rounded-2xl p-4 sm:p-6 shadow-xs hover:shadow-sm transition-all duration-200 relative"
                         data-product-id="@item.ProductID">

                        <div class="flex flex-col sm:flex-row gap-5 items-start sm:items-center">

                            <!-- Product Image (Clickable) -->
                            <a href="@Url.Action("Details", "Shop", new { id = item.ProductID })"
                               class="w-full sm:w-28 h-28 flex-shrink-0
                                      rounded-xl bg-slate-50 border border-slate-200/80
                                      flex items-center justify-center overflow-hidden group relative">
                                @if (!string.IsNullOrEmpty(item.ImageURL))
                                {
                                    <img src="@item.ImageURL"
                                         alt="@item.ProductName"
                                         class="w-full h-full object-contain p-2 group-hover:scale-105 transition-transform duration-200 @(isOut ? "grayscale" : "")"
                                         onerror="this.onerror=null; this.src='https://placehold.co/200x200/f8faff/0d47a1?text=TheChillShop';" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-4xl text-slate-300">
                                        image
                                    </span>
                                }
                                @if (isOut)
                                {
                                    <div class="absolute inset-0 bg-slate-900/50 flex items-center justify-center">
                                        <span class="px-2 py-0.5 rounded bg-rose-600 text-white font-bold text-2xs uppercase tracking-wider shadow">
                                            Hết hàng
                                        </span>
                                    </div>
                                }
                            </a>

                            <!-- Product Information -->
                            <div class="flex-1 min-w-0 w-full">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <a href="@Url.Action("Details", "Shop", new { id = item.ProductID })"
                                           class="font-headline font-bold text-base text-slate-900 hover:text-[#0d47a1] transition-colors line-clamp-2">
                                            @item.ProductName
                                        </a>

                                        <div class="flex items-center gap-2 mt-1.5 text-xs text-slate-500 flex-wrap">
                                            <span>Mã SP: #@item.ProductID</span>
                                            <span>•</span>
                                            @if (!isOut)
                                            {
                                                <span class="text-emerald-600 font-semibold flex items-center gap-1">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Còn hàng (@item.StockQuantity)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-700 font-bold text-xs">
                                                    <span class="material-symbols-outlined text-sm">remove_shopping_cart</span> Hết hàng
                                                </span>
                                                <span class="text-xs text-rose-600 font-medium italic">Không thể thanh toán</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Remove Button (Always enabled to allow removing sold-out items) -->
                                    <button type="button"
                                            class="btn-remove-cart-item flex-shrink-0
                                                   w-11 h-11 rounded-xl
                                                   border border-slate-200 bg-white
                                                   text-slate-400
                                                   hover:text-red-600
                                                   hover:border-red-300
                                                   hover:bg-red-50
                                                   active:scale-95
                                                   flex items-center justify-center
                                                   shadow-2xs
                                                   transition-all"
                                            data-product-id="@item.ProductID"
                                            data-product-name="@item.ProductName"
                                            aria-label="Xóa sản phẩm @item.ProductName khỏi giỏ hàng"
                                            title="Xóa sản phẩm">
                                        <span class="material-symbols-outlined text-xl">
                                            delete_outline
                                        </span>
                                    </button>
                                </div>

                                <!-- Price and Controls Row -->
                                <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
                                    <div>
                                        <span class="text-xs text-slate-400 block mb-0.5">Đơn giá</span>
                                        <span class="text-sm font-bold text-slate-800">
                                            @string.Format("{0:N0}đ", item.UnitPrice)
                                        </span>
                                    </div>

                                    <!-- Quantity Selector -->
                                    <div class="flex items-center">
                                        @if (isOut)
                                        {
                                            <div class="inline-flex items-center rounded-xl border border-slate-300 bg-slate-200/70 px-3 py-2 text-slate-500 text-xs font-semibold cursor-not-allowed select-none">
                                                <span class="material-symbols-outlined text-sm mr-1.5 text-slate-400">block</span>
                                                Tạm khóa (SL: @item.Quantity)
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="inline-flex items-center rounded-xl border border-slate-300 bg-slate-50 p-0.5 shadow-2xs">
                                                <button type="button"
                                                        class="btn-decrease-cart
                                                               w-10 h-10 sm:w-11 sm:h-11 rounded-lg
                                                               bg-white hover:bg-slate-100 active:scale-95
                                                               text-slate-700 disabled:opacity-40
                                                               flex items-center justify-center transition-all"
                                                        data-product-id="@item.ProductID"
                                                        aria-label="Giảm số lượng">
                                                    <span class="material-symbols-outlined text-lg">
                                                        remove
                                                    </span>
                                                </button>

                                                <span class="cart-item-quantity
                                                             min-w-[44px] h-10 sm:h-11
                                                             flex items-center justify-center
                                                             text-sm font-bold text-slate-900 px-2 select-none">
                                                    @item.Quantity
                                                </span>

                                                <button type="button"
                                                        class="btn-increase-cart
                                                               w-10 h-10 sm:w-11 sm:h-11 rounded-lg
                                                               bg-white hover:bg-slate-100 active:scale-95
                                                               text-slate-700 disabled:opacity-40
                                                               flex items-center justify-center transition-all"
                                                        data-product-id="@item.ProductID"
                                                        aria-label="Tăng số lượng">
                                                    <span class="material-symbols-outlined text-lg">
                                                        add
                                                    </span>
                                                </button>
                                            </div>
                                        }
                                    </div>

                                    <!-- Item Total -->
                                    <div class="text-right">
                                        <span class="text-xs text-slate-400 block mb-0.5">Thành tiền</span>
                                        @if (isOut)
                                        {
                                            <span class="font-headline font-bold text-sm text-slate-400 line-through">
                                                @string.Format("{0:N0}đ", item.ItemTotal)
                                            </span>
                                            <span class="block text-2xs text-rose-600 font-bold uppercase tracking-wider">0đ (Không tính)</span>
                                        }
                                        else
                                        {
                                            <span class="cart-item-total
                                                         font-headline font-extrabold
                                                         text-base sm:text-lg text-[#0d47a1]">
                                                @string.Format("{0:N0}đ", item.ItemTotal)
                                            </span>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }

                <!-- Bulk Shopping Action Bar -->
                <div class="flex items-center justify-between pt-2">
                    <a href="@Url.Action("Index", "Shop")"
                       class="inline-flex items-center gap-2 text-sm font-bold text-[#0d47a1] hover:text-[#0a3880] transition-colors">
                        <span class="material-symbols-outlined text-lg">arrow_back</span>
                        Tiếp tục lựa chọn sản phẩm khác
                    </a>
                </div>
            </div>

            <!-- Right: Order Summary Sidebar (Sticky) -->
            <div class="lg:col-span-1">
                <div class="bg-white border-2 border-slate-200/90
                            rounded-3xl p-6 sm:p-7 shadow-xs
                            lg:sticky lg:top-28 space-y-6">

                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                        <h2 class="font-headline font-extrabold text-lg text-slate-900 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#0d47a1]">receipt_long</span>
                            Tóm tắt đơn hàng
                        </h2>
                        <span class="text-xs text-slate-400 font-medium">Bảo mật SSL</span>
                    </div>

                    <!-- Price Calculations -->
                    <div class="space-y-3.5 text-sm">
                        <div class="flex items-center justify-between text-slate-600">
                            <div>
                                <span>Tạm tính</span>
                                @if (Model.HasOutOfStockItems)
                                {
                                    <span class="text-2xs text-amber-600 block font-medium">(Đã trừ các sản phẩm hết hàng)</span>
                                }
                            </div>
                            <span id="cart-subtotal"
                                  class="font-bold text-slate-900 text-base">
                                @string.Format("{0:N0}đ", Model.CartTotal)
                            </span>
                        </div>

                        <div class="flex items-center justify-between text-slate-600">
                            <span>Phí giao hàng</span>
                            <span class="font-semibold text-emerald-600 flex items-center gap-1">
                                <span class="material-symbols-outlined text-base">local_shipping</span>
                                Tính khi đặt hàng
                            </span>
                        </div>

                        <div class="flex items-center justify-between text-slate-600">
                            <span>Mã giảm giá</span>
                            <span class="text-slate-400 text-xs">Áp dụng ở bước tiếp theo</span>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="border-t border-dashed border-slate-200"></div>

                    <!-- Total Amount -->
                    <div class="flex items-baseline justify-between">
                        <div>
                            <span class="font-headline font-bold text-slate-900 block">
                                Tổng cộng
                            </span>
                            <span class="text-xs text-slate-400">(Đã bao gồm VAT)</span>
                        </div>

                        <span id="cart-total"
                              class="font-headline font-black text-2xl text-[#0d47a1]">
                            @string.Format("{0:N0}đ", Model.CartTotal)
                        </span>
                    </div>

                    <!-- Checkout Button: Active only if CanCheckout -->
                    @if (Model.CanCheckout)
                    {
                        <a href="@Url.Action("Checkout", "Order")"
                           class="w-full py-4 rounded-xl
                                  bg-[#0d47a1] hover:bg-[#0a3880] active:scale-98
                                  text-white font-bold text-base
                                  flex items-center justify-center gap-2
                                  shadow-lg shadow-blue-900/15 hover:shadow-xl hover:shadow-blue-900/25
                                  transition-all">
                            <span class="material-symbols-outlined text-xl">
                                credit_card
                            </span>
                            Tiến hành thanh toán (@Model.AvailableItemCount món)
                        </a>
                    }
                    else
                    {
                        <div class="space-y-2">
                            <button type="button"
                                    disabled="disabled"
                                    class="w-full py-4 rounded-xl
                                           bg-slate-200 text-slate-400 font-bold text-base
                                           flex items-center justify-center gap-2
                                           cursor-not-allowed select-none opacity-80">
                                <span class="material-symbols-outlined text-xl">
                                    block
                                </span>
                                Không thể thanh toán
                            </button>
                            <p class="text-xs text-center text-rose-600 font-semibold leading-relaxed">
                                Tất cả sản phẩm trong giỏ hàng đều đã hết hàng. Vui lòng xóa bớt hoặc chọn sản phẩm khác để đặt hàng.
                            </p>
                        </div>
                    }

                    <!-- Value Props / Guarantees -->
                    <div class="pt-4 border-t border-slate-100 space-y-2.5">
                        <div class="flex items-center gap-2.5 text-xs text-slate-500">
                            <span class="material-symbols-outlined text-base text-emerald-600">verified_user</span>
                            <span>Thanh toán an toàn 100% qua COD hoặc VietQR</span>
                        </div>
                        <div class="flex items-center gap-2.5 text-xs text-slate-500">
                            <span class="material-symbols-outlined text-base text-blue-600">autorenew</span>
                            <span>Hỗ trợ đổi trả miễn phí trong vòng 7 ngày</span>
                        </div>
                        <div class="flex items-center gap-2.5 text-xs text-slate-500">
                            <span class="material-symbols-outlined text-base text-amber-600">support_agent</span>
                            <span>Tổng đài CSKH đồng hành 24/7</span>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    }
</div>

@section scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        function notify(type, title, message) {
            if (window.showToast) {
                window.showToast({
                    type: type,
                    title: title,
                    message: message,
                    duration: 3200
                });
            } else {
                alert(message);
            }
        }

        function updateCartUI(productId, data, action) {
            if (data.removed || action === 'RemoveItem') {
                const itemEl = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                if (itemEl) {
                    itemEl.style.transition = 'all 0.3s ease-out';
                    itemEl.style.opacity = '0';
                    itemEl.style.transform = 'translateY(-10px)';
                    setTimeout(function () {
                        itemEl.remove();
                        // If cart empty, reload to show empty state
                        if (data.cartItemCount === 0 || document.querySelectorAll('.cart-item').length === 0) {
                            window.location.reload();
                        }
                    }, 300);
                }
            } else {
                const itemEl = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                if (itemEl) {
                    const qtyEl = itemEl.querySelector('.cart-item-quantity');
                    const itemTotalEl = itemEl.querySelector('.cart-item-total');
                    if (qtyEl && data.quantity !== undefined) qtyEl.innerText = data.quantity;
                    if (itemTotalEl && data.itemTotal !== undefined) {
                        itemTotalEl.innerText = new Intl.NumberFormat('vi-VN').format(data.itemTotal) + 'đ';
                    }
                }
            }

            const subtotalEl = document.getElementById('cart-subtotal');
            const totalEl = document.getElementById('cart-total');
            const badge = document.getElementById('cartBadgeCount');
            const countHeader = document.getElementById('cart-item-count-badge');
            
            if (subtotalEl && data.cartTotal !== undefined) {
                subtotalEl.innerText = new Intl.NumberFormat('vi-VN').format(data.cartTotal) + 'đ';
            }
            if (totalEl && data.cartTotal !== undefined) {
                totalEl.innerText = new Intl.NumberFormat('vi-VN').format(data.cartTotal) + 'đ';
            }
            if (badge && data.cartItemCount !== undefined) {
                badge.innerText = data.cartItemCount;
            }
            if (countHeader && data.cartItemCount !== undefined) {
                countHeader.innerText = data.cartItemCount;
            }
        }

        function sendCartAction(action, productId, triggerBtn) {
            if (!productId) {
                notify('warning', 'Lỗi sản phẩm', 'Mã sản phẩm không hợp lệ.');
                return;
            }

            if (triggerBtn) {
                triggerBtn.disabled = true;
                triggerBtn.style.opacity = '0.5';
            }

            const formData = new URLSearchParams();
            formData.append('productId', productId);
            if (token) formData.append('__RequestVerificationToken', token);

            fetch('@Url.Content("~/Cart/")' + action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            })
            .then(res => {
                if (res.redirected && res.url.toLowerCase().includes('login')) {
                    return { success: false, isAuth: true, message: 'Vui lòng đăng nhập lại để tiếp tục.' };
                }
                if (!res.ok) {
                    throw new Error('HTTP ' + res.status);
                }
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    updateCartUI(productId, data, action);
                    if (action === 'RemoveItem') {
                        notify('info', 'Đã xóa', data.message || 'Đã xóa sản phẩm khỏi giỏ hàng.');
                    }
                } else {
                    if (data.isAuth) {
                        notify('warning', 'Yêu cầu đăng nhập', data.message || 'Phiên đăng nhập đã hết hạn.');
                        setTimeout(function() {
                            window.location.href = '@Url.Action("Login", "Account")';
                        }, 1800);
                    } else {
                        notify('warning', 'Thông báo', data.message || 'Thao tác không thành công.');
                    }
                }
            })
            .catch(err => {
                console.error('[CartAction Error]', err);
                notify('error', 'Lỗi hệ thống', 'Đã xảy ra lỗi khi cập nhật giỏ hàng. Vui lòng thử lại.');
            })
            .finally(() => {
                if (triggerBtn) {
                    triggerBtn.disabled = false;
                    triggerBtn.style.opacity = '1';
                }
            });
        }

        document.querySelectorAll('.btn-increase-cart').forEach(btn => {
            btn.addEventListener('click', function () {
                const id = this.getAttribute('data-product-id');
                sendCartAction('IncreaseQuantity', id, this);
            });
        });

        document.querySelectorAll('.btn-decrease-cart').forEach(btn => {
            btn.addEventListener('click', function () {
                const id = this.getAttribute('data-product-id');
                sendCartAction('DecreaseQuantity', id, this);
            });
        });

        document.querySelectorAll('.btn-remove-cart-item').forEach(btn => {
            btn.addEventListener('click', function () {
                const id = this.getAttribute('data-product-id');
                const name = this.getAttribute('data-product-name') || 'sản phẩm này';
                if (confirm(`Bạn có chắc chắn muốn xóa "${name}" khỏi giỏ hàng?`)) {
                    sendCartAction('RemoveItem', id, this);
                }
            });
        });
    });
</script>
}