<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? "TheChillShop" : ViewBag.Title + " - TheChillShop")</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Material Symbols Outlined -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            primary: '#0d47a1',
                            primaryDark: '#0a3880',
                            accent: '#00b4d8',
                            accentHover: '#0096c7',
                            surface: '#f8faff',
                            border: '#e2e8f4',
                            charcoal: '#1a1a2e',
                            muted: '#5c6370',
                        }
                    },
                    fontFamily: {
                        headline: ['"Plus Jakarta Sans"', 'sans-serif'],
                        body: ['"Inter"', 'sans-serif']
                    }
                }
            }
        }
    </script>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="bg-[#f8faff] text-[#1a1a2e] font-body min-h-screen flex flex-col justify-between selection:bg-[#00b4d8]/20 selection:text-[#0d47a1]">

    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-[#0d47a1] via-[#0077b6] to-[#00b4d8] text-white text-xs py-2 px-4 shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-sm text-yellow-300">local_shipping</span>
                <span>Miễn phí vận chuyển toàn quốc cho đơn hàng từ 500.000đ</span>
            </div>
            <div class="hidden sm:flex items-center gap-4 text-white/90">
                <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">support_agent</span>
                    <span>Hotline: 1900 6868</span>
                </span>
                <span>•</span>
                <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">verified</span>
                    <span>100% Chính hãng</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b-2 border-slate-300 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20 gap-3 xl:gap-6">

                <!-- Logo TheChillShop -->
                <a href="@Url.Action("Index", "Home")" class="flex items-center gap-3 group flex-shrink-0">
                    <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-tr from-[#0d47a1] to-[#00b4d8] flex items-center justify-center text-white shadow-md shadow-[#0d47a1]/25 transition-transform group-hover:scale-105 duration-200">
                        <span class="material-symbols-outlined text-2xl">shopping_bag</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-headline font-extrabold text-xl sm:text-2xl tracking-tight text-[#0d47a1] leading-none">TheChill<span class="text-[#00b4d8]">Shop</span></span>
                        <span class="text-[9px] sm:text-[10px] uppercase font-bold tracking-widest text-slate-400 mt-1">Mua sắm thông minh</span>
                    </div>
                </a>

                <!-- Desktop Navigation Links (Nowrap + Flex-shrink-0 to prevent text breaking) -->
                <nav class="hidden lg:flex items-center gap-3 xl:gap-6 flex-shrink-0">
                    <a href="@Url.Action("Index", "Home")" class="text-sm font-semibold text-slate-700 hover:text-[#0d47a1] whitespace-nowrap transition-colors py-1">Trang chủ</a>
                    <a href="#" class="text-sm font-semibold text-slate-700 hover:text-[#0d47a1] whitespace-nowrap transition-colors py-1">Sản phẩm</a>
                    <a href="#" class="text-sm font-semibold text-slate-700 hover:text-[#0d47a1] whitespace-nowrap transition-colors py-1">Bộ sưu tập</a>
                    <a href="#" class="text-sm font-semibold text-slate-700 hover:text-[#0d47a1] whitespace-nowrap transition-colors py-1">Khuyến mãi</a>
                    <a href="@Url.Action("Contact", "Home")" class="text-sm font-semibold text-slate-700 hover:text-[#0d47a1] whitespace-nowrap transition-colors py-1">Liên hệ</a>
                </nav>

                <!-- Search Input Bar (Fixed min-width, never shrinks to a tiny circle) -->
                <div class="hidden md:flex items-center relative flex-1 max-w-[220px] xl:max-w-xs min-w-[170px]">
                    <input type="text" placeholder="Tìm sản phẩm..." class="w-full pl-9 pr-3 py-2 text-xs xl:text-sm bg-slate-50 border-2 border-slate-300 rounded-full focus:bg-white focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none text-[#1a1a2e]" />
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-lg pointer-events-none">search</span>
                </div>

                <!-- Right Actions: Cart & Auth Partial (No wrapping) -->
                <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
                    <!-- Shopping Cart Icon -->
                    <a href="@Url.Action("Index", "Cart")" class="relative p-2 text-slate-700 hover:text-[#0d47a1] bg-slate-50 hover:bg-white border-2 border-slate-300 hover:border-[#0d47a1] rounded-full transition-all shadow-sm flex-shrink-0" title="Giỏ hàng">
                        <span class="material-symbols-outlined text-2xl">shopping_cart</span>
                        <span id="cart-count" class="absolute -top-1 -right-1 w-5 h-5 bg-red-600 text-white rounded-full text-[10px] font-black flex items-center justify-center shadow-md">0</span>
                    </a>

                    @if (Request.IsAuthenticated)
                    {
                        <!-- Order History Icon -->
                        <a href="@Url.Action("Index", "Order")" class="relative p-2 text-slate-700 hover:text-[#0d47a1] bg-slate-50 hover:bg-white border-2 border-slate-300 hover:border-[#0d47a1] rounded-full transition-all shadow-sm flex-shrink-0" title="Lịch sử đơn hàng">
                            <span class="material-symbols-outlined text-2xl">receipt_long</span>
                        </a>
                    }

                    <!-- User Account / Login Partial -->
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </div>
    </header>

    @Html.AntiForgeryToken()

    <!-- Main Content Body -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-[#0b132b] text-slate-300 border-t border-slate-800 mt-20 pt-16 pb-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
                <!-- Col 1: Brand Info -->
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#00b4d8] to-[#0d47a1] flex items-center justify-center text-white shadow-lg shadow-[#00b4d8]/20">
                            <span class="material-symbols-outlined text-2xl">shopping_bag</span>
                        </div>
                        <span class="font-headline font-extrabold text-2xl text-white tracking-tight">TheChill<span class="text-[#00b4d8]">Shop</span></span>
                    </div>
                    <p class="text-sm text-slate-400 leading-relaxed">
                        Hệ thống bán lẻ thiết bị công nghệ chính hãng hàng đầu. Cam kết trải nghiệm mua sắm thông minh, chất lượng đỉnh cao và dịch vụ tận tâm.
                    </p>
                    <div class="flex flex-wrap items-center gap-3 text-xs pt-1">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">
                            <span class="material-symbols-outlined text-sm">lock</span> Bảo mật SSL 256-bit
                        </span>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-semibold">
                            <span class="material-symbols-outlined text-sm">verified</span> 100% Chính hãng
                        </span>
                    </div>
                </div>

                <!-- Col 2: About Us -->
                <div>
                    <h3 class="font-headline font-bold text-sm text-white uppercase tracking-wider mb-5 flex items-center gap-2">
                        <span class="w-1.5 h-4 rounded-full bg-[#00b4d8]"></span>
                        Về chúng tôi
                    </h3>
                    <ul class="space-y-3 text-sm text-slate-400">
                        <li><a href="@Url.Action("About", "Home")" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Giới thiệu TheChillShop</a></li>
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Hệ thống showroom toàn quốc</a></li>
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Chương trình Khách hàng thân thiết</a></li>
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Chính sách bảo mật thông tin</a></li>
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Điều khoản & Điều kiện giao dịch</a></li>
                    </ul>
                </div>

                <!-- Col 3: Customer Support -->
                <div>
                    <h3 class="font-headline font-bold text-sm text-white uppercase tracking-wider mb-5 flex items-center gap-2">
                        <span class="w-1.5 h-4 rounded-full bg-[#00b4d8]"></span>
                        Chăm sóc khách hàng
                    </h3>
                    <ul class="space-y-3 text-sm text-slate-400">
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Trung tâm trợ giúp & FAQ</a></li>
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Chính sách đổi trả 15 ngày 1 đổi 1</a></li>
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Tra cứu tình trạng đơn hàng</a></li>
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Hướng dẫn thanh toán & Trả góp 0%</a></li>
                        <li><a href="#" class="hover:text-cyan-400 hover:translate-x-1 inline-block transition-all">Chính sách giao hàng siêu tốc 2H</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact & Newsletter -->
                <div>
                    <h3 class="font-headline font-bold text-sm text-white uppercase tracking-wider mb-5 flex items-center gap-2">
                        <span class="w-1.5 h-4 rounded-full bg-[#00b4d8]"></span>
                        Kết nối với chúng tôi
                    </h3>
                    <div class="space-y-2 text-sm text-slate-400 mb-5">
                        <p class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-cyan-400 text-lg">call</span>
                            <span>Hotline: <strong class="text-white text-base">1900 6868</strong> (Miễn phí)</span>
                        </p>
                        <p class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-cyan-400 text-lg">mail</span>
                            <span>support@thechillshop.vn</span>
                        </p>
                    </div>

                    <p class="text-xs text-slate-400 mb-3">Đăng ký nhận mã giảm giá <strong>100.000đ</strong>:</p>
                    <form class="space-y-2" onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã đăng ký nhận tin từ TheChillShop!');">
                        <div class="flex">
                            <input type="email" placeholder="Nhập email của bạn..." class="w-full px-3.5 py-2.5 text-xs bg-slate-800/80 border border-slate-700 text-white rounded-l-xl focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 placeholder-slate-500" required />
                            <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-[#00b4d8] to-[#0077b6] hover:from-[#0096c7] hover:to-[#0d47a1] text-white text-xs font-bold rounded-r-xl transition-all shadow-md">Đăng ký</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Bottom Copyright & Badges -->
            <div class="border-t border-slate-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
                <p>&copy; @DateTime.Now.Year TheChillShop. Bản quyền thuộc về Nhóm TheChill - Đồ Án Cuối Kỳ.</p>
                <div class="flex items-center gap-4 text-slate-400">
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-cyan-400">shield</span> ASP.NET MVC 5</span>
                    <span>•</span>
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-cyan-400">database</span> PostgreSQL 17</span>
                    <span>•</span>
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-cyan-400">brush</span> Tailwind CSS</span>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/cart")
    @RenderSection("scripts", required: false)
</body>
</html>
