ontainer text-on-primary px-3 py-1 rounded text-caption-sm font-caption-sm font-semibold hover:bg-brand-red-vibrant transition-colors">Tìm</button></div><div id="searchSuggestions" class="absolute top-full left-0 right-0 bg-surface-card shadow-lg rounded-b-lg mt-1 hidden z-50 max-h-[400px] overflow-y-auto border border-border-subtle text-left"></div></form><div class="flex items-center gap-2 mt-1 text-badge-label font-badge-label text-on-primary/80 overflow-hidden whitespace-nowrap"><span class="opacity-70">Gợi ý:</span><a class="hover:underline" data-path="catalog" href="#">iPhone 16 Series</a><span>•</span><a class="hover:underline" data-path="catalog" href="#">Galaxy S25 Ultra</a><span>•</span><a class="hover:underline" data-path="catalog" href="#">MacBook M4</a><span>•</span><a class="hover:underline" data-path="catalog" href="#">Tai nghe Sony</a></div></div><div class="flex items-center gap-3 flex-shrink-0"><a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-on-primary/10 text-on-primary text-caption-sm font-caption-sm transition-colors" data-path="order-lookup" href="#"><span class="material-symbols-outlined text-[20px]">local_shipping</span><span class="text-left leading-tight"><span class="block text-[10px] opacity-80">Tra cứu</span>đơn hàng</span></a><a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-on-primary/10 text-on-primary text-caption-sm font-caption-sm transition-colors relative" data-path="cart" href="#"><span class="material-symbols-outlined text-[20px]">shopping_cart</span><span class="text-left leading-tight"><span class="block text-[10px] opacity-80">Giỏ</span>hàng</span><span class="absolute -top-1 -right-1 bg-surface-card text-primary-container font-bold text-[10px] w-5 h-5 rounded-full flex items-center justify-center shadow">3</span></a><div class="flex items-center gap-2 pl-2"><a class="flex items-center gap-2 bg-on-primary/10 hover:bg-on-primary/20 text-on-primary px-3 py-2 rounded-lg text-caption-sm font-caption-sm transition-colors" data-path="smember-profile" href="javascript:void(0)" onclick="document.getElementById('authModal').classList.remove('hidden')"><span class="material-symbols-outlined text-[20px]">account_circle</span><span class="text-left leading-tight"><span class="block text-[10px] opacity-80">Hội viên</span>Smember</span></a><button onclick="document.getElementById('authModal').classList.remove('hidden')" class="w-8 h-8 rounded-full bg-primary flex items-center justify-center hover:bg-brand-red-vibrant transition-colors cursor-pointer"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></button></div></div></div><div class="bg-surface-card text-on-surface shadow-[0_1px_4px_rgba(0,0,0,0.03)] border-b border-border-subtle"><nav class="max-w-[1280px] mx-auto px-4 flex items-center gap-1 overflow-x-auto py-2">

