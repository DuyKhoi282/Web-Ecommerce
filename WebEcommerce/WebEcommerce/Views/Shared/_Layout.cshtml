        <div class="w-4 h-4 bg-secondary text-white rounded text-[10px] font-bold flex items-center justify-center leading-none">Z</div>
      </button>
    </div>

    <div class="mt-6 text-center">
      <p id="authModalFooterText" class="text-xs text-text-muted">Chưa có tài khoản ShopeChill? <a href="javascript:void(0)" onclick="switchAuthTab('register')" class="text-primary font-bold hover:underline">Đăng ký ngay</a></p>
    </div>
  </div>
</div>
<script>
    // Search Autocomplete Logic
    const searchInput = document.getElementById('mainSearchInput');
    const suggestionsBox = document.getElementById('searchSuggestions');
    let searchTimeout;

    if (searchInput && suggestionsBox) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const term = this.value.trim();
            if (term.length < 2) {
                suggestionsBox.classList.add('hidden');
                return;
            }

            searchTimeout = setTimeout(() => {
                fetch(`@Url.Action("Autocomplete", "Search")?term=${encodeURIComponent(term)}`)
                    .then(res => res.json())
                    .then(data => {
                        suggestionsBox.innerHTML = '';
                        if (data && data.length > 0) {
                            data.forEach(item => {
                                const div = document.createElement('a');
                                div.href = `@Url.Action("Details", "Shop")/${item.id}`;
                                div.className = 'flex items-center gap-3 p-3 hover:bg-surface-canvas transition-colors border-b border-border-subtle last:border-0';
                                div.innerHTML = `
                                    <img src="${item.image}" alt="${item.name}" class="w-10 h-10 object-contain rounded" onerror="this.src='https://placehold.co/100x100/f8faff/0d47a1?text=TheChillShop'" />
                                    <div class="flex-1 min-w-0">
                                        <h4 class="text-xs font-semibold text-on-surface line-clamp-1">${item.name}</h4>
                                        <p class="text-[10px] text-primary-container font-bold">${new Intl.NumberFormat('vi-VN').format(item.price)}₫</p>
                                    </div>
                                `;
                                suggestionsBox.appendChild(div);
                            });
                            suggestionsBox.classList.remove('hidden');
                        } else {
                            suggestionsBox.innerHTML = '<div class="p-3 text-xs text-text-muted text-center">Không tìm thấy sản phẩm phù hợp.</div>';
                            suggestionsBox.classList.remove('hidden');
                        }
                    })
                    .catch(err => console.error("Autocomplete error:", err));
            }, 300);
        });

        // Hide suggestions when clicking outside
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                suggestionsBox.classList.add('hidden');
            }
        });
    }

    // Auth Modal Logic
    function antiForgeryParam() {
        const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
        return `__RequestVerificationToken=${encodeURIComponent(token)}`;
    }

    function handleLogin() {
        const email = document.getElementById('loginEmail').value;
        const password = document.getElementById('loginPassword').value;
        const remember = document.getElementById('loginRememberMe').checked;
        const errDiv = document.getElementById('loginError');
        
        errDiv.classList.add('hidden');

        fetch('@Url.Action("AjaxLogin", "Account")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `email=${encodeURIComponent(email)}&password=${encodeURIComponent(password)}&rememberMe=${remember}&${antiForgeryParam()}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                window.location.reload();
            } else {
                errDiv.innerText = data.message;
                errDiv.classList.remove('hidden');
            }
        })
        .catch(err => {
            errDiv.innerText = "Đã xảy ra lỗi hệ thống.";
            errDiv.classList.remove('hidden');
        });
    }

    function handleRegister() {
        const fn = document.getElementById('regFullName').value;
        const em = document.getElementById('regEmail').value;
        const pw = document.getElementById('regPassword').value;
        const cpw = document.getElementById('regConfirmPassword').value;
        const errDiv = document.getElementById('regError');
        
        errDiv.classList.add('hidden');

        fetch('@Url.Action("AjaxRegister", "Account")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `fullName=${encodeURIComponent(fn)}&email=${encodeURIComponent(em)}&password=${encodeURIComponent(pw)}&confirmPassword=${encodeURIComponent(cpw)}&${antiForgeryParam()}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Chuyển sang trang nhập mã OTP đã gửi tới email
                window.location.href = data.redirectUrl;
            } else {
                errDiv.innerText = data.message;
                errDiv.classList.remove('hidden');
            }
        })
        .catch(err => {
            errDiv.innerText = "Đã xảy ra lỗi hệ thống.";
            errDiv.classList.remove('hidden');
        });
    }

    // AJAX Cart Logic
    function fetchCartCount() {
        fetch('@Url.Action("GetCartCount", "Cart")')
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('cartBadgeCount');
                if (badge) badge.innerText = data.count || 0;
            })
            .catch(err => console.error("Error fetching cart count", err));
    }

    // Run on page load
    document.addEventListener("DOMContentLoaded", function() {
        fetchCartCount();
    });

    // Global Modern Toast Notification System
    window.showToast = function (opts) {
        if (typeof opts === 'string') {
            opts = { message: opts, type: 'info' };
        }
        var type = opts.type || 'info';
        var title = opts.title || (type === 'success' ? 'Thành công' : (type === 'error' ? 'Có lỗi xảy ra' : (type === 'warning' ? 'Chú ý' : 'Thông báo')));
        var message = opts.message || '';
        var duration = opts.duration !== undefined ? opts.duration : 4000;
        var actionText = opts.actionText || null;
        var onAction = opts.onAction || null;

        var container = document.getElementById('toastNotificationContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toastNotificationContainer';
            container.className = 'fixed top-5 right-5 z-[9999] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none px-4 sm:px-0';
            document.body.appendChild(container);
        }

        var config = {
            success: {
                icon: 'check_circle',
                border: 'border-l-emerald-500',
                iconBg: 'bg-emerald-100 text-emerald-600',
                bar: 'bg-emerald-500'
            },
            error: {
                icon: 'error',
                border: 'border-l-red-500',
                iconBg: 'bg-red-100 text-red-600',
                bar: 'bg-red-500'
            },
            warning: {
                icon: 'lock',
                border: 'border-l-amber-500',
                iconBg: 'bg-amber-100 text-amber-600',
                bar: 'bg-amber-500'
            },
            info: {
                icon: 'info',
                border: 'border-l-blue-500',
                iconBg: 'bg-blue-100 text-blue-600',
                bar: 'bg-blue-500'
            }
        }[type] || {
            icon: 'info',
            border: 'border-l-blue-500',
            iconBg: 'bg-blue-100 text-blue-600',
            bar: 'bg-blue-500'
        };

        var toast = document.createElement('div');
        toast.className = 'pointer-events-auto bg-white/95 backdrop-blur-md rounded-xl p-3.5 shadow-[0_10px_25px_rgba(0,0,0,0.12)] border border-slate-200/90 border-l-4 ' + config.border + ' flex items-start gap-3 transition-all duration-300 transform translate-y-[-10px] opacity-0 relative overflow-hidden text-left';
        
        var actionHtml = actionText ? '<button type="button" class="toast-action-btn mt-2 inline-flex items-center gap-1 text-[11px] font-bold text-primary hover:text-brand-red-vibrant transition-colors cursor-pointer">' + actionText + ' <span class="material-symbols-outlined text-[14px]">arrow_forward</span></button>' : '';

        toast.innerHTML = 
            '<div class="w-8 h-8 rounded-lg ' + config.iconBg + ' flex items-center justify-center shrink-0 mt-0.5">' +
                '<span class="material-symbols-outlined text-[19px]">' + config.icon + '</span>' +
            '</div>' +
            '<div class="flex-1 min-w-0 pr-4">' +
                '<h5 class="text-xs font-bold text-slate-800 leading-tight">' + title + '</h5>' +
                '<p class="text-[12px] text-slate-600 leading-snug mt-1 break-words">' + message + '</p>' +
                actionHtml +
            '</div>' +
            '<button type="button" class="toast-close-btn absolute top-2.5 right-2.5 text-slate-400 hover:text-slate-700 transition-colors p-1" title="Đóng">' +
                '<span class="material-symbols-outlined text-[15px]">close</span>' +
            '</button>' +
            (duration > 0 ? '<div class="toast-progress-bar absolute bottom-0 left-0 h-[2.5px] ' + config.bar + ' transition-all linear" style="width: 100%;"></div>' : '');

        container.appendChild(toast);

        requestAnimationFrame(function () {
            toast.classList.remove('translate-y-[-10px]', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            if (duration > 0) {
                var bar = toast.querySelector('.toast-progress-bar');
                if (bar) {
                    bar.style.transitionDuration = duration + 'ms';
                    requestAnimationFrame(function () {
                        bar.style.width = '0%';
                    });
                }
            }
        });

        function removeToast() {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-[-8px]', 'opacity-0');
            setTimeout(function () {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 300);
        }

        var closeBtn = toast.querySelector('.toast-close-btn');
        if (closeBtn) {
            closeBtn.addEventListener('click', removeToast);
        }

        if (actionText && onAction) {
            var actionBtn = toast.querySelector('.toast-action-btn');
            if (actionBtn) {
                actionBtn.addEventListener('click', function () {
                    onAction();
                    removeToast();
                });
            }
        }

        if (duration > 0) {
            setTimeout(removeToast, duration);
        }
    };

    window.addToCart = function(productId, qty = 1) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const formData = new URLSearchParams();
        formData.append('productId', productId);
        formData.append('quantity', qty);
        if(token) {
            formData.append('__RequestVerificationToken', token);
        }
        
        fetch('@Url.Action("AddToCart", "Cart")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: formData.toString()
        })
        .then(res => {
            if (res.redirected && res.url.toLowerCase().includes('login')) {
                return { success: false, isAuth: true, message: 'Phiên đăng nhập không hợp lệ hoặc đã hết hạn.' };
            }
            if (!res.ok) {
                throw new Error('HTTP ' + res.status);
            }
            return res.json();
        })
        .then(data => {
            if(data.success) {
                const badge = document.getElementById('cartBadgeCount');
                if(badge) badge.innerText = data.cartItemCount;
                showToast({
                    type: 'success',
                    title: 'Đã thêm vào giỏ hàng',
                    message: data.message || 'Sản phẩm đã được thêm vào giỏ hàng thành công.',
                    actionText: 'Xem giỏ hàng',
                    onAction: function() { window.location.href = '@Url.Action("Index", "Cart")'; }
                });
            } else {
                var isAuthExpired = data.isAuth || (data.message && (data.message.includes('Phiên đăng nhập') || data.message.includes('đăng nhập')));
                if (isAuthExpired) {
                    showToast({
                        type: 'warning',
                        title: 'Yêu cầu đăng nhập',
                        message: 'Phiên đăng nhập không hợp lệ hoặc đã hết hạn. Đang chuyển hướng...',
                        actionText: 'Đăng nhập ngay',
                        duration: 3500,
                        onAction: function() { window.location.href = '@Url.Action("Login", "Account")'; }
                    });
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Login", "Account")';
                    }, 1800);
                } else {
                    showToast({
                        type: 'error',
                        title: 'Không thể thêm giỏ hàng',
                        message: data.message || 'Đã có lỗi xảy ra. Vui lòng thử lại.'
                    });
                }
            }
        })
        .catch(err => {
            console.error(err);
            showToast({
                type: 'error',
                title: 'Lỗi hệ thống',
                message: 'Đã xảy ra lỗi khi thêm vào giỏ hàng. Vui lòng thử lại.'
            });
        });
    };

    // AJAX Wishlist Logic (nút tim có data-wishlist-id)
    function setWishlistBadge(count) {
        var badge = document.getElementById('wishlistBadgeCount');
        if (!badge) return;
        badge.innerText = count;
        badge.classList.toggle('hidden', count <= 0);
        badge.classList.toggle('flex', count > 0);
    }

    function setWishlistState(btn, isLiked) {
        var icon = btn.querySelector('.material-symbols-outlined');
        if (icon) {
            icon.style.fontVariationSettings = isLiked ? "'FILL' 1" : "'FILL' 0";
            icon.classList.toggle('text-primary', isLiked);
        }
        btn.setAttribute('aria-pressed', isLiked ? 'true' : 'false');
        btn.title = isLiked ? 'Bỏ yêu thích' : 'Thêm vào yêu thích';
    }

    window.toggleWishlist = function (btn) {
        var productId = btn.getAttribute('data-wishlist-id');
        if (!productId || btn.disabled) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const formData = new URLSearchParams();
        formData.append('productId', productId);
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }

        btn.disabled = true;
        fetch('@Url.Action("Toggle", "Wishlist")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
        .then(res => {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        })
        .then(data => {
            if (data.success) {
                document.querySelectorAll('[data-wishlist-id="' + productId + '"]').forEach(b => setWishlistState(b, data.isLiked));
                setWishlistBadge(data.count);
                showToast({ type: data.isLiked ? 'success' : 'info', title: 'Yêu thích', message: data.message });

                // Trang /Wishlist: bỏ thích thì ẩn card
                var grid = document.getElementById('wishlistGrid');
                if (!data.isLiked && grid && grid.contains(btn)) {
                    btn.closest('[data-product-id]')?.remove();
                    var remaining = grid.children.length;
                    var countEl = document.getElementById('wishlistCount');
                    if (countEl) countEl.innerText = remaining;
                    if (remaining === 0) window.location.reload();
                }
            } else if (data.requireLogin) {
                showToast({
                    type: 'warning',
                    title: 'Yêu cầu đăng nhập',
                    message: data.message,
                    actionText: 'Đăng nhập ngay',
                    onAction: function () {
                        window.location.href = data.loginUrl + '?returnUrl=' + encodeURIComponent(location.pathname + location.search);
                    }
                });
            } else {
                showToast({ type: 'error', message: data.message || 'Đã có lỗi xảy ra. Vui lòng thử lại.' });
            }
        })
        .catch(err => {
            console.error(err);
            showToast({ type: 'error', title: 'Lỗi hệ thống', message: 'Không thể cập nhật danh sách yêu thích. Vui lòng thử lại.' });
        })
        .finally(() => { btn.disabled = false; });
    };

    @if (Request.IsAuthenticated)
    {
    <text>
    document.addEventListener("DOMContentLoaded", function () {
        fetch('@Url.Action("MyProductIds", "Wishlist")')
            .then(res => res.json())
            .then(data => {
                setWishlistBadge((data.productIds || []).length);
                (data.productIds || []).forEach(id => {
                    document.querySelectorAll('[data-wishlist-id="' + id + '"]').forEach(b => setWishlistState(b, true));
                });
            })
            .catch(err => console.error("Error fetching wishlist", err));
    });
    </text>
    }

    // Header User Menu Dropdown toggling & Auth Modal helpers
    function toggleHeaderUserMenu(e) {
        if (e) e.stopPropagation();
        var menu = document.getElementById('headerUserDropdownMenu');
        if (menu) {
            menu.classList.toggle('hidden');
        }
    }

    function switchAuthTab(tab) {
        var loginForm = document.getElementById('loginForm');
        var registerForm = document.getElementById('registerForm');
        var modalTitle = document.getElementById('authModalTitle');
        var tabLoginBtn = document.getElementById('tabLoginBtn');
        var tabRegisterBtn = document.getElementById('tabRegisterBtn');
        var authFooterText = document.getElementById('authModalFooterText');

        var activeClasses = ['text-primary', 'font-bold', 'border-b-2', 'border-primary'];
        var inactiveClasses = ['text-text-muted', 'font-semibold'];

        if (tab === 'register') {
            if (loginForm) loginForm.classList.add('hidden');
            if (registerForm) registerForm.classList.remove('hidden');
            if (modalTitle) modalTitle.innerText = 'Đăng ký tài khoản ChillMember';

            if (tabRegisterBtn) {
                tabRegisterBtn.classList.add(...activeClasses);
                tabRegisterBtn.classList.remove(...inactiveClasses);
            }
            if (tabLoginBtn) {
                tabLoginBtn.classList.remove(...activeClasses);
                tabLoginBtn.classList.add(...inactiveClasses);
            }
            if (authFooterText) {
                authFooterText.innerHTML = 'Đã có tài khoản ShopeChill? <a href="javascript:void(0)" onclick="switchAuthTab(\'login\')" class="text-primary font-bold hover:underline">Đăng nhập ngay</a>';
            }
        } else {
            if (loginForm) loginForm.classList.remove('hidden');
            if (registerForm) registerForm.classList.add('hidden');
            if (modalTitle) modalTitle.innerText = 'Đăng nhập tài khoản ChillMember';

            if (tabLoginBtn) {
                tabLoginBtn.classList.add(...activeClasses);
                tabLoginBtn.classList.remove(...inactiveClasses);
            }
            if (tabRegisterBtn) {
                tabRegisterBtn.classList.remove(...activeClasses);
                tabRegisterBtn.classList.add(...inactiveClasses);
            }
            if (authFooterText) {
                authFooterText.innerHTML = 'Chưa có tài khoản ShopeChill? <a href="javascript:void(0)" onclick="switchAuthTab(\'register\')" class="text-primary font-bold hover:underline">Đăng ký ngay</a>';
            }
        }
    }

    function openAuthModal(tab) {
        var modal = document.getElementById('authModal');
        if (!modal) return;
        modal.classList.remove('hidden');
        var menu = document.getElementById('headerUserDropdownMenu');
        if (menu) menu.classList.add('hidden');
        
        switchAuthTab(tab || 'login');
    }

    document.addEventListener('click', function (e) {
        var wrapper = document.getElementById('headerUserMenuWrapper');
        var menu = document.getElementById('headerUserDropdownMenu');
        if (wrapper && menu && !wrapper.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });
</script>

<!-- Modern Toast Notification Container -->
<div id="toastNotificationContainer" class="fixed top-5 right-5 z-[9999] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

<!-- Floating Back to Top Button -->
<button id="backToTopBtn" type="button" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" 
        class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-primary-container text-on-primary shadow-xl flex items-center justify-center opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:scale-110 hover:shadow-2xl hover:bg-brand-red-vibrant active:scale-95 cursor-pointer" 
        title="Lên đầu trang">
    <span class="material-symbols-outlined text-[24px]">keyboard_arrow_up</span>
</button>

<script>
    // Lightweight Native Scroll Animations & Progress Tracking
    document.addEventListener('DOMContentLoaded', function () {
        const progressBar = document.getElementById('scrollProgressBar');
        const header = document.querySelector('header');
        const backToTopBtn = document.getElementById('backToTopBtn');

        // Scroll listener with passive flag for high frame-rate scrolling
        window.addEventListener('scroll', function () {
            const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            if (height > 0 && progressBar) {
                const scrolled = (winScroll / height) * 100;
                progressBar.style.width = scrolled + '%';
            }

            if (header) {
                if (winScroll > 30) {
                    header.classList.add('is-scrolled');
                } else {
                    header.classList.remove('is-scrolled');
                }
            }

            if (backToTopBtn) {
                if (winScroll > 320) {
                    backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
                    backToTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
                } else {
                    backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
                    backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
                }
            }
        }, { passive: true });

        // IntersectionObserver for elements with scroll-reveal classes
        const revealElements = document.querySelectorAll('.reveal-on-scroll, .reveal-from-left, .reveal-from-right, .reveal-scale, .reveal-stagger');
        if ('IntersectionObserver' in window) {
            const revealObserver = new IntersectionObserver(function (entries, observer) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                root: null,
                rootMargin: '0px 0px -40px 0px',
                threshold: 0.1
            });

            revealElements.forEach(function (el) {
                revealObserver.observe(el);
            });
        } else {
            revealElements.forEach(function (el) {
                el.classList.add('is-visible');
            });
        }
    });
</script>
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>
@RenderSection("scripts", required: false)</body></html>

