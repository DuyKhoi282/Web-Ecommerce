                    <p class="text-xs font-bold text-slate-800 truncate" title="@authEmail">@authEmail</p>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold @(isAdminOrManager ? "text-purple-700 bg-purple-100" : "text-red-700 bg-red-100") px-2 py-0.5 rounded-full mt-0.5">
                        <span class="w-1.5 h-1.5 rounded-full @(isAdminOrManager ? "bg-purple-600" : "bg-red-600")"></span>
                        @roleName
                    </span>
                </div>
            </div>

            <!-- Menu list -->
            <div class="py-2">
                @if (isAdminOrManager)
                {
                    if (User.IsInRole("Administrator"))
