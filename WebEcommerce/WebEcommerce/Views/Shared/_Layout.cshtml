}
<header class="fixed top-0 w-full z-50 bg-primary-container text-on-primary shadow-[0_1px_8px_rgba(0,0,0,0.06)]"><div class="bg-primary py-1 px-4 text-caption-sm font-caption-sm text-on-primary-container"><div class="max-w-[1280px] mx-auto flex items-center justify-between"><div class="flex items-center gap-4"><span>Hotline miễn phí: <strong class="text-on-primary">1800.2097</strong></span><span class="opacity-40">|</span><span class="flex items-center gap-1 cursor-pointer"><span class="material-symbols-outlined text-[14px]">location_on</span> Cửa hàng gần bạn: <span class="underline font-medium text-on-primary">TP. Hồ Chí Minh</span></span></div><div class="flex items-center gap-5"><a class="hover:text-on-primary transition-colors" data-path="order-lookup" href="@Url.Action("Index", "Order")">Tra cứu đơn hàng</a><a class="hover:text-on-primary transition-colors" data-path="trade-in" href="#">Thu cũ đổi mới</a><a class="hover:text-on-primary transition-colors" data-path="b2b-corporate" href="#">Khách hàng Doanh nghiệp (ChillBusiness)</a><a class="hover:text-on-primary transition-colors flex items-center gap-1" data-path="chillmember-rewards" href="#"><span class="material-symbols-outlined text-[14px] text-gold-star">workspace_premium</span> Ưu đãi ChillMember</a></div></div></div><div class="h-20 max-w-[1280px] mx-auto px-4 flex items-center justify-between gap-4"><div class="flex items-center gap-4 flex-shrink-0"><a href="@Url.Action("Index", "Home")" class="flex items-center hover:opacity-90 transition-opacity"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 340 80" class="h-9 w-auto"><g transform="translate(10, 10)"><rect x="2" y="16" width="46" height="42" rx="10" fill="#ffffff"/><path d="M15 16 V10 C15 4.5 19.5 0 25 0 C30.5 0 35 4.5 35 10 V16" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round"/><path d="M16 35 Q25 44 34 35" fill="none" stroke="#d70018" stroke-width="3.5" stroke-linecap="round"/><circle cx="34" cy="27" r="2" fill="#d70018"/></g><text x="72" y="49" font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-size="34" font-weight="800" fill="#ffffff" letter-spacing="-0.8">Shope<tspan fill="#ffe7e4">Chill</tspan></text><circle cx="316" cy="45" r="4.5" fill="#ffffff"/></svg></a><div class="relative group"><button class="flex items-center gap-2 bg-on-primary/10 hover:bg-on-primary/20 text-on-primary px-3 py-2 rounded-lg text-body-medium font-body-medium transition-colors"><span class="material-symbols-outlined text-[18px]">category</span><span class="text-xs">Danh Mục</span><span class="material-symbols-outlined text-[16px]">expand_more</span></button><div class="absolute left-0 top-full mt-2 w-56 bg-surface-card rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-border-subtle opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform origin-top-left z-50 overflow-hidden"><div class="py-2 flex flex-col">@foreach (var cat in layoutCategories){<a href="@Url.Action("Index", "Search", new { categoryId = cat.CategoryID })" class="px-4 py-2 text-sm text-on-surface hover:bg-surface-canvas hover:text-primary transition-colors flex items-center justify-between group/item"><span>@cat.Name</span><span class="material-symbols-outlined text-[16px] text-text-muted opacity-0 group-hover/item:opacity-100 transition-opacity">chevron_right</span></a>}</div></div></div></div><div class="flex-1 max-w-2xl px-2"><form action="@Url.Action("Index", "Search")" method="get" class="relative flex items-center w-full"><input id="mainSearchInput" name="keyword" autocomplete="off" class="w-full bg-surface-card text-on-surface placeholder:text-text-muted text-body-default font-body-default rounded-lg pl-10 pr-24 py-2.5 focus:outline-none shadow-sm" placeholder="Bạn cần tìm gì hôm nay?" type="text"/><span class="material-symbols-outlined text-text-muted absolute left-3 text-[20px]">search</span><div class="absolute right-2 flex items-center gap-1"><button type="submit" class="bg-primary-container text-on-primary px-3 py-1 rounded text-caption-sm font-caption-sm font-semibold hover:bg-brand-red-vibrant transition-colors">Tìm</button></div><div id="searchSuggestions" class="absolute top-full left-0 right-0 bg-surface-card shadow-lg rounded-b-lg mt-1 hidden z-50 max-h-[400px] overflow-y-auto border border-border-subtle text-left"></div></form><div class="flex items-center gap-2 mt-1 text-badge-label font-badge-label text-on-primary/80 overflow-hidden whitespace-nowrap"><span class="opacity-70">Gợi ý:</span><a class="hover:underline" data-path="catalog" href="#">iPhone 16 Series</a><span>•</span><a class="hover:underline" data-path="catalog" href="#">Galaxy S25 Ultra</a><span>•</span><a class="hover:underline" data-path="catalog" href="#">MacBook M4</a><span>•</span><a class="hover:underline" data-path="catalog" href="#">Tai nghe Sony</a></div></div><div class="flex items-center gap-3 flex-shrink-0"><a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-on-primary/10 text-on-primary text-caption-sm font-caption-sm transition-colors" data-path="order-lookup" href="@Url.Action("Index", "Order")"><span class="material-symbols-outlined text-[20px]">local_shipping</span><span class="text-left leading-tight"><span class="block text-[10px] opacity-80">Tra cứu</span>đơn hàng</span></a><a class="flex items-center justify-center w-10 h-10 rounded-lg hover:bg-on-primary/10 text-on-primary transition-colors relative" href="@Url.Action("Index", "Wishlist")" title="Sản phẩm yêu thích" aria-label="Sản phẩm yêu thích"><span class="material-symbols-outlined text-[22px]">favorite</span><span id="wishlistBadgeCount" class="absolute -top-1 -right-1 bg-surface-card text-primary-container font-bold text-[10px] w-5 h-5 rounded-full items-center justify-center shadow hidden">0</span></a><a class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-on-primary/10 text-on-primary text-caption-sm font-caption-sm transition-colors relative" data-path="cart"href="@Url.Action("Index", "Cart")"><span class="material-symbols-outlined text-[20px]">shopping_cart</span><span class="text-left leading-tight"><span class="block text-[10px] opacity-80">Giỏ</span>hàng</span><span id="cartBadgeCount" class="absolute -top-1 -right-1 bg-surface-card text-primary-container font-bold text-[10px] w-5 h-5 rounded-full flex items-center justify-center shadow">0</span></a><div class="flex items-center gap-2 pl-2 relative" id="headerUserMenuWrapper">
    <!-- Logout form for Anti-CSRF token -->
