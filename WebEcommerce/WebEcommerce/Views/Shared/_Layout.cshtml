<header class="fixed top-0 w-full z-50 bg-primary-container text-on-primary shadow-[0_1px_8px_rgba(0,0,0,0.06)]"><div class="bg-primary py-1 px-4 text-caption-sm font-caption-sm text-on-primary-container"><div class="max-w-[1280px] mx-auto flex items-center justify-between"><div class="flex items-center gap-4"><span>Hotline miễn phí: <strong class="text-on-primary">1800.2097</strong></span><span class="opacity-40">|</span><span class="flex items-center gap-1 cursor-pointer"><span class="material-symbols-outlined text-[14px]">location_on</span> Cửa hàng gần bạn: <span class="underline font-medium text-on-primary">TP. Hồ Chí Minh</span></span></div><div class="flex items-center gap-5"><a class="hover:text-on-primary transition-colors" data-path="order-lookup" href="#">Tra cứu đơn hàng</a><a class="hover:text-on-primary transition-colors" data-path="trade-in" href="#">Thu cũ đổi mới</a><a class="hover:text-on-primary transition-colors" data-path="b2b-corporate" href="#">Khách hàng Doanh nghiệp (S-Business)</a><a class="hover:text-on-primary transition-colors flex items-center gap-1" data-path="smember-rewards" href="#"><span class="material-symbols-outlined text-[14px] text-gold-star">workspace_premium</span> Ưu đãi Smember</a></div></div></div><div class="h-20 max-w-[1280px] mx-auto px-4 flex items-center justify-between gap-4"><div class="flex items-center gap-4 flex-shrink-0"><a href="@Url.Action("Index", "Home")" class="flex items-center hover:opacity-90 transition-opacity"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 340 80" class="h-9 w-auto"><g transform="translate(10, 10)"><rect x="2" y="16" width="46" height="42" rx="10" fill="#ffffff"/><path d="M15 16 V10 C15 4.5 19.5 0 25 0 C30.5 0 35 4.5 35 10 V16" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round"/><path d="M16 35 Q25 44 34 35" fill="none" stroke="#d70018" stroke-width="3.5" stroke-linecap="round"/><circle cx="34" cy="27" r="2" fill="#d70018"/></g><text x="72" y="49" font-family