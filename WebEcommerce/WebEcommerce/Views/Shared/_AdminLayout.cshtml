<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? "Quản trị" : ViewBag.Title) - ShopeChill Admin</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Material Symbols Outlined -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        chill: {
                            primary: "#d70018",
                            primaryDark: "#b91c1c",
                            accent: "#ff4d4d",
                            lightBg: "#f8faff",
                            border: "#e2e8f4",
                            charcoal: "#1a1a2e",
                            grayText: "#5c6370"
                        }
                    },
                    fontFamily: {
                        headline: ['"Plus Jakarta Sans"', 'sans-serif'],
                        body: ['"Inter"', 'sans-serif']
                    }
                }
            }
        }
    </script>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        /* Đảm bảo toàn bộ viền và thẻ giao diện admin phân tách nền sắc nét */
        *, ::before, ::after {
            border-style: solid;
        }
        .admin-canvas {
            background-color: #e9eff6 !important;
        }
        .admin-card {
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.07), 0 2px 6px -1px rgba(15, 23, 42, 0.04);
        }
        /* Scrollbar ngang mượt mà cho các bảng admin khi zoom to hoặc màn hình hẹp */
        .overflow-x-auto::-webkit-scrollbar {
            height: 7px;
        }
        .overflow-x-auto::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .overflow-x-auto::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .overflow-x-auto::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
<body class="bg-[#e9eff6] text-[#1a1a2e] font-body min-h-screen antialiased">

    <!-- ========================================== -->
    <!-- SIDEBAR NAVIGATION (Deep Blue #d70018)    -->
    <!-- ========================================== -->
    <aside id="adminSidebar" class="fixed top-0 left-0 h-screen w-64 z-40 bg-[#d70018] text-white shadow-2xl flex flex-col justify-between py-6 px-0 select-none transition-transform duration-300 -translate-x-full lg:translate-x-0">
        <div>
            <!-- Logo Section -->
            <div class="px-6 mb-8 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-[#ff4d4d] shadow-inner">
                    <span class="material-symbols-outlined text-2xl">shopping_cart</span>
                </div>
                <div>
                    <span class="font-headline font-extrabold text-xl tracking-tight text-white block">TheChill<span class="text-[#ff4d4d]">Shop</span></span>
                    <span class="text-[10px] tracking-wider uppercase font-semibold text-red-200/80 block">@(User.IsInRole("Administrator") ? "Quản Trị Hệ Thống" : "Kênh Người Bán")</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="space-y-1 px-3">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }

                <!-- Tổng quan / Dashboard (Cả Admin và StoreManager) -->
                <a href="@Url.Action("Index", "AdminDashboard")" 
                   class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(currentController == "AdminDashboard" ? "bg-white/20 text-white shadow-md border-l-4 border-[#ff4d4d]" : "text-blue-100/80 hover:bg-white/10 hover:text-white")">
                    <span class="material-symbols-outlined text-xl @(currentController == "AdminDashboard" ? "text-[#ff4d4d]" : "")">dashboard</span>
                    <span>Tổng quan</span>
                </a>

                <!-- Quản lý tài khoản (Độc quyền Administrator) -->
                @if (User.IsInRole("Administrator"))
                {
                    <a href="@Url.Action("Index", "AdminUser")" 
                       class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(currentController == "AdminUser" ? "bg-white/20 text-white shadow-md border-l-4 border-[#ff4d4d]" : "text-blue-100/80 hover:bg-white/10 hover:text-white")">
                        <span class="material-symbols-outlined text-xl @(currentController == "AdminUser" ? "text-[#ff4d4d]" : "")">group</span>
                        <span>Quản lý tài khoản</span>
                    </a>
                }

                <!-- Nghiệp vụ Bán hàng & Hàng hóa (StoreManager & Administrator) -->
                @if (User.IsInRole("StoreManager") || User.IsInRole("Administrator"))
                {
                    <!-- Quản lý danh mục -->
                    <a href="@Url.Action("Index", "Category")" 
                       class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(currentController == "Category" ? "bg-white/20 text-white shadow-md border-l-4 border-[#ff4d4d]" : "text-blue-100/80 hover:bg-white/10 hover:text-white")">
                        <span class="material-symbols-outlined text-xl @(currentController == "Category" ? "text-[#ff4d4d]" : "")">category</span>
                        <span>Danh mục sản phẩm</span>
                    </a>

                    <!-- Quản lý sản phẩm -->
                    <a href="@Url.Action("Index", "Product")" 
                       class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(currentController == "Product" ? "bg-white/20 text-white shadow-md border-l-4 border-[#ff4d4d]" : "text-blue-100/80 hover:bg-white/10 hover:text-white")">
                        <span class="material-symbols-outlined text-xl @(currentController == "Product" ? "text-[#ff4d4d]" : "")">inventory_2</span>
                        <span>Quản lý sản phẩm</span>
                    </a>

                    <!-- Quản lý kho & tồn kho -->
                    <a href="@Url.Action("Index", "Inventory")" 
                       class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(currentController == "Inventory" ? "bg-white/20 text-white shadow-md border-l-4 border-[#ff4d4d]" : "text-blue-100/80 hover:bg-white/10 hover:text-white")">
                        <span class="material-symbols-outlined text-xl @(currentController == "Inventory" ? "text-[#ff4d4d]" : "")">warehouse</span>
                        <span>Kho & Tồn kho</span>
                    </a>

                    <!-- Quản lý đơn hàng -->
                    <a href="@Url.Action("Index", "AdminOrder")" 
                       class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(currentController == "AdminOrder" ? "bg-white/20 text-white shadow-md border-l-4 border-[#ff4d4d]" : "text-blue-100/80 hover:bg-white/10 hover:text-white")">
                        <span class="material-symbols-outlined text-xl @(currentController == "AdminOrder" ? "text-[#ff4d4d]" : "")">receipt_long</span>
                        <span>Quản lý đơn hàng</span>
                    </a>
                }

                <div class="pt-4 pb-2 px-4 text-[11px] font-bold text-blue-300/60 uppercase tracking-wider">Hệ thống</div>

                <!-- Về trang bán hàng -->
                <a href="@Url.Action("Index", "Home")" 
                   class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold text-blue-100/80 hover:bg-white/10 hover:text-white transition-all">
                    <span class="material-symbols-outlined text-xl">storefront</span>
                    <span>Về trang bán hàng</span>
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer: Admin profile & Logout -->
        <div class="px-4 pt-4 border-t border-white/10">
            @{
                var adminUserEmail = User.Identity.IsAuthenticated ? User.Identity.Name : "Admin";
                var adminRoleTitle = User.IsInRole("Administrator") ? "Quản trị viên" : (User.IsInRole("StoreManager") ? "Người bán" : "Nhân viên");
                var adminInitial = !string.IsNullOrEmpty(adminUserEmail) && adminUserEmail.Length >= 2 
                    ? adminUserEmail.Substring(0, 2).ToUpper() 
                    : "AD";
            }
            <div class="flex items-center justify-between p-2 rounded-xl bg-white/10 border border-white/15">
                <div class="flex items-center gap-2.5 truncate">
                    <div class="w-9 h-9 rounded-full bg-[#ff4d4d] text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">
                        @adminInitial
                    </div>
                    <div class="truncate text-left">
                        <span class="block text-xs font-bold text-white truncate" title="@adminUserEmail">@adminUserEmail</span>
                        <span class="block text-[10px] text-red-200 font-semibold">@adminRoleTitle</span>
                    </div>
                </div>

                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "adminLogoutForm", @class = "inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" title="Đăng xuất" class="p-1.5 text-red-200 hover:text-red-300 hover:bg-white/10 rounded-lg transition-colors">
                        <span class="material-symbols-outlined text-lg">logout</span>
                    </button>
                }
            </div>
        </div>
    </aside>

    <!-- Backdrop khi mở sidebar trên màn hình hẹp/zoom to -->
    <div id="sidebarBackdrop" class="fixed inset-0 bg-black/40 z-30 hidden backdrop-blur-sm transition-opacity" onclick="toggleSidebar()"></div>

    <!-- ========================================== -->
    <!-- MAIN CONTENT AREA                          -->
    <!-- ========================================== -->
    <div id="adminMainContent" class="w-full lg:ml-64 lg:w-[calc(100%-16rem)] flex flex-col min-h-screen min-w-0 max-w-full transition-all duration-300">

        <!-- Top Header Bar -->
        <header class="sticky top-0 z-20 bg-white/95 backdrop-blur border-b-2 border-slate-300 px-4 sm:px-6 py-3 flex items-center justify-between shadow-sm gap-3">
            <div class="flex items-center gap-3">
                <!-- Nút toggle sidebar cho màn hình hẹp & zoom to -->
                <button type="button" onclick="toggleSidebar()" class="p-2 text-slate-700 hover:text-[#d70018] hover:bg-slate-100 rounded-xl transition-colors border border-slate-300 flex items-center justify-center shadow-sm" title="Đóng/Mở menu điều hướng">
                    <span class="material-symbols-outlined text-xl">menu</span>
                </button>
                <!-- Breadcrumbs / Section Title -->
                <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
                    <a href="@Url.Action("Index", "AdminDashboard")" class="hover:text-[#d70018] font-bold">@(User.IsInRole("Administrator") ? "Quản trị" : "Kênh người bán")</a>
                    <span>/</span>
                    <span class="text-slate-900 font-bold">@(ViewBag.Title ?? "Dashboard")</span>
                </div>
            </div>

            <!-- Topbar Search & Notification -->
            <div class="flex items-center gap-3">
                <div class="relative w-36 sm:w-60">
                    <input type="text" placeholder="Tìm kiếm..." class="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 border-2 border-slate-300 rounded-xl focus:bg-white focus:border-[#d70018] outline-none transition-all text-slate-800" />
                    <span class="material-symbols-outlined absolute left-2 top-2 text-slate-400 text-sm">search</span>
                </div>

                <div class="flex items-center gap-2 border-l-2 border-slate-200 pl-3">
                    <button class="relative p-1.5 text-slate-600 hover:text-[#d70018] bg-slate-50 hover:bg-white border-2 border-slate-300 rounded-xl transition-colors shadow-sm" title="Thông báo">
                        <span class="material-symbols-outlined text-lg">notifications</span>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    <span class="hidden sm:inline-block text-xs font-bold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-300">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </header>

        <!-- Dynamic Body Page Content (Nền #e9eff6 tách biệt sắc nét với các Card màu trắng) -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 bg-[#e9eff6] admin-canvas min-w-0 max-w-full">
            @RenderBody()
        </main>

        <!-- Admin Footer -->
        <footer class="bg-white border-t-2 border-slate-300 px-6 py-4 text-xs text-slate-600 flex items-center justify-between">
            <span class="font-medium">&copy; @DateTime.Now.Year ShopeChill Ecommerce • Hệ thống hoạt động ổn định</span>
            <span class="font-semibold text-[#d70018]">Hệ thống phân quyền RBAC • Phiên bản 1.0</span>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById('adminSidebar');
            var mainContent = document.getElementById('adminMainContent');
            var backdrop = document.getElementById('sidebarBackdrop');

            if (window.innerWidth < 1024) {
                // Mobile or high zoom mode: overlay drawer
                if (sidebar.classList.contains('-translate-x-full')) {
                    sidebar.classList.remove('-translate-x-full');
                    backdrop.classList.remove('hidden');
                } else {
                    sidebar.classList.add('-translate-x-full');
                    backdrop.classList.add('hidden');
                }
            } else {
                // Desktop mode: collapse / expand
                if (sidebar.classList.contains('lg:-translate-x-full')) {
                    sidebar.classList.remove('lg:-translate-x-full');
                    mainContent.classList.add('lg:ml-64');
                    mainContent.classList.remove('lg:ml-0', 'lg:w-full');
                    mainContent.classList.add('lg:w-[calc(100%-16rem)]');
                } else {
                    sidebar.classList.add('lg:-translate-x-full');
                    mainContent.classList.remove('lg:ml-64', 'lg:w-[calc(100%-16rem)]');
                    mainContent.classList.add('lg:ml-0', 'lg:w-full');
                }
            }
        }
    </script>
</body>
</html>

