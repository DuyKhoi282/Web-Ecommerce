<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? "Quản trị" : ViewBag.Title) - TheChillShop Admin</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Material Symbols Outlined -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        chill: {
                            primary: "#d70018",
                            primaryDark: "#b91c1c",
                            accent: "#ff4d4d",
                            lightBg: "#f8faff",
                            border: "#e2e8f4",
                            charcoal: "#1a1a2e",
                            grayText: "#5c6370"
                        }
                    },
                    fontFamily: {
                        headline: ['"Plus Jakarta Sans"', 'sans-serif'],
                        body: ['"Inter"', 'sans-serif']
                    }
                }
            }
        }
    </script>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        /* Đảm bảo toàn bộ viền và thẻ giao diện admin phân tách nền sắc nét */
        *, ::before, ::after {
            border-style: solid;
        }
        .admin-canvas {
            background-color: #e9eff6 !important;
        }
        .admin-card {
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.07), 0 2px 6px -1px rgba(15, 23, 42, 0.04);
        }
        /* Scrollbar ngang mượt mà cho các bảng admin khi zoom to hoặc màn hình hẹp */
        .overflow-x-auto::-webkit-scrollbar {
            height: 7px;
        }
        .overflow-x-auto::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .overflow-x-auto::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .overflow-x-auto::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
<body class="bg-[#e9eff6] text-[#1a1a2e] font-body min-h-screen antialiased">

    <!-- ========================================== -->
    <!-- SIDEBAR NAVIGATION (Deep Blue #d70018)    -->
    <!-- ========================================== -->
    <aside id="adminSidebar" class="fixed top-0 left-0 h-screen w-64 z-40 bg-[#d70018] text-white shadow-2xl flex flex-col justify-between py-6 px-0 select-none transition-transform duration-300 -translate-x-full lg:translate-x-0">
        <div class="min-h-0 overflow-y-auto">
            <!-- Logo Section -->
            <div class="px-6 mb-6 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-[#d70018] shadow-sm">
                    <span class="material-symbols-outlined text-2xl">shopping_cart</span>
                </div>
                <div>
                    <span class="font-headline font-extrabold text-xl tracking-tight text-white block">TheChill<span class="text-red-200">Shop</span></span>
                    <span class="text-[10px] tracking-wider uppercase font-semibold text-red-100 block">@(User.IsInRole("Administrator") ? "Quản Trị Hệ Thống" : "Kênh Người Bán")</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="space-y-1 px-3">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                    // Mục đang chọn: nền trắng chữ đỏ để tách hẳn khỏi nền sidebar
                    Func<string, string> navCls = c => "flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors "
                        + (currentController == c ? "bg-white text-[#d70018] shadow-sm" : "text-white hover:bg-white/15");
                }

                <!-- Tổng quan / Dashboard (Cả Admin và StoreManager) -->
                <a href="@Url.Action("Index", "AdminDashboard")" 
                   class="@navCls("AdminDashboard")">
                    <span class="material-symbols-outlined text-xl">dashboard</span>
                    <span>Tổng quan</span>
                </a>

                <!-- Quản lý tài khoản (Độc quyền Administrator) -->
                @if (User.IsInRole("Administrator"))
                {
                    <a href="@Url.Action("Index", "AdminUser")" 
                       class="@navCls("AdminUser")">
                        <span class="material-symbols-outlined text-xl">group</span>
                        <span>Quản lý tài khoản</span>
                    </a>
                }

                <!-- Nghiệp vụ Bán hàng & Hàng hóa (StoreManager & Administrator) -->
                @if (User.IsInRole("StoreManager") || User.IsInRole("Administrator"))
                {
                    <!-- Quản lý danh mục -->
                    <a href="@Url.Action("Index", "Category")" 
                       class="@navCls("Category")">
                        <span class="material-symbols-outlined text-xl">category</span>
                        <span>Danh mục sản phẩm</span>
                    </a>

                    <!-- Quản lý sản phẩm -->
                    <a href="@Url.Action("Index", "Product")" 
                       class="@navCls("Product")">
                        <span class="material-symbols-outlined text-xl">inventory_2</span>
                        <span>Quản lý sản phẩm</span>
                    </a>

                    <!-- Quản lý kho & tồn kho -->
                    <a href="@Url.Action("Index", "Inventory")" 
                       class="@navCls("Inventory")">
                        <span class="material-symbols-outlined text-xl">warehouse</span>
                        <span>Kho & Tồn kho</span>
                    </a>

                    <!-- Quản lý đơn hàng -->
                    <a href="@Url.Action("Index", "AdminOrder")" 
                       class="@navCls("AdminOrder")">
                        <span class="material-symbols-outlined text-xl">receipt_long</span>
                        <span>Quản lý đơn hàng</span>
                    </a>

                    <!-- Quản lý mã giảm giá (Voucher) -->
                    <a href="@Url.Action("Index", "Promotion")" 
                       class="@navCls("Promotion")">
                        <span class="material-symbols-outlined text-xl">confirmation_number</span>
                        <span>Mã giảm giá (Voucher)</span>
                    </a>

                    <!-- Quản lý sự kiện Flash Sale -->
                    <a href="@Url.Action("Index", "FlashSale")" 
                       class="@navCls("FlashSale")">
                        <span class="material-symbols-outlined text-xl">bolt</span>
                        <span>Sự kiện Flash Sale</span>
                    </a>
                }

                <div class="pt-4 pb-2 px-3.5 text-[11px] font-bold text-red-100 uppercase tracking-wider">Hệ thống</div>

                <!-- Về trang bán hàng -->
                <a href="@Url.Action("Index", "Home")" class="@navCls("Home")">
                    <span class="material-symbols-outlined text-xl">storefront</span>
                    <span>Về trang bán hàng</span>
                </a>
            </nav>
        </div>
    </aside>

    <!-- Backdrop khi mở sidebar trên màn hình hẹp/zoom to -->
    <div id="sidebarBackdrop" class="fixed inset-0 bg-black/40 z-30 hidden backdrop-blur-sm transition-opacity" onclick="toggleSidebar()"></div>

    <!-- ========================================== -->
    <!-- MAIN CONTENT AREA                          -->
    <!-- ========================================== -->
    <div id="adminMainContent" class="w-full lg:ml-64 lg:w-[calc(100%-16rem)] flex flex-col min-h-screen min-w-0 max-w-full transition-all duration-300">

        <!-- Top Header Bar -->
        <header class="sticky top-0 z-20 bg-white/95 backdrop-blur border-b-2 border-slate-300 px-4 sm:px-6 py-3 flex items-center justify-between shadow-sm gap-3">
            <div class="flex items-center gap-3">
                <!-- Nút toggle sidebar cho màn hình hẹp & zoom to -->
                <button type="button" onclick="toggleSidebar()" class="p-2 text-slate-700 hover:text-[#d70018] hover:bg-slate-100 rounded-xl transition-colors border border-slate-300 flex items-center justify-center shadow-sm" title="Đóng/Mở menu điều hướng">
                    <span class="material-symbols-outlined text-xl">menu</span>
                </button>
                <!-- Tên trang đã có ở h1 của từng view nên header chỉ giữ link về khu quản trị -->
                <a href="@Url.Action("Index", "AdminDashboard")" class="hidden sm:inline text-xs font-bold text-slate-500 hover:text-[#d70018] whitespace-nowrap">@(User.IsInRole("Administrator") ? "Quản trị" : "Kênh người bán")</a>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                @Html.Action("HeaderAlerts", "AdminDashboard")

                <span class="hidden lg:inline-block text-xs font-bold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-300">@DateTime.Now.ToString("dd/MM/yyyy")</span>

                <!-- Menu tài khoản (dropdown Bootstrap) -->
                @{
                    var adminUserEmail = User.Identity.IsAuthenticated ? User.Identity.Name : "Admin";
                    var adminRoleTitle = User.IsInRole("Administrator") ? "Quản trị viên" : (User.IsInRole("StoreManager") ? "Người bán" : "Nhân viên");
                    var adminInitial = !string.IsNullOrEmpty(adminUserEmail) && adminUserEmail.Length >= 2
                        ? adminUserEmail.Substring(0, 2).ToUpper()
                        : "AD";
                    var menuItem = "dropdown-item flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#d70018]";
                }
                <div class="dropdown border-l-2 border-slate-200 pl-2 sm:pl-3">
                    <button type="button" class="flex items-center gap-2 p-1 pr-2 rounded-xl hover:bg-slate-100 transition-colors" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu tài khoản">
                        <span class="w-8 h-8 rounded-full bg-[#d70018] text-white flex items-center justify-center font-bold text-xs shrink-0">@adminInitial</span>
                        <span class="hidden md:block text-left max-w-[11rem]">
                            <span class="block text-xs font-bold text-slate-800 truncate">@adminUserEmail</span>
                            <span class="block text-[10px] font-semibold text-slate-500">@adminRoleTitle</span>
                        </span>
                        <span class="material-symbols-outlined text-lg text-slate-500" aria-hidden="true">expand_more</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end mt-2 p-1.5 rounded-xl border border-slate-200 shadow-lg" style="min-width: 14rem;">
                        <div class="md:hidden px-3 py-2 border-b border-slate-200 mb-1">
                            <span class="block text-xs font-bold text-slate-800 truncate">@adminUserEmail</span>
                            <span class="block text-[10px] font-semibold text-slate-500">@adminRoleTitle</span>
                        </div>
                        <a class="@menuItem" href="@Url.Action("Profile", "Manage")"><span class="material-symbols-outlined text-lg" aria-hidden="true">person</span>Hồ sơ cá nhân</a>
                        <a class="@menuItem" href="@Url.Action("ChangePassword", "Manage")"><span class="material-symbols-outlined text-lg" aria-hidden="true">lock_reset</span>Đổi mật khẩu</a>
                        <a class="@menuItem" href="@Url.Action("Index", "Home")"><span class="material-symbols-outlined text-lg" aria-hidden="true">storefront</span>Về trang bán hàng</a>
                        <hr class="dropdown-divider my-1">
                        @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "adminLogoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="@menuItem w-full text-[#d70018]"><span class="material-symbols-outlined text-lg" aria-hidden="true">logout</span>Đăng xuất</button>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Dynamic Body Page Content (Nền #e9eff6 tách biệt sắc nét với các Card màu trắng) -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 bg-[#e9eff6] admin-canvas min-w-0 max-w-full">
            @RenderBody()
        </main>

        <!-- Admin Footer -->
        <footer class="bg-white border-t-2 border-slate-300 px-6 py-4 text-xs text-slate-600 flex items-center justify-between">
            <span class="font-medium">&copy; @DateTime.Now.Year TheChillShop Ecommerce • Hệ thống hoạt động ổn định</span>
            <span class="font-semibold text-[#d70018]">Hệ thống phân quyền RBAC • Phiên bản 1.0</span>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById('adminSidebar');
            var mainContent = document.getElementById('adminMainContent');
            var backdrop = document.getElementById('sidebarBackdrop');

            if (window.innerWidth < 1024) {
                // Mobile or high zoom mode: overlay drawer
                if (sidebar.classList.contains('-translate-x-full')) {
                    sidebar.classList.remove('-translate-x-full');
                    backdrop.classList.remove('hidden');
                } else {
                    sidebar.classList.add('-translate-x-full');
                    backdrop.classList.add('hidden');
                }
            } else {
                // Desktop mode: collapse / expand
                if (sidebar.classList.contains('lg:-translate-x-full')) {
                    sidebar.classList.remove('lg:-translate-x-full');
                    mainContent.classList.add('lg:ml-64');
                    mainContent.classList.remove('lg:ml-0', 'lg:w-full');
                    mainContent.classList.add('lg:w-[calc(100%-16rem)]');
                } else {
                    sidebar.classList.add('lg:-translate-x-full');
                    mainContent.classList.remove('lg:ml-64', 'lg:w-[calc(100%-16rem)]');
                    mainContent.classList.add('lg:ml-0', 'lg:w-full');
                }
            }
        }
    </script>
</body>
</html>

