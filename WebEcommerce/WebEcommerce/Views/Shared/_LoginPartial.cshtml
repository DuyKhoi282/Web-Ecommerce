@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "inline" }))
    {
        @Html.AntiForgeryToken()
    }

    var userName = User.Identity.GetUserName() ?? "User";
    var userInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";
    var isAdmin = User.IsInRole("Administrator") || User.IsInRole("StoreManager") || userName.ToLower().Contains("admin");

    <div class="flex items-center gap-3">
        <!-- Direct Quick Access Button for Admin on Header -->
        @if (isAdmin)
        {
            <a href="@Url.Action("Index", "AdminDashboard")" 
               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-purple-100 hover:bg-purple-200 text-purple-800 border border-purple-200 text-xs font-bold transition-all shadow-sm">
                <span class="material-symbols-outlined text-base text-purple-700">admin_panel_settings</span>
                <span>Trang Quản Trị</span>
            </a>
        }

        <!-- User Dropdown Menu -->
        <div class="relative" id="userMenuDropdownContainer">
            <button type="button" id="userMenuBtn" onclick="toggleUserDropdown()" class="flex items-center gap-2.5 px-3 py-1.5 rounded-full hover:bg-slate-100 transition-colors focus:outline-none cursor-pointer">
                <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-[#0d47a1] to-[#00b4d8] text-white flex items-center justify-center font-bold text-sm shadow-sm">
                    @userInitial
                </div>
                <div class="hidden md:flex flex-col text-left">
                    <span class="text-xs font-semibold text-slate-800 leading-tight">@userName</span>
                    <span class="text-[10px] @(isAdmin ? "text-purple-600 font-bold" : "text-slate-500 font-medium")">
                        @(isAdmin ? "Quản trị viên" : "Thành viên")
                    </span>
                </div>
                <span class="material-symbols-outlined text-slate-400 text-lg transition-transform" id="userDropdownArrow">expand_more</span>
            </button>

            <!-- Dropdown Menu Content -->
            <div id="userDropdownMenu" class="absolute right-0 mt-2 w-60 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 hidden z-50">
                <div class="px-4 py-2.5 border-b border-slate-100">
                    <p class="text-[11px] text-slate-400 font-medium">Tài khoản đăng nhập</p>
                    <p class="text-xs font-bold text-[#0d47a1] truncate">@userName</p>
                </div>

                @if (isAdmin)
                {
                    <a href="@Url.Action("Index", "AdminDashboard")" class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-purple-700 hover:bg-purple-50 font-bold transition-colors">
                        <span class="material-symbols-outlined text-lg text-purple-600">admin_panel_settings</span>
                        <span>Trang Quản trị Admin</span>
                    </a>
                    <div class="border-t border-slate-100 my-1"></div>
                }

                <a href="@Url.Action("Profile", "Manage")" class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-[#0d47a1] transition-colors">
                    <span class="material-symbols-outlined text-lg text-slate-400">person</span>
                    <span>Thông tin cá nhân</span>
                </a>

                <a href="@Url.Action("ChangePassword", "Manage")" class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-[#0d47a1] transition-colors">
                    <span class="material-symbols-outlined text-lg text-slate-400">lock_reset</span>
                    <span>Đổi mật khẩu & Bảo mật</span>
                </a>

                <div class="border-t border-slate-100 my-1"></div>

                <button type="button" onclick="document.getElementById('logoutForm').submit();" class="w-full flex items-center gap-2.5 px-4 py-2.5 text-xs text-red-600 hover:bg-red-50 text-left transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-lg text-red-500">logout</span>
                    <span>Đăng xuất</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        function toggleUserDropdown() {
            var menu = document.getElementById('userDropdownMenu');
            var arrow = document.getElementById('userDropdownArrow');
            if (menu) {
                var isHidden = menu.classList.contains('hidden');
                if (isHidden) {
                    menu.classList.remove('hidden');
                    if (arrow) arrow.style.transform = 'rotate(180deg)';
                } else {
                    menu.classList.add('hidden');
                    if (arrow) arrow.style.transform = 'rotate(0deg)';
                }
            }
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
            var container = document.getElementById('userMenuDropdownContainer');
            var menu = document.getElementById('userDropdownMenu');
            var arrow = document.getElementById('userDropdownArrow');
            if (container && menu && !container.contains(e.target)) {
                menu.classList.add('hidden');
                if (arrow) arrow.style.transform = 'rotate(0deg)';
            }
        });
    </script>
}
else
{
    <div class="flex items-center gap-2">
        <a href="@Url.Action("Login", "Account")" class="px-4 py-2 text-sm font-semibold text-[#0d47a1] hover:text-[#0a3880] hover:bg-blue-50 rounded-lg transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-lg">login</span>
            <span>Đăng nhập</span>
        </a>
        <a href="@Url.Action("Register", "Account")" class="px-4 py-2 text-sm font-semibold text-white bg-[#0d47a1] hover:bg-[#0a3880] rounded-lg shadow-sm hover:shadow transition-all flex items-center gap-1.5">
            <span class="material-symbols-outlined text-lg">person_add</span>
            <span>Đăng ký</span>
        </a>
    </div>
}
