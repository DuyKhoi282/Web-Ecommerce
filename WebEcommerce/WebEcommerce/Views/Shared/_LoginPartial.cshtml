@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "inline" }))
    {
        @Html.AntiForgeryToken()
    }

    var userName = User.Identity.GetUserName() ?? "User";
    var userInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";

    <div class="relative group" id="userMenuDropdown">
        <button type="button" class="flex items-center gap-2.5 px-3 py-1.5 rounded-full hover:bg-slate-100 transition-colors focus:outline-none">
            <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-[#0d47a1] to-[#00b4d8] text-white flex items-center justify-center font-bold text-sm shadow-sm">
                @userInitial
            </div>
            <div class="hidden md:flex flex-col text-left">
                <span class="text-xs font-semibold text-slate-800 leading-tight">@userName</span>
                <span class="text-[10px] text-slate-500 font-medium">Thành viên</span>
            </div>
            <span class="material-symbols-outlined text-slate-400 text-lg transition-transform group-hover:rotate-180">expand_more</span>
        </button>

        <!-- Dropdown Menu -->
        <div class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-slate-100 py-2 hidden group-hover:block hover:block z-50 transition-all duration-150">
            <div class="px-4 py-2 border-b border-slate-100">
                <p class="text-xs text-slate-500 font-medium">Đăng nhập với</p>
                <p class="text-sm font-bold text-[#0d47a1] truncate">@userName</p>
            </div>

            @if (User.IsInRole("Administrator") || User.IsInRole("StoreManager"))
            {
                <a href="@Url.Action("Index", "AdminDashboard")" class="flex items-center gap-2.5 px-4 py-2 text-sm text-purple-700 hover:bg-purple-50 font-semibold transition-colors">
                    <span class="material-symbols-outlined text-lg text-purple-600">admin_panel_settings</span>
                    <span>Trang Quản trị Admin</span>
                </a>
                <div class="border-t border-slate-100 my-1"></div>
            }

            <a href="@Url.Action("Profile", "Manage")" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-[#0d47a1] transition-colors">
                <span class="material-symbols-outlined text-lg text-slate-400">person</span>
                <span>Thông tin cá nhân</span>
            </a>

            <a href="@Url.Action("ChangePassword", "Manage")" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-[#0d47a1] transition-colors">
                <span class="material-symbols-outlined text-lg text-slate-400">lock_reset</span>
                <span>Đổi mật khẩu</span>
            </a>

            <div class="border-t border-slate-100 my-1"></div>

            <button type="button" onclick="document.getElementById('logoutForm').submit();" class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-red-600 hover:bg-red-50 text-left transition-colors">
                <span class="material-symbols-outlined text-lg text-red-500">logout</span>
                <span>Đăng xuất</span>
            </button>
        </div>
    </div>
}
else
{
    <div class="flex items-center gap-2">
        <a href="@Url.Action("Login", "Account")" class="px-4 py-2 text-sm font-semibold text-[#0d47a1] hover:text-[#0a3880] hover:bg-blue-50 rounded-lg transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-lg">login</span>
            <span>Đăng nhập</span>
        </a>
        <a href="@Url.Action("Register", "Account")" class="px-4 py-2 text-sm font-semibold text-white bg-[#0d47a1] hover:bg-[#0a3880] rounded-lg shadow-sm hover:shadow transition-all flex items-center gap-1.5">
            <span class="material-symbols-outlined text-lg">person_add</span>
            <span>Đăng ký</span>
        </a>
    </div>
}
