@model WebEcommerce.Models.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            @* Thông báo thành công từ Register / LogOff / ResetPassword *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-1 fw-bold">Đăng nhập</h2>
                    <p class="text-center text-muted mb-4">Chào mừng bạn trở lại!</p>

                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl },
                        FormMethod.Post, new { @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Email, new {
                                @class = "form-control",
                                placeholder = "example@email.com",
                                autocomplete = "email",
                                type = "email"
                            })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.Password, new {
                                @class = "form-control",
                                placeholder = "Nhập mật khẩu",
                                autocomplete = "current-password"
                            })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "rememberMe" })
                                <label class="form-check-label" for="rememberMe">
                                    @Html.DisplayNameFor(m => m.RememberMe)
                                </label>
                            </div>
                            @Html.ActionLink("Quên mật khẩu?", "ForgotPassword", "Account",
                                null, new { @class = "text-decoration-none small" })
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Đăng nhập</button>
                        </div>
                    }

                    <hr class="my-4" />
                    <p class="text-center mb-0">
                        Chưa có tài khoản?
                        @Html.ActionLink("Đăng ký ngay", "Register", "Account",
                            null, new { @class = "text-decoration-none fw-semibold" })
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}