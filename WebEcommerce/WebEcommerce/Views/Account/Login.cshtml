@model WebEcommerce.Models.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html class="h-full" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đăng nhập - TheChillShop | Mua sắm thông minh - Sống chất lượng</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            primary: '#0d47a1',
                            primaryDark: '#0a3880',
                            accent: '#00b4d8',
                            accentHover: '#0096c7',
                            dark: '#1a1a2e',
                            muted: '#5c6370',
                            border: '#e2e8f4',
                            surface: '#f8faff',
                        }
                    },
                    fontFamily: {
                        headline: ["Plus Jakarta Sans", "sans-serif"],
                        body: ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-weight: normal;
            font-style: normal;
            font-size: 20px;
            line-height: 1;
            display: inline-block;
            vertical-align: middle;
        }
        .bg-gradient-chill {
            background: linear-gradient(135deg, #0d47a1 0%, #0077b6 50%, #00b4d8 100%);
        }
        .glass-pill {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.22);
        }
    </style>
</head>
<body class="h-full bg-white font-body text-[#1a1a2e] antialiased selection:bg-[#00b4d8]/20 selection:text-[#0d47a1]">
    <main class="min-h-screen w-full flex flex-col lg:flex-row">
        <!-- LEFT PANEL: 55% Hero & Value Props -->
        <section class="relative w-full lg:w-[55%] bg-gradient-chill text-white flex flex-col justify-between p-8 sm:p-12 lg:p-16 overflow-hidden">
            <!-- Ambient decorative patterns -->
            <div class="pointer-events-none absolute -top-24 -left-24 w-96 h-96 rounded-full bg-white/10 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-32 -right-20 w-[500px] h-[500px] rounded-full bg-[#00b4d8]/25 blur-3xl"></div>

            <!-- Top Header Brand Anchor -->
            <div class="relative z-10 flex items-center justify-between">
                <a href="@Url.Action("Index", "Home")" class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-white/15 backdrop-blur-md border border-white/25 shadow-inner">
                        <span class="material-symbols-outlined text-2xl text-white">shopping_bag</span>
                    </div>
                    <div>
                        <span class="font-headline font-bold text-2xl sm:text-3xl tracking-tight text-white block">TheChill<span class="text-cyan-300">Shop</span></span>
                        <p class="text-xs sm:text-sm text-blue-100 font-medium tracking-wide">Mua sắm thông minh - Sống chất lượng</p>
                    </div>
                </a>
                <a href="@Url.Action("Index", "Home")" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-white/90 hover:text-white bg-white/10 hover:bg-white/20 px-3.5 py-1.5 rounded-full transition-all border border-white/20">
                    <span class="material-symbols-outlined text-base">arrow_back</span>
                    <span>Trang chủ</span>
                </a>
            </div>

            <!-- Middle: Visual Perks & Highlights -->
            <div class="relative z-10 my-8 flex flex-col items-center max-w-xl mx-auto w-full">
                <!-- Floating Graphic Component -->
                <div class="relative w-full max-w-md aspect-[16/10] flex items-center justify-center">
                    <div class="absolute inset-x-4 inset-y-2 rounded-2xl glass-pill shadow-2xl flex flex-col justify-between p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="inline-block w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="text-xs font-semibold tracking-wider uppercase text-blue-100">Flash Sale 50%</span>
                            </div>
                            <span class="glass-pill px-3 py-1 rounded-full text-xs font-semibold text-white">Chính hãng 100%</span>
                        </div>

                        <div class="grid grid-cols-3 gap-3 my-auto pt-2">
                            <div class="p-3 rounded-lg bg-white/10 border border-white/15 flex flex-col items-center text-center">
                                <span class="material-symbols-outlined text-2xl mb-1 text-cyan-200">local_shipping</span>
                                <span class="text-[11px] font-medium text-blue-100">Giao 2H</span>
                            </div>
                            <div class="p-3 rounded-lg bg-white/20 border border-white/30 flex flex-col items-center text-center shadow-lg transform -translate-y-2">
                                <span class="material-symbols-outlined text-3xl mb-1 text-white">verified</span>
                                <span class="text-[11px] font-semibold text-white">Uy tín</span>
                            </div>
                            <div class="p-3 rounded-lg bg-white/10 border border-white/15 flex flex-col items-center text-center">
                                <span class="material-symbols-outlined text-2xl mb-1 text-cyan-200">published_with_changes</span>
                                <span class="text-[11px] font-medium text-blue-100">Đổi trả 15D</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-white/15 text-xs text-blue-100">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm text-amber-300">star</span>
                                <span class="font-medium text-white">4.9/5</span>
                                <span>(380k đánh giá)</span>
                            </div>
                            <span class="text-cyan-200 font-medium">Bảo vệ đơn hàng 100%</span>
                        </div>
                    </div>
                </div>

                <!-- 3 Value Proposition Bullets -->
                <div class="w-full space-y-3 mt-6 max-w-md">
                    <div class="flex items-start gap-3 p-3 rounded-xl bg-white/10 border border-white/10 backdrop-blur-sm">
                        <div class="shrink-0 w-7 h-7 rounded-full bg-cyan-400/20 border border-cyan-300/40 flex items-center justify-center text-cyan-200 text-sm">
                            <span class="material-symbols-outlined text-base">check</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-white leading-snug">Hàng chính hãng 100% - Bảo hành tận tâm</p>
                            <p class="text-xs text-blue-100/90 mt-0.5">Cam kết đền bù 200% nếu phát hiện hàng giả, hàng nhái.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3 rounded-xl bg-white/10 border border-white/10 backdrop-blur-sm">
                        <div class="shrink-0 w-7 h-7 rounded-full bg-cyan-400/20 border border-cyan-300/40 flex items-center justify-center text-cyan-200 text-sm">
                            <span class="material-symbols-outlined text-base">check</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-white leading-snug">Giao hàng siêu tốc trong 2h</p>
                            <p class="text-xs text-blue-100/90 mt-0.5">Mạng lưới vận chuyển đa kênh thông minh, nhanh chóng.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom: Social Proof & Security Badge -->
            <div class="relative z-10 pt-4 flex flex-wrap items-center justify-between gap-4 border-t border-white/15 text-xs text-blue-100">
                <div class="flex items-center gap-2">
                    <span class="font-bold text-white">5M+</span> Khách hàng tin dùng khắp toàn quốc
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-cyan-200 text-sm">verified_user</span>
                    <span>Bảo mật chuẩn SSL 256-bit</span>
                </div>
            </div>
        </section>

        <!-- RIGHT PANEL: 45% Login Form Canvas -->
        <section class="w-full lg:w-[45%] bg-white flex flex-col justify-between p-6 sm:p-10 lg:p-14 min-h-screen overflow-y-auto">
            <!-- Top Helper Bar -->
            <div class="w-full flex items-center justify-between mb-4">
                <a class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-[#0d47a1] transition-colors" href="@Url.Action("Index", "Home")">
                    <span class="material-symbols-outlined text-base">arrow_back</span>
                    <span>Về trang chủ</span>
                </a>
                <a class="inline-flex items-center gap-1 text-xs text-slate-500 hover:text-[#0d47a1] transition-colors" href="@Url.Action("Contact", "Home")">
                    <span class="material-symbols-outlined text-base">help_outline</span>
                    <span>Trợ giúp</span>
                </a>
            </div>

            <!-- Main Form Wrapper -->
            <div class="w-full max-w-md mx-auto my-auto py-4">
                <!-- Brand Mark -->
                <div class="mb-5 flex items-center gap-2.5">
                    <div class="w-10 h-10 rounded-xl bg-[#0d47a1] flex items-center justify-center text-white shadow-md shadow-[#0d47a1]/20">
                        <span class="material-symbols-outlined text-2xl">shopping_bag</span>
                    </div>
                    <span class="font-headline font-bold text-xl text-[#0d47a1] tracking-tight">TheChill<span class="text-[#00b4d8]">Shop</span></span>
                </div>

                <!-- Heading & Subtitle -->
                <div class="mb-5">
                    <h1 class="font-headline font-bold text-3xl text-slate-900 tracking-tight">Đăng nhập</h1>
                    <p class="text-slate-500 text-sm mt-1">Chào mừng bạn trở lại! Tiếp tục tận hưởng mua sắm cùng ưu đãi hấp dẫn.</p>
                </div>

                <!-- Success Alert (from Register/Reset) -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-4 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 p-3.5 text-sm flex items-center gap-2">
                        <span class="material-symbols-outlined text-emerald-600 text-lg shrink-0">check_circle</span>
                        <span class="font-medium text-xs sm:text-sm">@TempData["SuccessMessage"]</span>
                    </div>
                }

                <!-- Validation Summary Errors -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-4 rounded-xl bg-red-50 text-red-800 border border-red-200 p-3.5 text-xs sm:text-sm">
                        @Html.ValidationSummary(false, "", new { @class = "space-y-1 list-disc list-inside font-medium" })
                    </div>
                }

                <!-- Login Form -->
                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "space-y-4" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- Email Field -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5" for="Email">
                            Địa chỉ Email
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <span class="material-symbols-outlined text-lg">mail</span>
                            </div>
                            @Html.TextBoxFor(m => m.Email, new {
                                @class = "block w-full pl-10 pr-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                                placeholder = "example@email.com",
                                autocomplete = "email",
                                type = "email",
                                required = "required"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-600 text-xs mt-1 block" })
                    </div>

                    <!-- Password Field -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5" for="Password">
                            Mật khẩu
                        </label>
                        <div class="relative rounded-xl shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <span class="material-symbols-outlined text-lg">lock</span>
                            </div>
                            @Html.PasswordFor(m => m.Password, new {
                                @class = "block w-full pl-10 pr-11 py-3 text-sm text-slate-900 placeholder:text-slate-400 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                                placeholder = "••••••••",
                                autocomplete = "current-password",
                                required = "required",
                                id = "Password"
                            })
                            <button aria-label="Hiện hoặc ẩn mật khẩu" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none" id="togglePasswordBtn" type="button">
                                <span class="material-symbols-outlined text-lg" id="passwordEyeIcon">visibility</span>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-red-600 text-xs mt-1 block" })
                    </div>

                    <!-- Options Row: Remember Me & Forgot Password -->
                    <div class="flex items-center justify-between pt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "w-4 h-4 rounded border-slate-300 text-[#0d47a1] focus:ring-[#0d47a1]/30 cursor-pointer" })
                            <span class="text-xs sm:text-sm text-slate-600 hover:text-slate-900">Ghi nhớ đăng nhập</span>
                        </label>
                        <a class="text-xs sm:text-sm font-semibold text-[#00b4d8] hover:text-[#0096c7] transition-colors" href="@Url.Action("ForgotPassword", "Account")">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <!-- Submit Button -->
                    <button class="w-full mt-2 bg-[#0d47a1] hover:bg-[#0a3880] text-white font-semibold py-3 px-4 rounded-xl shadow-sm hover:shadow-md transition-all duration-150 flex items-center justify-center gap-2 text-sm" type="submit">
                        <span>Đăng nhập</span>
                        <span class="material-symbols-outlined text-lg">arrow_forward</span>
                    </button>
                }

                <!-- Registration Link prompt -->
                <p class="text-center text-sm text-slate-600 mt-6">
                    Chưa có tài khoản?
                    <a class="text-[#00b4d8] hover:text-[#0096c7] font-semibold hover:underline transition-colors ml-1" href="@Url.Action("Register", "Account")">
                        Đăng ký ngay
                    </a>
                </p>
            </div>

            <!-- Footer: Security Standard Badge -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-2">
                <div class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm text-emerald-600">lock</span>
                    <span>Bảo mật 256-bit SSL tiêu chuẩn</span>
                </div>
                <div class="flex items-center gap-3">
                    <a class="hover:text-slate-600 transition-colors" href="#">Điều khoản</a>
                    <span>•</span>
                    <a class="hover:text-slate-600 transition-colors" href="#">Bảo mật</a>
                </div>
            </div>
        </section>
    </main>

    <!-- Password Toggle Script -->
    <script>
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('Password');
        const eyeIcon = document.getElementById('passwordEyeIcon');

        if (togglePasswordBtn && passwordInput && eyeIcon) {
            togglePasswordBtn.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                if (isPassword) {
                    passwordInput.setAttribute('type', 'text');
                    eyeIcon.textContent = 'visibility_off';
                } else {
                    passwordInput.setAttribute('type', 'password');
                    eyeIcon.textContent = 'visibility';
                }
            });
        }
    </script>
</body>
</html>