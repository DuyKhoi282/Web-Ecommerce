@{
    ViewBag.Title = "Xác thực tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto px-4 py-16 text-center">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm">

        <div class="w-16 h-16 rounded-2xl bg-green-50 text-green-600 flex items-center justify-center mx-auto mb-5">
            <span class="material-symbols-outlined text-3xl">
                mark_email_read
            </span>
        </div>

        <h1 class="text-2xl font-bold text-slate-800 mb-3">
            Xác thực tài khoản
        </h1>

        <p class="text-sm text-slate-500 leading-relaxed">
            @ViewBag.Message
        </p>

        <div class="mt-7 pt-5 border-t border-slate-100">

            <a href="@Url.Action("Login", "Account")"
               class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0d47a1] hover:text-[#00b4d8] transition-colors">

                <span class="material-symbols-outlined text-base">
                    login
                </span>

                <span>
                    Đăng nhập
                </span>

            </a>

        </div>

    </div>
</div>