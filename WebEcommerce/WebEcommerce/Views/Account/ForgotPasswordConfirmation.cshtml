@{
    ViewBag.Title = "Kiểm tra email của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto px-4 py-16 text-center">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm">

        <!-- Email Icon -->
        <div class="w-16 h-16 rounded-2xl bg-blue-50 text-[#0d47a1] flex items-center justify-center mx-auto mb-5">
            <span class="material-symbols-outlined text-3xl">
                mark_email_read
            </span>
        </div>

        <!-- Title -->
        <h1 class="font-headline font-bold text-2xl text-slate-900 tracking-tight mb-3">
            Kiểm tra hộp thư email
        </h1>

        <!-- Description -->
        <p class="text-slate-600 text-sm leading-relaxed">
            Nếu địa chỉ email tồn tại trong hệ thống, chúng tôi đã gửi
            liên kết đặt lại mật khẩu.
        </p>

        <!-- Expiry Notice -->
        <div class="mt-5 rounded-xl bg-blue-50 border border-blue-100 px-4 py-3">
            <div class="flex items-center justify-center gap-2 text-sm text-blue-800">
                <span class="material-symbols-outlined text-base">
                    schedule
                </span>

                <span>
                    Liên kết có hiệu lực trong
                    <strong>24 giờ</strong>
                </span>
            </div>
        </div>

        <!-- Spam Notice -->
        <div class="mt-5">
            <p class="text-xs text-slate-400 leading-relaxed">
                Không nhận được email?
                <br />
                Vui lòng kiểm tra thư mục
                <strong class="text-slate-500">Spam</strong>
                hoặc
                <strong class="text-slate-500">Thư rác</strong>.
            </p>
        </div>

        <!-- Back to Login -->
        <div class="mt-7 pt-5 border-t border-slate-100">
            <a href="@Url.Action("Login", "Account")"
               class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0d47a1] hover:text-[#00b4d8] transition-colors">

                <span class="material-symbols-outlined text-base">
                    arrow_back
                </span>

                <span>Quay lại trang đăng nhập</span>

            </a>
        </div>

    </div>
</div>