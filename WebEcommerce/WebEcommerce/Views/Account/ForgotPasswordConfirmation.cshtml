@{
    ViewBag.Title = "Kiểm tra email của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto px-4 py-16 text-center">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm">
        <div class="w-16 h-16 rounded-2xl bg-blue-50 text-[#0d47a1] flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-3xl">mail</span>
        </div>

        <h1 class="font-headline font-bold text-2xl text-slate-900 tracking-tight mb-2">Kiểm tra hộp thư email</h1>
        <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Nếu địa chỉ email tồn tại trong hệ thống, chúng tôi đã gửi liên kết đặt lại mật khẩu. Liên kết sẽ hết hạn sau <strong class="text-slate-800">24 giờ</strong>.
        </p>
        <p class="text-xs text-slate-400">Không nhận được email? Vui lòng kiểm tra thư mục Spam hoặc gửi lại yêu cầu.</p>

        @if (TempData["ResetLink"] != null)
        {
            <div class="rounded-xl bg-amber-50 border border-amber-200 p-3.5 text-left text-xs text-amber-900 mt-4">
                <strong>🛠️ DEV MODE (Môi trường phát triển):</strong> Link đặt lại mật khẩu trực tiếp:<br />
                <a href="@TempData["ResetLink"]" class="text-[#0d47a1] font-semibold underline break-all mt-1 inline-block">@TempData["ResetLink"]</a>
            </div>
        }

        <div class="mt-6 pt-4 border-t border-slate-100">
            <a href="@Url.Action("Login", "Account")" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0d47a1] hover:text-[#00b4d8] transition-colors">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                <span>Quay lại trang đăng nhập</span>
            </a>
        </div>
    </div>
</div>
