@{
    ViewBag.Title = "Kiểm tra email của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 text-center">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="mb-3" style="font-size:3rem;">📧</div>
                    <h3 class="fw-bold mb-2">Kiểm tra email của bạn</h3>
                    <p class="text-muted">
                        Nếu địa chỉ email tồn tại trong hệ thống, chúng tôi đã gửi link đặt lại mật khẩu.
                        Link sẽ hết hạn sau <strong>24 giờ</strong>.
                    </p>
                    <p class="text-muted small">Không nhận được email? Kiểm tra thư mục Spam hoặc thử lại.</p>

                    @* Dev mode: Hiện link trực tiếp khi chưa có email thật *@
                    @if (TempData["ResetLink"] != null)
                    {
                        <div class="alert alert-warning text-start small mt-3">
                            <strong>🛠️ DEV MODE:</strong> Link reset mật khẩu (không cần email thật):<br />
                            <a href="@TempData["ResetLink"]" class="text-break">@TempData["ResetLink"]</a>
                        </div>
                    }

                    <div class="mt-4">
                        @Html.ActionLink("← Quay lại đăng nhập", "Login", "Account",
                            null, new { @class = "btn btn-outline-secondary" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
