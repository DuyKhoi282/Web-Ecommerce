@model WebEcommerce.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-1 fw-bold">Quên mật khẩu</h2>
                    <p class="text-center text-muted mb-4">
                        Nhập email đăng ký của bạn. Chúng tôi sẽ gửi link đặt lại mật khẩu.
                    </p>

                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Email, new {
                                @class = "form-control",
                                placeholder = "example@email.com",
                                type = "email"
                            })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Gửi link đặt lại mật khẩu</button>
                        </div>
                    }

                    <hr class="my-4" />
                    <p class="text-center mb-0">
                        @Html.ActionLink("← Quay lại đăng nhập", "Login", "Account",
                            null, new { @class = "text-decoration-none" })
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
