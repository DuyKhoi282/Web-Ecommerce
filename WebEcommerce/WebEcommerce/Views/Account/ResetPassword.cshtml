@model WebEcommerce.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#0d47a1] flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-2xl">key</span>
        </div>

        <h1 class="font-headline font-bold text-2xl text-slate-900 text-center tracking-tight">Đặt lại mật khẩu</h1>
        <p class="text-slate-500 text-xs sm:text-sm text-center mt-1.5 mb-6">
            Nhập mật khẩu mới cho tài khoản của bạn để tiếp tục sử dụng.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 rounded-xl bg-red-50 text-red-800 border border-red-200 p-3.5 text-xs">
                @Html.ValidationSummary(false, "", new { @class = "space-y-1 list-disc list-inside font-medium" })
            </div>
        }

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "space-y-4" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Code)

            <!-- Email -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5" for="Email">
                    Địa chỉ Email
                </label>
                <div class="relative rounded-xl shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <span class="material-symbols-outlined text-lg">mail</span>
                    </div>
                    @Html.TextBoxFor(m => m.Email, new {
                        @class = "block w-full pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                        placeholder = "example@email.com",
                        type = "email",
                        required = "required"
                    })
                </div>
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-600 text-xs mt-1 block" })
            </div>

            <!-- New Password -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5" for="Password">
                    Mật khẩu mới
                </label>
                <div class="relative rounded-xl shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <span class="material-symbols-outlined text-lg">lock</span>
                    </div>
                    @Html.PasswordFor(m => m.Password, new {
                        @class = "block w-full pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                        placeholder = "Tối thiểu 6 ký tự",
                        required = "required"
                    })
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-red-600 text-xs mt-1 block" })
            </div>

            <!-- Confirm Password -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5" for="ConfirmPassword">
                    Xác nhận mật khẩu mới
                </label>
                <div class="relative rounded-xl shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <span class="material-symbols-outlined text-lg">lock_reset</span>
                    </div>
                    @Html.PasswordFor(m => m.ConfirmPassword, new {
                        @class = "block w-full pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 rounded-xl border border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 transition-all outline-none",
                        placeholder = "Nhập lại mật khẩu mới",
                        required = "required"
                    })
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-red-600 text-xs mt-1 block" })
            </div>

            <button type="submit" class="w-full mt-2 bg-[#0d47a1] hover:bg-[#0a3880] text-white font-semibold py-3 px-4 rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2 text-sm">
                <span>Đặt lại mật khẩu</span>
                <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
