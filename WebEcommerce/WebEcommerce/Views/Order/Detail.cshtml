@model WebEcommerce.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;

    // Cùng nhãn/màu với Views/Order/Index.cshtml: nhãn, câu mô tả, màu chữ, icon
    var statusInfo = new Dictionary<string, string[]>
    {
        { "Pending", new[] { "Chờ xác nhận", "Đang chờ shop xác nhận đơn", "text-primary-container", "schedule" } },
        { "Confirmed", new[] { "Đã xác nhận", "Shop đang chuẩn bị hàng", "text-primary-container", "task_alt" } },
        { "Processing", new[] { "Đang xử lý", "Đơn hàng đang được đóng gói", "text-primary-container", "inventory_2" } },
        { "Shipped", new[] { "Đang giao", "Đơn hàng đang trên đường đến bạn", "text-primary-container", "local_shipping" } },
        { "Delivered", new[] { "Đã giao", "Giao hàng thành công", "text-emerald-600", "verified" } },
        { "Cancelled", new[] { "Đã hủy", "Đơn hàng đã bị hủy", "text-slate-500", "cancel" } }
    };
    var info = statusInfo.ContainsKey(Model.Status ?? "") ? statusInfo[Model.Status] : new[] { Model.Status, "", "text-slate-500", "help" };

    var steps = new[] { "Pending", "Confirmed", "Processing", "Shipped", "Delivered" };
    var currentStep = Array.IndexOf(steps, Model.Status);

    var isCancelled = Model.Status == "Cancelled";
    var canCancel = Model.Status == "Pending";
    var isPaid = Model.PaymentStatus == "Paid";
    var isAwaitingConfirm = Model.PaymentStatus == "PendingConfirmation";
    var details = Model.OrderDetails?.ToList() ?? new List<WebEcommerce.Models.OrderDetail>();
    var paymentText = Model.PaymentMethod == "BankTransfer" ? "Chuyển khoản VietQR" : (Model.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng (COD)" : Model.PaymentMethod);
}

<div class="max-w-[1280px] mx-auto px-4 py-6 w-full">
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-5" aria-label="Breadcrumb">
        <a href="@Url.Action("Index", "Home")" class="hover:text-primary-container transition-colors">Trang chủ</a>
        <span>/</span>
        <a href="@Url.Action("Profile", "Manage")" class="hover:text-primary-container transition-colors">Tài khoản</a>
        <span>/</span>
        <a href="@Url.Action("Index", "Order")" class="hover:text-primary-container transition-colors">Đơn hàng của tôi</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">#@Model.OrderID</span>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-5 p-4 rounded-xl border border-green-200 bg-green-50 text-green-700 text-sm font-semibold" role="status">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-5 p-4 rounded-xl border border-red-200 bg-red-50 text-red-700 text-sm font-semibold" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <aside class="hidden lg:block lg:col-span-3 space-y-4">
            @Html.Partial("_AccountSidebar", new ViewDataDictionary { { "AccountActive", "orders" } })
        </aside>

        <main class="lg:col-span-9 space-y-4 min-w-0">
            <!-- Header + tiến trình -->
            <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm">
                <div class="px-5 py-4 flex flex-wrap items-center justify-between gap-3 border-b border-slate-100">
                    <div class="min-w-0">
                        <a href="@Url.Action("Index", "Order")" class="inline-flex items-center gap-1 text-xs text-slate-500 hover:text-primary-container transition-colors mb-1">
                            <span class="material-symbols-outlined text-[16px]">arrow_back</span> Đơn hàng của tôi
                        </a>
                        <h1 class="font-headline font-extrabold text-xl sm:text-2xl text-slate-900">Đơn hàng #@Model.OrderID</h1>
                        <p class="text-xs text-slate-500 mt-0.5">Đặt lúc @Model.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="inline-flex items-center gap-1 text-[13px] font-bold uppercase tracking-wide @info[2]">
                            <span class="material-symbols-outlined text-[18px]">@info[3]</span>@info[0]
                        </span>
                        @if (!isCancelled)
                        {
                            <a href="@Url.Action("Invoice", "Export", new { id = Model.OrderID })"
                               class="inline-flex items-center gap-1.5 min-h-[40px] px-4 rounded-lg border border-slate-300 bg-white hover:border-primary-container hover:text-primary-container text-slate-700 font-semibold text-sm transition-colors">
                                <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span> Tải hóa đơn PDF
                            </a>
                        }
                    </div>
                </div>

                @if (isCancelled)
                {
                    <div class="px-5 py-4 flex items-start gap-3 bg-slate-50 rounded-b-2xl">
                        <span class="material-symbols-outlined text-slate-400 text-2xl">cancel</span>
                        <div class="text-sm">
                            <p class="font-bold text-slate-800">Đơn hàng đã bị hủy@(Model.CancelledAt.HasValue ? " lúc " + Model.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "")</p>
                            <p class="text-slate-500 mt-0.5">Tồn kho và mã giảm giá (nếu có) đã được hoàn lại.</p>
                        </div>
                    </div>
                }
                else if (currentStep >= 0)
                {
                    <ol class="px-5 py-6 flex items-start" aria-label="Tiến trình đơn hàng">
                        @for (var i = 0; i < steps.Length; i++)
                        {
                            var stepInfo = statusInfo[steps[i]];
                            var done = i <= currentStep;
                            var isCurrent = i == currentStep;
                            <li class="flex-1 flex flex-col items-center text-center relative min-w-0" @(isCurrent ? "aria-current=step" : "")>
                                @if (i > 0)
                                {
                                    <span class="absolute top-[18px] right-1/2 w-full h-0.5 -translate-y-1/2 @(done ? "bg-primary-container" : "bg-slate-200")" aria-hidden="true"></span>
                                }
                                <span class="relative z-10 w-9 h-9 rounded-full flex items-center justify-center border-2 @(done ? "bg-primary-container border-primary-container text-white" : "bg-white border-slate-200 text-slate-400") @(isCurrent ? "ring-4 ring-primary-container/15" : "")">
                                    <span class="material-symbols-outlined text-[18px]">@stepInfo[3]</span>
                                </span>
                                <span class="mt-2 px-0.5 text-[11px] sm:text-xs leading-tight @(isCurrent ? "font-bold text-primary-container" : (done ? "font-semibold text-slate-800" : "text-slate-400"))">@stepInfo[0]</span>
                            </li>
                        }
                    </ol>
                    <p class="px-5 pb-4 -mt-2 text-xs text-slate-500 text-center">@info[1]</p>
                }
            </section>

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 items-start">
                <!-- Cột trái: sản phẩm, tổng tiền, hủy/hỗ trợ -->
                <div class="xl:col-span-2 space-y-4 min-w-0">
                    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm">
                        <h2 class="px-5 pt-4 pb-1 font-headline font-bold text-base text-slate-900">Sản phẩm đã đặt (@details.Sum(d => d.Quantity))</h2>
                        <div class="px-5 divide-y divide-slate-100">
                            @foreach (var detail in details)
                            {
                                var product = detail.Product;
                                var img = product?.ProductImages?.FirstOrDefault(x => x.IsMain) ?? product?.ProductImages?.FirstOrDefault();
                                <div class="flex items-center gap-4 py-3.5">
                                    <a href="@Url.Action("Details", "Shop", new { id = detail.ProductID })" class="w-20 h-20 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 overflow-hidden">
                                        @if (img != null)
                                        {
                                            <img src="@img.ImageURL" alt="@product?.Name" loading="lazy" class="w-full h-full object-contain p-1.5" onerror="this.onerror=null;this.src='https://placehold.co/80x80/fef2f2/d70018?text=SP';" />
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined text-3xl text-slate-300">image</span>
                                        }
                                    </a>
                                    <div class="flex-1 min-w-0">
                                        <a href="@Url.Action("Details", "Shop", new { id = detail.ProductID })" class="text-sm text-slate-900 line-clamp-2 hover:text-primary-container transition-colors">@(product?.Name ?? "Sản phẩm")</a>
                                        <p class="text-xs text-slate-500 mt-1">@string.Format("{0:N0}đ", detail.UnitPrice) × @(detail.Quantity)</p>
                                    </div>
                                    <span class="text-sm font-semibold text-slate-900 whitespace-nowrap">@string.Format("{0:N0}đ", detail.Subtotal)</span>
                                </div>
                            }
                        </div>

                        <dl class="px-5 py-4 border-t border-slate-100 bg-gradient-to-b from-white to-red-50/40 rounded-b-2xl space-y-2 text-sm">
                            <div class="flex justify-between">
                                <dt class="text-slate-500">Tạm tính</dt>
                                <dd class="text-slate-800">@string.Format("{0:N0}đ", Model.TotalAmount)</dd>
                            </div>
                            @if (Model.DiscountAmount > 0)
                            {
                                <div class="flex justify-between">
                                    <dt class="text-slate-500">Giảm giá@(Model.PromotionalCode != null ? " (" + Model.PromotionalCode.Code + ")" : "")</dt>
                                    <dd class="text-emerald-600 font-semibold">-@string.Format("{0:N0}đ", Model.DiscountAmount)</dd>
                                </div>
                            }
                            <div class="flex justify-between">
                                <dt class="text-slate-500">Phí vận chuyển</dt>
                                <dd class="text-slate-800">Miễn phí</dd>
                            </div>
                            <div class="flex items-baseline justify-between pt-2 border-t border-slate-200/70">
                                <dt class="font-semibold text-slate-900">Thành tiền</dt>
                                <dd class="font-headline font-extrabold text-xl text-primary-container">@string.Format("{0:N0}đ", Model.FinalAmount)</dd>
                            </div>
                        </dl>
                    </section>

                    @if (canCancel)
                    {
                        using (Html.BeginForm("Cancel", "Order", new { id = Model.OrderID }, FormMethod.Post, new { id = "cancel-order-box" }))
                        {
                            @Html.AntiForgeryToken()
                            <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5">
                                <h2 class="font-headline font-bold text-base text-slate-900">Hủy đơn hàng</h2>
                                <p class="text-xs text-slate-500 mt-1 mb-4 leading-relaxed">Đơn đang chờ shop xác nhận nên bạn có thể tự hủy. Tồn kho và mã giảm giá sẽ được hoàn lại tự động.</p>

                                <p class="text-xs font-semibold text-slate-500 mb-2" id="cancel-reason-chips-label">Lý do thường gặp:</p>
                                <div class="flex flex-wrap gap-2 mb-3" role="group" aria-labelledby="cancel-reason-chips-label">
                                    @foreach (var reason in new[] { "Tôi muốn thay đổi địa chỉ nhận hàng", "Tôi muốn đổi sản phẩm hoặc số lượng", "Tìm thấy giá tốt hơn ở nơi khác", "Không còn nhu cầu mua nữa" })
                                    {
                                        <button type="button" data-reason="@reason" onclick="setCancelReason(this.getAttribute('data-reason'));"
                                                class="min-h-[32px] px-3 rounded-full border border-slate-200 bg-white hover:border-primary-container hover:text-primary-container text-xs text-slate-700 transition-colors">
                                            @reason
                                        </button>
                                    }
                                </div>

                                <label for="cancellationReason" class="block text-xs font-bold text-slate-700 mb-1.5">
                                    Lý do hủy đơn <span class="text-primary-container">*</span>
                                </label>
                                <textarea id="cancellationReason" name="cancellationReason" rows="3" maxlength="1000" required
                                          placeholder="Ví dụ: Tôi đặt nhầm sản phẩm hoặc muốn đổi địa chỉ..."
                                          class="w-full rounded-lg border border-slate-300 p-3 text-sm text-slate-800 focus:outline-none focus:border-primary-container focus:ring-2 focus:ring-primary-container/15 resize-y transition-colors"></textarea>
                                <p class="text-[11px] text-slate-400 mt-1 mb-4">Tối đa 1.000 ký tự.</p>

                                <button type="submit"
                                        onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này? Thao tác này không thể hoàn tác.');"
                                        class="w-full sm:w-auto min-h-[44px] px-6 rounded-lg border border-slate-300 bg-white hover:border-red-300 hover:bg-red-50 hover:text-red-600 text-slate-700 font-semibold text-sm inline-flex items-center justify-center gap-2 transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                                    Xác nhận hủy đơn
                                </button>
                            </section>
                        }
                    }
                    else if (Model.Status == "Confirmed" || Model.Status == "Processing" || Model.Status == "Shipped")
                    {
                        <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 flex flex-col sm:flex-row sm:items-center gap-4">
                            <span class="w-10 h-10 rounded-xl bg-primary-fixed text-primary-container flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined">support_agent</span>
                            </span>
                            <div class="flex-1 min-w-0 text-sm">
                                <p class="font-bold text-slate-900">Cần hủy hoặc thay đổi đơn?</p>
                                <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">Đơn đã được shop xác nhận nên không thể tự hủy. Gọi tổng đài để nhân viên hỗ trợ.</p>
                            </div>
                            <a href="tel:18002097" class="shrink-0 min-h-[44px] px-5 rounded-lg bg-primary-container hover:bg-brand-red-vibrant text-white font-semibold text-sm inline-flex items-center justify-center gap-1.5 transition-colors">
                                <span class="material-symbols-outlined text-[18px]">call</span> 1800.2097
                            </a>
                        </section>
                    }
                    else if (isCancelled)
                    {
                        <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5">
                            <h2 class="font-headline font-bold text-base text-slate-900 mb-3">Thông tin hủy đơn</h2>
                            <dl class="space-y-3 text-sm">
                                <div class="flex flex-col sm:flex-row sm:justify-between gap-0.5 sm:gap-4">
                                    <dt class="text-slate-500 shrink-0">Người hủy</dt>
                                    <dd class="font-semibold text-slate-800 sm:text-right">@(Model.CancelledBy == "Customer" ? "Bạn đã hủy đơn" : (Model.CancelledBy == "Manager" ? "Shop đã hủy đơn" : (Model.CancelledBy ?? "Hệ thống")))</dd>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.CancellationReason))
                                {
                                    <div class="flex flex-col sm:flex-row sm:justify-between gap-0.5 sm:gap-4">
                                        <dt class="text-slate-500 shrink-0">Lý do</dt>
                                        <dd class="text-slate-800 sm:text-right leading-relaxed break-words">@Model.CancellationReason</dd>
                                    </div>
                                }
                            </dl>
                        </section>
                    }
                </div>

                <!-- Cột phải: thanh toán, giao hàng, đánh giá -->
                <div class="space-y-4 min-w-0">
                    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5">
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <h2 class="font-headline font-bold text-base text-slate-900">Thanh toán</h2>
                            @if (isPaid)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>Đã thanh toán
                                </span>
                            }
                            else if (!isCancelled)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>@(isAwaitingConfirm ? "Chờ xác nhận" : "Chưa thanh toán")
                                </span>
                            }
                        </div>
                        <p class="text-sm text-slate-800">@paymentText</p>

                        @if (isPaid)
                        {
                            if (Model.PaymentDate.HasValue)
                            {
                                <p class="text-xs text-slate-500 mt-1">Lúc @Model.PaymentDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                            }
                        }
                        else if (!isCancelled && isAwaitingConfirm)
                        {
                            <p class="text-xs text-slate-500 mt-1 leading-relaxed">Shop đang đối soát giao dịch chuyển khoản của bạn và sẽ cập nhật sớm.</p>
                        }
                        else if (!isCancelled && Model.PaymentMethod == "BankTransfer")
                        {
                            <p class="text-xs text-slate-500 mt-1 mb-3 leading-relaxed">Mở ứng dụng ngân hàng bất kỳ và quét mã để chuyển khoản đúng số tiền, nội dung.</p>
                            <div class="p-3 rounded-xl border border-slate-200 flex justify-center mb-3">
                                <img src="https://img.vietqr.io/image/VCB-1029384756-compact2.png?amount=@((long)Model.FinalAmount)&addInfo=DH%20@Model.OrderID&accountName=THE%20CHILL%20SHOP"
                                     alt="Mã VietQR chuyển khoản đơn hàng #@Model.OrderID"
                                     class="max-w-[200px] w-full h-auto object-contain"
                                     onerror="this.onerror=null;this.src='https://placehold.co/200x200/fef2f2/d70018?text=VietQR+DH+@Model.OrderID';" />
                            </div>
                            <dl class="space-y-2 text-xs mb-3">
                                <div class="flex justify-between items-center gap-2">
                                    <dt class="text-slate-500">Ngân hàng</dt>
                                    <dd class="font-semibold text-slate-800">Vietcombank (VCB)</dd>
                                </div>
                                <div class="flex justify-between items-center gap-2">
                                    <dt class="text-slate-500">Số tài khoản</dt>
                                    <dd class="flex items-center gap-1">
                                        <span class="font-mono font-semibold text-slate-800">1029384756</span>
                                        <button type="button" onclick="navigator.clipboard.writeText('1029384756'); if(window.showToast) showToast({type:'success', title:'Đã sao chép', message:'Đã chép số tài khoản vào clipboard.'});" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-primary-container hover:bg-slate-50 transition-colors" aria-label="Sao chép số tài khoản">
                                            <span class="material-symbols-outlined text-[16px]">content_copy</span>
                                        </button>
                                    </dd>
                                </div>
                                <div class="flex justify-between items-center gap-2">
                                    <dt class="text-slate-500">Nội dung</dt>
                                    <dd class="flex items-center gap-1">
                                        <span class="font-mono font-bold text-primary-container">DH @Model.OrderID</span>
                                        <button type="button" onclick="navigator.clipboard.writeText('DH @Model.OrderID'); if(window.showToast) showToast({type:'success', title:'Đã sao chép', message:'Đã chép nội dung chuyển khoản.'});" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-primary-container hover:bg-slate-50 transition-colors" aria-label="Sao chép nội dung chuyển khoản">
                                            <span class="material-symbols-outlined text-[16px]">content_copy</span>
                                        </button>
                                    </dd>
                                </div>
                                <div class="flex justify-between items-center gap-2">
                                    <dt class="text-slate-500">Số tiền</dt>
                                    <dd class="font-bold text-slate-900">@string.Format("{0:N0}đ", Model.FinalAmount)</dd>
                                </div>
                            </dl>

                            <div id="transfer-notif-box" class="hidden mb-3 p-3 rounded-lg bg-amber-50 border border-amber-200 text-xs" role="status">
                                <p class="font-semibold text-amber-800 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">hourglass_top</span> Đã ghi nhận yêu cầu
                                </p>
                                <p class="text-amber-700 mt-1 leading-relaxed">Shop đang đối soát giao dịch đơn #@Model.OrderID và sẽ cập nhật trong 5-15 phút.</p>
                            </div>
                            <div class="flex flex-col gap-2">
                                <button type="button" id="btn-confirm-transferred"
                                        onclick="document.getElementById('transfer-notif-box').classList.remove('hidden'); this.classList.add('hidden'); if(window.showToast) showToast({type:'info', title:'Đã ghi nhận chuyển khoản', message:'Shop đang kiểm tra giao dịch đơn hàng #@Model.OrderID. Vui lòng đợi trong giây lát!'});"
                                        class="w-full min-h-[44px] rounded-lg bg-primary-container hover:bg-brand-red-vibrant text-white font-semibold text-sm inline-flex items-center justify-center gap-1.5 transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">task_alt</span> Tôi đã chuyển khoản
                                </button>
                                <button type="button" onclick="window.location.reload();"
                                        class="w-full min-h-[40px] rounded-lg border border-slate-300 bg-white hover:border-primary-container hover:text-primary-container text-slate-700 font-medium text-xs inline-flex items-center justify-center gap-1.5 transition-colors">
                                    <span class="material-symbols-outlined text-[16px]">refresh</span> Kiểm tra lại trạng thái
                                </button>
                            </div>
                        }
                        else if (!isCancelled && Model.PaymentMethod == "COD")
                        {
                            <div class="mt-3 p-3 rounded-lg bg-badge-discount-bg flex items-center justify-between gap-2 text-xs">
                                <span class="text-slate-600">@(Model.Status == "Shipped" ? "Chuẩn bị tiền mặt khi nhận" : "Trả tiền mặt khi nhận hàng")</span>
                                <span class="font-headline font-extrabold text-sm text-primary-container whitespace-nowrap">@string.Format("{0:N0}đ", Model.FinalAmount)</span>
                            </div>
                        }
                    </section>

                    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5">
                        <h2 class="font-headline font-bold text-base text-slate-900 mb-3">Giao tới</h2>
                        <div class="space-y-2.5 text-sm">
                            <p class="flex items-start gap-2 text-slate-800">
                                <span class="material-symbols-outlined text-[18px] text-slate-400 shrink-0">location_on</span>
                                <span class="break-words min-w-0">@Model.ShippingAddress</span>
                            </p>
                            <p class="flex items-center gap-2 text-slate-800">
                                <span class="material-symbols-outlined text-[18px] text-slate-400 shrink-0">call</span>
                                <span>@Model.ReceiverPhone</span>
                            </p>
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <p class="flex items-start gap-2 text-slate-600">
                                    <span class="material-symbols-outlined text-[18px] text-slate-400 shrink-0">sticky_note_2</span>
                                    <span class="break-words min-w-0">@Model.Notes</span>
                                </p>
                            }
                        </div>
                    </section>

                    @if (Model.Status == "Delivered")
                    {
                        var hasReview = ViewBag.HasOrderReview == true;
                        <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5">
                            <div class="flex items-center gap-1 text-gold-star mb-2" aria-hidden="true">
                                @for (var s = 0; s < 5; s++)
                                {
                                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings:'FILL' 1">star</span>
                                }
                            </div>
                            <h2 class="font-headline font-bold text-base text-slate-900">@(hasReview ? "Cảm ơn bạn đã đánh giá" : "Bạn hài lòng với đơn hàng?")</h2>
                            <p class="text-xs text-slate-500 mt-1 mb-4 leading-relaxed">Chia sẻ trải nghiệm về từng sản phẩm để giúp TheChillShop phục vụ tốt hơn.</p>
                            <a href="@Url.Action("CreateOrderReview", "Review", new { orderId = Model.OrderID })"
                               class="w-full min-h-[44px] rounded-lg font-semibold text-sm inline-flex items-center justify-center gap-1.5 transition-colors @(hasReview ? "border border-slate-300 bg-white hover:border-primary-container hover:text-primary-container text-slate-700" : "bg-primary-container hover:bg-brand-red-vibrant text-white")">
                                <span class="material-symbols-outlined text-[18px]">rate_review</span>
                                @(hasReview ? "Chỉnh sửa đánh giá" : "Đánh giá đơn hàng")
                            </a>
                        </section>
                    }
                </div>
            </div>
        </main>
    </div>
</div>

@section scripts {
<script>
    function setCancelReason(reason) {
        var el = document.getElementById('cancellationReason');
        if (el) {
            el.value = reason;
            el.focus();
        }
    }
</script>
}
