@model WebEcommerce.Models.CheckoutViewModel
@{
    ViewBag.Title = "Thanh toán";
    var cart = ViewBag.Cart as WebEcommerce.Models.Cart;
    var cartTotal = (decimal)(ViewBag.CartTotal ?? 0m);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <span class="material-symbols-outlined text-3xl text-[#0d47a1]">payments</span>
            <h1 class="font-headline font-extrabold text-3xl text-[#1a1a2e]">Thanh toán</h1>
        </div>
        <p class="text-sm text-slate-500">Kiểm tra thông tin và hoàn tất đơn hàng.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl border border-red-200 bg-red-50 text-red-700 text-sm font-semibold">
            @TempData["ErrorMessage"]
        </div>
    }

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "grid grid-cols-1 lg:grid-cols-3 gap-6" }))
    {
        @Html.AntiForgeryToken()

        <!-- Left: Form -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Shipping Info -->
            <div class="bg-white border-2 border-slate-200 rounded-2xl p-6 shadow-sm">
                <h2 class="font-headline font-bold text-lg text-slate-900 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#0d47a1]">location_on</span>
                    Thông tin giao hàng
                </h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Địa chỉ giao hàng *</label>
                        @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "w-full px-4 py-3 rounded-xl border-2 border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 outline-none text-sm", placeholder = "Nhập địa chỉ giao hàng đầy đủ" })
                        @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Số điện thoại người nhận *</label>
                        @Html.TextBoxFor(m => m.ReceiverPhone, new { @class = "w-full px-4 py-3 rounded-xl border-2 border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 outline-none text-sm", placeholder = "0901234567" })
                        @Html.ValidationMessageFor(m => m.ReceiverPhone, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Ghi chú</label>
                        @Html.TextAreaFor(m => m.Notes, new { @class = "w-full px-4 py-3 rounded-xl border-2 border-slate-300 focus:border-[#0d47a1] focus:ring-2 focus:ring-[#0d47a1]/20 outline-none text-sm", rows = 3, placeholder = "Ghi chú cho đơn hàng (không bắt buộc)" })
                    </div>
                </div>
            </div>

            <!-- Payment Method -->
            <div class="bg-white border-2 border-slate-200 rounded-2xl p-6 shadow-sm">
                <h2 class="font-headline font-bold text-lg text-slate-900 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#0d47a1]">credit_card</span>
                    Phương thức thanh toán
                </h2>
                <div class="space-y-3">
                    <label class="flex items-center gap-3 p-4 rounded-xl border-2 border-slate-200 hover:border-[#0d47a1] cursor-pointer transition-colors">
                        <input type="radio" name="PaymentMethod" value="COD" checked="@(Model.PaymentMethod == "COD" ? "checked" : null)" class="w-4 h-4 text-[#0d47a1]" />
                        <div>
                            <span class="font-bold text-sm text-slate-900">Thanh toán khi nhận hàng (COD)</span>
                            <p class="text-xs text-slate-500 mt-0.5">Thanh toán bằng tiền mặt khi nhận hàng</p>
                        </div>
                    </label>
                    <label class="flex items-center gap-3 p-4 rounded-xl border-2 border-slate-200 hover:border-[#0d47a1] cursor-pointer transition-colors">
                        <input type="radio" name="PaymentMethod" value="BankTransfer" checked="@(Model.PaymentMethod == "BankTransfer" ? "checked" : null)" class="w-4 h-4 text-[#0d47a1]" />
                        <div>
                            <span class="font-bold text-sm text-slate-900">Chuyển khoản ngân hàng</span>
                            <p class="text-xs text-slate-500 mt-0.5">Chuyển khoản qua tài khoản ngân hàng</p>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Promo Code -->
            <div class="bg-white border-2 border-slate-200 rounded-2xl p-6 shadow-sm">
                <h2 class="font-headline font-bold text-lg text-slate-900 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#0d47a1]">confirmation_number</span>
                    Mã giảm giá
                </h2>
                <div class="flex gap-2">
                    @Html.TextBoxFor(m => m.PromoCode, new { @class = "flex-1 px-4 py-3 rounded-xl border-2 border-slate-300 focus:border-[#0d47a1] outline-none text-sm uppercase", placeholder = "Nhập mã giảm giá", id = "promo-code-input" })
                    <button type="button" id="btn-apply-promo" class="px-6 py-3 rounded-xl bg-[#0d47a1] hover:bg-[#0a3880] text-white font-bold text-sm transition-colors">Áp dụng</button>
                </div>
                <div id="promo-message" class="mt-2 text-sm hidden"></div>
            </div>
        </div>

        <!-- Right: Summary -->
        <div class="lg:col-span-1">
            <div class="bg-white border-2 border-slate-200 rounded-2xl p-6 shadow-sm lg:sticky lg:top-28">
                <h2 class="font-headline font-extrabold text-lg text-slate-900 mb-5">Tóm tắt đơn hàng</h2>

                @if (cart != null && cart.CartItems != null)
                {
                    <div class="space-y-3 mb-4 max-h-60 overflow-y-auto">
                        @foreach (var item in cart.CartItems)
                        {
                            <div class="flex items-center gap-3 text-sm">
                                <span class="text-slate-500">x@(item.Quantity)</span>
                                <span class="flex-1 text-slate-900 font-medium truncate">@item.Product?.Name</span>
                                <span class="font-bold text-slate-900">@string.Format("{0:N0}đ", item.UnitPriceAtAddition * item.Quantity)</span>
                            </div>
                        }
                    </div>
                }

                <div class="border-t border-slate-200 pt-4 space-y-3 text-sm">
                    <div class="flex justify-between text-slate-600">
                        <span>Tạm tính</span>
                        <span id="checkout-subtotal" class="font-bold">@string.Format("{0:N0}đ", cartTotal)</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Giảm giá</span>
                        <span id="checkout-discount" class="font-bold text-green-600">0đ</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Phí vận chuyển</span>
                        <span class="font-bold">Miễn phí</span>
                    </div>
                </div>

                <div class="border-t border-slate-200 mt-4 pt-4">
                    <div class="flex justify-between items-center">
                        <span class="font-headline font-bold text-slate-900">Tổng cộng</span>
                        <span id="checkout-total" class="font-headline font-extrabold text-xl text-[#0d47a1]">@string.Format("{0:N0}đ", cartTotal)</span>
                    </div>
                </div>

                <button type="submit" class="mt-6 w-full py-3.5 rounded-xl bg-[#0d47a1] hover:bg-[#0a3880] text-white font-bold text-sm flex items-center justify-center gap-2 transition-colors">
                    <span class="material-symbols-outlined text-lg">lock</span>
                    Đặt hàng
                </button>

                <a href="@Url.Action("Index", "Cart")" class="mt-3 w-full py-3 rounded-xl border-2 border-slate-200 hover:border-[#0d47a1] text-slate-600 hover:text-[#0d47a1] font-bold text-sm flex items-center justify-center gap-2 transition-colors">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Quay lại giỏ hàng
                </a>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var cartTotal = @((int)cartTotal);

            $("#btn-apply-promo").on("click", function () {
                var code = $("#promo-code-input").val();
                if (!code) { alert("Vui lòng nhập mã giảm giá."); return; }
                var token = $('input[name="__RequestVerificationToken"]').first().val();
                $.ajax({
                    url: "/Order/ApplyPromoCode",
                    type: "POST",
                    data: { code: code, cartTotal: cartTotal, __RequestVerificationToken: token },
                    success: function (r) {
                        var msg = $("#promo-message");
                        msg.removeClass("hidden text-green-600 text-red-600");
                        if (r.success) {
                            msg.addClass("text-green-600").text(r.message);
                            $("#checkout-discount").text("-" + parseInt(r.discount).toLocaleString("vi-VN") + "đ");
                            $("#checkout-total").text(parseInt(r.finalAmount).toLocaleString("vi-VN") + "đ");
                        } else {
                            msg.addClass("text-red-600").text(r.message);
                        }
                    },
                    error: function () { alert("Lỗi khi áp dụng mã."); }
                });
            });
        });
    </script>
}
