@model WebEcommerce.Models.CheckoutViewModel

@{
    ViewBag.Title = "Thanh toán";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <span class="material-symbols-outlined text-3xl text-[#0d47a1]">
                local_shipping
            </span>
            <h1 class="font-headline font-extrabold text-3xl text-[#1a1a2e]">
                Thanh toán đơn hàng
            </h1>
        </div>
        <p class="text-sm text-slate-500">
            Vui lòng điền đầy đủ thông tin giao hàng để hoàn tất.
        </p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-6 p-4 rounded-xl border border-red-200 bg-red-50 text-red-700 text-sm font-semibold">
            @Html.ValidationSummary(true, "", new { @class = "text-red-700" })
        </div>
    }

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "grid grid-cols-1 lg:grid-cols-2 gap-8" }))
    {
        @Html.AntiForgeryToken()

        <!-- Thông tin thanh toán -->
        <div class="space-y-6">
            <div class="bg-white border-2 border-slate-200 rounded-2xl p-6 shadow-sm">
                <h2 class="font-headline font-bold text-lg text-slate-900 mb-5 border-b pb-3">
                    Thông tin giao hàng
                </h2>

                <div class="space-y-4">
                    <div>
                        @Html.LabelFor(m => m.ReceiverPhone, new { @class = "block text-sm font-bold text-slate-700 mb-1" })
                        @Html.TextBoxFor(m => m.ReceiverPhone, new { @class = "w-full p-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0d47a1] focus:border-[#0d47a1] outline-none", placeholder = "Nhập số điện thoại" })
                        @Html.ValidationMessageFor(m => m.ReceiverPhone, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>

                    <div>
                        @Html.LabelFor(m => m.ShippingAddress, new { @class = "block text-sm font-bold text-slate-700 mb-1" })
                        @Html.TextAreaFor(m => m.ShippingAddress, new { @class = "w-full p-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0d47a1] focus:border-[#0d47a1] outline-none", rows = 3, placeholder = "Nhập địa chỉ nhận hàng chi tiết" })
                        @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>

                    <div>
                        @Html.LabelFor(m => m.PaymentMethod, new { @class = "block text-sm font-bold text-slate-700 mb-1" })
                        <div class="grid grid-cols-2 gap-4">
                            <label class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-slate-50 @(Model.PaymentMethod == "COD" ? "border-[#0d47a1] bg-blue-50" : "border-slate-300")">
                                @Html.RadioButtonFor(m => m.PaymentMethod, "COD", new { @class = "w-4 h-4 text-[#0d47a1]" })
                                <span class="font-semibold text-sm">Thanh toán khi nhận hàng (COD)</span>
                            </label>
                            <label class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-slate-50 @(Model.PaymentMethod == "Bank Transfer" ? "border-[#0d47a1] bg-blue-50" : "border-slate-300")">
                                @Html.RadioButtonFor(m => m.PaymentMethod, "Bank Transfer", new { @class = "w-4 h-4 text-[#0d47a1]" })
                                <span class="font-semibold text-sm">Chuyển khoản ngân hàng</span>
                            </label>
                        </div>
                        @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>

                    <div>
                        @Html.LabelFor(m => m.Notes, new { @class = "block text-sm font-bold text-slate-700 mb-1" })
                        @Html.TextAreaFor(m => m.Notes, new { @class = "w-full p-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0d47a1] focus:border-[#0d47a1] outline-none", rows = 2, placeholder = "Ghi chú thêm (không bắt buộc)" })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Tóm tắt đơn hàng -->
        <div>
            <div class="bg-slate-50 border-2 border-slate-200 rounded-2xl p-6 shadow-sm sticky top-28">
                <h2 class="font-headline font-bold text-lg text-slate-900 mb-5 border-b border-slate-200 pb-3">
                    Đơn hàng của bạn
                </h2>

                <div class="space-y-4 max-h-96 overflow-y-auto mb-5 pr-2">
                    @foreach (var item in Model.Cart.CartItems)
                    {
                        var product = item.Product;
                        var img = product.ProductImages?.FirstOrDefault(x => x.IsMain)?.ImageURL ?? product.ProductImages?.FirstOrDefault()?.ImageURL ?? "https://placehold.co/100x100/f8faff/0d47a1?text=IMG";

                        <div class="flex gap-4 items-center">
                            <div class="w-16 h-16 rounded-lg bg-white border flex-shrink-0 p-1">
                                <img src="@img" class="w-full h-full object-contain" />
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-sm font-bold text-slate-900 truncate">@product.Name</h3>
                                <p class="text-xs text-slate-500">Số lượng: @item.Quantity</p>
                            </div>
                            <div class="text-sm font-bold text-[#0d47a1]">
                                @string.Format("{0:N0}đ", item.UnitPriceAtAddition * item.Quantity)
                            </div>
                        </div>
                    }
                </div>

                @{
                    var total = Model.Cart.CartItems.Sum(x => x.UnitPriceAtAddition * x.Quantity);
                }

                <div class="mt-4 pt-4 border-t border-slate-200">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Mã giảm giá</label>
                    <div class="flex gap-2">
                        @Html.TextBoxFor(m => m.PromoCode, new { @id = "promoCodeInput", @class = "flex-1 p-3 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#0d47a1] focus:border-[#0d47a1] outline-none uppercase", placeholder = "Nhập mã..." })
                        <button type="button" id="btnApplyPromo" class="px-4 py-3 bg-slate-800 hover:bg-slate-900 text-white text-sm font-bold rounded-lg transition-colors whitespace-nowrap">
                            Áp dụng
                        </button>
                    </div>
                    <p id="promoMessage" class="text-xs font-semibold mt-2 hidden"></p>
                </div>

                <div class="space-y-3 text-sm border-t border-slate-200 pt-4 mt-4">
                    <div class="flex justify-between text-slate-600">
                        <span>Tạm tính</span>
                        <span class="font-bold">@string.Format("{0:N0}đ", total)</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Phí vận chuyển</span>
                        <span class="font-bold text-green-600">Miễn phí</span>
                    </div>
                    <div id="discountRow" class="flex justify-between text-red-600 hidden">
                        <span>Giảm giá</span>
                        <span id="discountAmount" class="font-bold">-0đ</span>
                    </div>
                </div>

                <div class="flex justify-between items-center mt-5 pt-5 border-t border-slate-300">
                    <span class="font-bold text-base text-slate-900">Tổng thanh toán</span>
                    <span id="finalTotal" class="font-extrabold text-2xl text-[#0d47a1]" data-original="@total">@string.Format("{0:N0}đ", total)</span>
                </div>

                <button type="submit" class="w-full mt-6 py-4 rounded-xl bg-[#0d47a1] hover:bg-[#0a3880] text-white font-bold text-base flex items-center justify-center gap-2 transition-colors">
                    <span class="material-symbols-outlined">check_circle</span>
                    Xác nhận đặt hàng
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Radio button border toggle
            $('input[type="radio"]').change(function() {
                $('input[type="radio"]').parent().removeClass('border-[#0d47a1] bg-blue-50').addClass('border-slate-300');
                $(this).parent().removeClass('border-slate-300').addClass('border-[#0d47a1] bg-blue-50');
            });

            // Format Currency
            function formatCurrency(amount) {
                return new Intl.NumberFormat('vi-VN').format(amount) + 'đ';
            }

            // Apply Promo Code
            $('#btnApplyPromo').click(function() {
                var code = $('#promoCodeInput').val().trim();
                var msgBox = $('#promoMessage');
                
                if (!code) {
                    msgBox.text('Vui lòng nhập mã giảm giá.').removeClass('text-green-600 hidden').addClass('text-red-600');
                    return;
                }

                var token = $('input[name="__RequestVerificationToken"]').val();
                var btn = $(this);
                
                btn.prop('disabled', true).text('...');
                
                $.ajax({
                    url: '@Url.Action("ApplyPromoCode", "Order")',
                    type: 'POST',
                    data: {
                        code: code,
                        __RequestVerificationToken: token
                    },
                    success: function(res) {
                        btn.prop('disabled', false).text('Áp dụng');
                        
                        if (res.success) {
                            msgBox.text(res.message).removeClass('text-red-600 hidden').addClass('text-green-600');
                            $('#promoCodeInput').prop('readonly', true);
                            
                            // Update totals
                            $('#discountRow').removeClass('hidden');
                            $('#discountAmount').text('-' + formatCurrency(res.discountAmount));
                            $('#finalTotal').text(formatCurrency(res.finalAmount));
                        } else {
                            msgBox.text(res.message).removeClass('text-green-600 hidden').addClass('text-red-600');
                            
                            // Reset
                            $('#discountRow').addClass('hidden');
                            $('#finalTotal').text(formatCurrency($('#finalTotal').data('original')));
                            $('#promoCodeInput').val('');
                        }
                    },
                    error: function() {
                        btn.prop('disabled', false).text('Áp dụng');
                        msgBox.text('Lỗi kết nối máy chủ.').removeClass('text-green-600 hidden').addClass('text-red-600');
                    }
                });
            });
        });
    </script>
}
