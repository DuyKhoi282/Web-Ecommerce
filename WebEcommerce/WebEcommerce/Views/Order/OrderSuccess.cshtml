@model WebEcommerce.Models.Order

@{
    ViewBag.Title = "Đặt hàng thành công";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    
    <div class="w-24 h-24 mx-auto mb-6 bg-green-100 rounded-full flex items-center justify-center">
        <span class="material-symbols-outlined text-6xl text-green-600">
            check_circle
        </span>
    </div>

    <h1 class="font-headline font-extrabold text-4xl text-slate-900 mb-4">
        Đặt hàng thành công!
    </h1>

    <p class="text-slate-600 text-lg mb-8">
        Cảm ơn bạn đã mua sắm tại The Chill Shop. Đơn hàng <span class="font-bold text-[#0d47a1]">#@Model.OrderID</span> của bạn đã được ghi nhận và đang chờ xử lý.
    </p>

    <div class="bg-white border-2 border-slate-200 rounded-2xl p-6 mb-8 text-left shadow-sm">
        <h2 class="font-bold text-lg border-b pb-3 mb-4">Thông tin đơn hàng</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-slate-500 mb-1">Người nhận:</p>
                <p class="font-semibold text-slate-900">@Model.User.FullName</p>
                <p class="text-slate-700">@Model.ReceiverPhone</p>
            </div>
            <div>
                <p class="text-slate-500 mb-1">Địa chỉ giao hàng:</p>
                <p class="font-semibold text-slate-900">@Model.ShippingAddress</p>
            </div>
            <div>
                <p class="text-slate-500 mb-1">Phương thức thanh toán:</p>
                <p class="font-semibold text-slate-900">@(Model.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng" : Model.PaymentMethod)</p>
            </div>
            <div>
                <p class="text-slate-500 mb-1">Tổng số tiền:</p>
                <p class="font-extrabold text-[#0d47a1] text-lg">@string.Format("{0:N0}đ", Model.FinalAmount)</p>
            </div>
        </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="@Url.Action("History", "Order")" class="w-full sm:w-auto px-8 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold transition-colors">
            Theo dõi đơn hàng
        </a>
        <a href="@Url.Action("Index", "Home")" class="w-full sm:w-auto px-8 py-3 rounded-xl border-2 border-slate-200 hover:border-[#0d47a1] hover:text-[#0d47a1] font-bold text-slate-700 transition-colors">
            Tiếp tục mua sắm
        </a>
    </div>
</div>
