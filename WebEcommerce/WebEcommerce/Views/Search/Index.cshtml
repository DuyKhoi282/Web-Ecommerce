@model WebEcommerce.Models.ProductSearchViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Xác định chip giá nào đang active
    bool isAllPrice = (!Model.MinPrice.HasValue || Model.MinPrice == 0) && !Model.MaxPrice.HasValue;
    bool isUnder1M = (!Model.MinPrice.HasValue || Model.MinPrice == 0) && Model.MaxPrice == 1000000;
    bool is1Mto5M = Model.MinPrice == 1000000 && Model.MaxPrice == 5000000;
    bool is5Mto15M = Model.MinPrice == 5000000 && Model.MaxPrice == 15000000;
    bool is15Mto30M = Model.MinPrice == 15000000 && Model.MaxPrice == 30000000;
    bool isOver30M = Model.MinPrice == 30000000 && !Model.MaxPrice.HasValue;
}

<div class="search-catalog-page" style="max-width: 1320px; margin: 0 auto; padding: 28px 20px 48px;">

    <!-- Tiêu đề & Thống kê kết quả -->
    <div style="margin-bottom: 24px;">
        <h1 style="font-size: 1.875rem; font-weight: 800; color: #0f172a; margin: 0 0 6px 0; font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.02em;">
            @if (!string.IsNullOrWhiteSpace(Model.Keyword))
            {
                <text>Kết quả tìm kiếm cho: <span style="color: #0d47a1;">"@Model.Keyword"</span></text>
            }
            else
            {
                <text>Tìm kiếm & Lọc Sản phẩm</text>
            }
        </h1>
        <p style="color: #64748b; font-size: 0.9rem; margin: 0; display: flex; align-items: center; gap: 6px;">
            <span>Tìm thấy</span>
            <span style="display: inline-flex; align-items: center; justify-content: center; background: #eff6ff; color: #0d47a1; font-weight: 800; font-size: 0.85rem; padding: 2px 10px; border-radius: 9999px; border: 1px solid #bfdbfe;">
                @Model.TotalCount
            </span>
            <span>sản phẩm phù hợp</span>
        </p>
    </div>

    <!-- Hộp Bộ Lọc Sản Phẩm (Filter Box) -->
    <div class="filter-card-container">
        @using (Html.BeginForm("Index", "Search", FormMethod.Get, new { id = "searchFilterForm" }))
        {
            <!-- Lưới các trường tìm kiếm & bộ lọc -->
            <div class="filter-controls-grid">
                
                <!-- 1. Từ khóa tìm kiếm -->
                <div class="filter-col-keyword">
                    <label class="filter-label">Từ khóa</label>
                    <div style="position: relative;">
                        <input type="text" name="keyword" id="searchKeyword" value="@Model.Keyword" placeholder="Nhập tên sản phẩm cần tìm..."
                               class="filter-input filter-input-search"
                               autocomplete="off" />
                        <span class="material-symbols-outlined search-icon-adornment">search</span>
                    </div>
                    <!-- Autocomplete dropdown -->
                    <div id="autocompleteDropdown" class="autocomplete-popup" style="display: none;"></div>
                </div>

                <!-- 2. Danh mục -->
                <div class="filter-col-category">
                    <label class="filter-label">Danh mục</label>
                    <div class="select-wrapper">
                        @Html.DropDownList("categoryId", Model.CategoryList, new {
                            id = "categorySelect",
                            @class = "filter-select",
                            onchange = "submitSearchFilter();"
                        })
                        <span class="material-symbols-outlined select-chevron">expand_more</span>
                    </div>
                </div>

                <!-- 3. Giá từ -->
                <div class="filter-col-price">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="filter-label" style="margin-bottom: 0;">Giá từ (₫)</label>
                        <span id="minPricePreview" class="price-preview-badge">@(Model.MinPrice.HasValue ? Model.MinPrice.Value.ToString("N0") + "₫" : "")</span>
                    </div>
                    <input type="number" name="minPrice" id="minPriceInput" value="@(Model.MinPrice.HasValue && Model.MinPrice > 0 ? Model.MinPrice.Value.ToString("0") : "")" placeholder="0" min="0" step="100000"
                           class="filter-input"
                           oninput="updatePricePreview('minPriceInput', 'minPricePreview')" />
                </div>

                <!-- 4. Giá đến -->
                <div class="filter-col-price">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="filter-label" style="margin-bottom: 0;">Giá đến (₫)</label>
                        <span id="maxPricePreview" class="price-preview-badge">@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToString("N0") + "₫" : "")</span>
                    </div>
                    <input type="number" name="maxPrice" id="maxPriceInput" value="@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToString("0") : "")" placeholder="Tối đa" min="0" step="100000"
                           class="filter-input"
                           oninput="updatePricePreview('maxPriceInput', 'maxPricePreview')" />
                </div>

                <!-- 5. Sao tối thiểu -->
                <div class="filter-col-rating">
                    <label class="filter-label">Sao tối thiểu</label>
                    <div class="select-wrapper">
                        <select name="minRating" id="minRatingSelect" class="filter-select" onchange="submitSearchFilter();">
                            <option value="">Tất cả đánh giá</option>
                            <option value="5" @(Model.MinRating == 5 ? "selected" : "")>★ 5.0 sao (Tuyệt đối)</option>
                            <option value="4" @(Model.MinRating == 4 ? "selected" : "")>★ Từ 4.0 sao trở lên</option>
                            <option value="3" @(Model.MinRating == 3 ? "selected" : "")>★ Từ 3.0 sao trở lên</option>
                            <option value="2" @(Model.MinRating == 2 ? "selected" : "")>★ Từ 2.0 sao trở lên</option>
                            <option value="1" @(Model.MinRating == 1 ? "selected" : "")>★ Từ 1.0 sao trở lên</option>
                        </select>
                        <span class="material-symbols-outlined select-chevron">expand_more</span>
                    </div>
                </div>

                <!-- 6. Sắp xếp -->
                <div class="filter-col-sort">
                    <label class="filter-label">Sắp xếp</label>
                    <div class="select-wrapper">
                        <select name="sortBy" id="sortBySelect" class="filter-select" onchange="submitSearchFilter();">
                            <option value="newest" @(Model.SortBy == "newest" ? "selected" : "")>Mới nhất</option>
                            <option value="price_asc" @(Model.SortBy == "price_asc" ? "selected" : "")>Giá tăng dần</option>
                            <option value="price_desc" @(Model.SortBy == "price_desc" ? "selected" : "")>Giá giảm dần</option>
                            <option value="name_asc" @(Model.SortBy == "name_asc" ? "selected" : "")>Tên A - Z</option>
                            <option value="rating_desc" @(Model.SortBy == "rating_desc" ? "selected" : "")>Đánh giá cao</option>
                            <option value="popular" @(Model.SortBy == "popular" ? "selected" : "")>Xem nhiều</option>
                        </select>
                        <span class="material-symbols-outlined select-chevron">expand_more</span>
                    </div>
                </div>

                <!-- 7. Nút hành động (Tìm kiếm & Đặt lại) -->
                <div class="filter-col-actions">
                    <button type="submit" class="btn-filter-apply">
                        <span class="material-symbols-outlined" style="font-size: 19px;">filter_alt</span>
                        <span>Tìm kiếm</span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.CategoryID.HasValue || Model.MinPrice.HasValue || Model.MaxPrice.HasValue || Model.MinRating.HasValue)
                    {
                        <a href="@Url.Action("Index", "Search")" class="btn-filter-reset" title="Xóa toàn bộ bộ lọc và xem tất cả">
                            <span class="material-symbols-outlined" style="font-size: 18px;">restart_alt</span>
                            <span>Đặt lại</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Dãy chọn nhanh mức giá (Quick Price Chips) -->
            <div class="quick-price-bar">
                <span class="quick-price-title">
                    <span class="material-symbols-outlined" style="font-size: 16px; color: #0d47a1;">sell</span>
                    <span>Chọn nhanh mức giá:</span>
                </span>
                <div class="quick-price-chips-list">
                    <button type="button" onclick="setQuickPrice(null, null, this)" class="quick-price-chip @(isAllPrice ? "active" : "")" data-min="" data-max="">Tất cả mức giá</button>
                    <button type="button" onclick="setQuickPrice(null, 1000000, this)" class="quick-price-chip @(isUnder1M ? "active" : "")" data-min="" data-max="1000000">Dưới 1 triệu</button>
                    <button type="button" onclick="setQuickPrice(1000000, 5000000, this)" class="quick-price-chip @(is1Mto5M ? "active" : "")" data-min="1000000" data-max="5000000">1 - 5 triệu</button>
                    <button type="button" onclick="setQuickPrice(5000000, 15000000, this)" class="quick-price-chip @(is5Mto15M ? "active" : "")" data-min="5000000" data-max="15000000">5 - 15 triệu</button>
                    <button type="button" onclick="setQuickPrice(15000000, 30000000, this)" class="quick-price-chip @(is15Mto30M ? "active" : "")" data-min="15000000" data-max="30000000">15 - 30 triệu</button>
                    <button type="button" onclick="setQuickPrice(30000000, null, this)" class="quick-price-chip @(isOver30M ? "active" : "")" data-min="30000000" data-max="">Trên 30 triệu</button>
                </div>
            </div>
        }
    </div>

    <!-- Danh sách sản phẩm -->
    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="products-catalog-grid">
            @foreach (var p in Model.Products)
            {
                <div class="product-catalog-card">
                    <!-- Ảnh sản phẩm -->
                    <a href="@Url.Action("Details", "Shop", new { id = p.ProductID })" class="product-card-image-wrap">
                        @if (!string.IsNullOrEmpty(p.MainImageUrl))
                        {
                            <img src="@p.MainImageUrl" alt="@p.Name" class="product-card-img" loading="lazy" />
                        }
                        else
                        {
                            <div class="product-card-img-placeholder">
                                <span class="material-symbols-outlined" style="font-size: 44px; color: #94a3b8;">image</span>
                            </div>
                        }
                        @if (p.DiscountPrice.HasValue && p.Price > p.DiscountPrice.Value)
                        {
                            var discountPercent = Math.Round((1 - (double)p.DiscountPrice.Value / (double)p.Price) * 100);
                            <span class="product-badge-discount">-@discountPercent%</span>
                        }
                        @if (p.StockQuantity == 0)
                        {
                            <span class="product-badge-outofstock">Hết hàng</span>
                        }
                    </a>

                    <!-- Chi tiết sản phẩm -->
                    <div class="product-card-body">
                        <div>
                            <!-- Danh mục -->
                            <p class="product-card-category">@p.CategoryName</p>
                            
                            <!-- Tên sản phẩm -->
                            <h3 class="product-card-title">
                                <a href="@Url.Action("Details", "Shop", new { id = p.ProductID })">
                                    @p.Name
                                </a>
                            </h3>

                            <!-- Đánh giá sao -->
                            <div class="product-card-rating">
                                @if (p.ReviewCount > 0)
                                {
                                    <span class="rating-score">@p.AverageRating.ToString("0.0")</span>
                                    <div class="rating-stars-list">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="material-symbols-outlined star-icon @(i <= Math.Round(p.AverageRating) ? "star-filled" : "star-empty")">star</span>
                                        }
                                    </div>
                                    <span class="rating-count">(@p.ReviewCount)</span>
                                }
                                else
                                {
                                    <div class="rating-stars-list">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="material-symbols-outlined star-icon star-empty">star</span>
                                        }
                                    </div>
                                    <span class="rating-count" style="color: #94a3b8;">Chưa có đánh giá</span>
                                }
                            </div>
                        </div>

                        <!-- Khối giá và nút chi tiết -->
                        <div class="product-card-footer">
                            <div class="product-price-row">
                                @if (p.DiscountPrice.HasValue)
                                {
                                    <span class="price-current price-discounted">@p.DiscountPrice.Value.ToString("N0")₫</span>
                                    <span class="price-original">@p.Price.ToString("N0")₫</span>
                                }
                                else
                                {
                                    <span class="price-current">@p.Price.ToString("N0")₫</span>
                                }
                            </div>
                            <a href="@Url.Action("Details", "Shop", new { id = p.ProductID })" class="btn-card-view">
                                <span>Xem chi tiết</span>
                                <span class="material-symbols-outlined" style="font-size: 15px;">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Phân trang -->
        if (Model.TotalPages > 1)
        {
            <div class="pagination-container">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    var isActive = i == Model.CurrentPage;
                    <a href="@Url.Action("Index", "Search", new { keyword = Model.Keyword, categoryId = Model.CategoryID, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, sortBy = Model.SortBy, page = i })"
                       class="pagination-page-item @(isActive ? "active" : "")">
                       @i
                    </a>
                }
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="search-empty-state">
            <div class="empty-icon-wrap">
                <span class="material-symbols-outlined" style="font-size: 48px; color: #64748b;">search_off</span>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">Không tìm thấy sản phẩm nào</h3>
            <p style="font-size: 0.9rem; color: #64748b; margin: 0 0 20px 0; max-width: 420px; line-height: 1.5;">
                Không có sản phẩm nào khớp với tiêu chí tìm kiếm hiện tại. Hãy thử chọn khoảng giá rộng hơn hoặc bấm Đặt lại bộ lọc.
            </p>
            <a href="@Url.Action("Index", "Search")" class="btn-empty-reset">
                <span class="material-symbols-outlined" style="font-size: 18px;">refresh</span>
                <span>Xem tất cả sản phẩm</span>
            </a>
        </div>
    }
</div>

@section scripts {
    <script>
        // Tự động submit bộ lọc
        function submitSearchFilter() {
            var form = document.getElementById('searchFilterForm');
            if (form) form.submit();
        }

        // Chọn nhanh mức giá (Quick Price)
        function setQuickPrice(min, max, buttonElement) {
            var minInput = document.getElementById('minPriceInput');
            var maxInput = document.getElementById('maxPriceInput');
            if (!minInput || !maxInput) return;

            // Nếu người dùng bấm lại vào chip đang active -> hủy lọc giá (về Tất cả mức giá)
            if (buttonElement && buttonElement.classList.contains('active') && (min !== null || max !== null)) {
                minInput.value = '';
                maxInput.value = '';
            } else {
                minInput.value = min !== null ? min : '';
                maxInput.value = max !== null ? max : '';
            }

            updatePricePreview('minPriceInput', 'minPricePreview');
            updatePricePreview('maxPriceInput', 'maxPricePreview');

            // Cập nhật class active trực tiếp cho phản hồi tức thì
            var allChips = document.querySelectorAll('.quick-price-chip');
            allChips.forEach(function (chip) { chip.classList.remove('active'); });
            if (buttonElement) {
                buttonElement.classList.add('active');
            }

            submitSearchFilter();
        }

        // Xem trước định dạng tiền tệ khi người dùng gõ
        function updatePricePreview(inputId, previewId) {
            var input = document.getElementById(inputId);
            var preview = document.getElementById(previewId);
            if (!input || !preview) return;
            var val = parseFloat(input.value);
            if (!isNaN(val) && val > 0) {
                preview.textContent = val.toLocaleString('vi-VN') + '₫';
            } else {
                preview.textContent = '';
            }
        }

        // Autocomplete từ khóa
        (function () {
            var searchInput = document.getElementById('searchKeyword');
            var dropdown = document.getElementById('autocompleteDropdown');
            var debounceTimer;

            if (!searchInput || !dropdown) return;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                var term = this.value.trim();
                if (term.length < 2) {
                    dropdown.style.display = 'none';
                    return;
                }

                debounceTimer = setTimeout(function () {
                    fetch('@Url.Action("Autocomplete", "Search")?term=' + encodeURIComponent(term))
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (!data || !data.length) {
                                dropdown.style.display = 'none';
                                return;
                            }
                            dropdown.innerHTML = '';
                            data.forEach(function (item) {
                                var div = document.createElement('div');
                                div.className = 'autocomplete-item';
                                div.onclick = function () {
                                    if (item.id) {
                                        window.location.href = '@Url.Action("Details", "Shop")/' + item.id;
                                    } else {
                                        searchInput.value = item.name;
                                        dropdown.style.display = 'none';
                                        submitSearchFilter();
                                    }
                                };
                                var imgHtml = item.image
                                    ? '<img src="' + item.image + '" class="autocomplete-thumb" />'
                                    : '<div class="autocomplete-thumb-empty"><span class="material-symbols-outlined" style="font-size:16px;color:#94a3b8;">image</span></div>';
                                div.innerHTML = imgHtml + '<div style="flex:1;min-width:0;"><div class="autocomplete-name">' + item.name + '</div><div class="autocomplete-sub">' + (item.category || '') + ' • ' + Number(item.price).toLocaleString('vi-VN') + '₫</div></div>';
                                dropdown.appendChild(div);
                            });
                            dropdown.style.display = 'block';
                        })
                        .catch(function () {
                            dropdown.style.display = 'none';
                        });
                }, 250);
            });

            document.addEventListener('click', function (e) {
                if (dropdown && !dropdown.contains(e.target) && e.target !== searchInput) {
                    dropdown.style.display = 'none';
                }
            });
        })();
    </script>
}

<style>
    /* Design System Tokens & Anti-Slop Layouts */
    .filter-card-container {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 22px 24px;
        margin-bottom: 30px;
        box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
        transition: box-shadow 0.2s ease;
    }

    .filter-controls-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: flex-end;
    }

    /* Các cột trong form lọc */
    .filter-col-keyword {
        flex: 2 1 240px;
        min-width: 230px;
        position: relative;
    }

    .filter-col-category {
        flex: 1.4 1 210px;
        min-width: 200px;
    }

    .filter-col-price {
        flex: 1 1 140px;
        min-width: 135px;
    }

    .filter-col-rating {
        flex: 1.2 1 185px;
        min-width: 180px;
    }

    .filter-col-sort {
        flex: 1.1 1 160px;
        min-width: 155px;
    }

    .filter-col-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    /* Nhãn & Input */
    .filter-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        display: block;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .price-preview-badge {
        font-size: 0.72rem;
        color: #0d47a1;
        font-weight: 700;
        background: #eff6ff;
        padding: 1px 6px;
        border-radius: 6px;
    }

    .filter-input {
        width: 100%;
        height: 44px;
        padding: 0 12px;
        font-size: 0.875rem;
        color: #1e293b;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .filter-input:focus {
        background: #ffffff;
        border-color: #0d47a1;
        box-shadow: 0 0 0 3px rgba(13, 71, 161, 0.12);
    }

    .filter-input-search {
        padding-left: 38px;
    }

    .search-icon-adornment {
        position: absolute;
        left: 11px;
        top: 12px;
        color: #94a3b8;
        font-size: 20px;
        pointer-events: none;
    }

    /* Tùy biến Custom Select với Chevron sạch, chống tràn chữ */
    .select-wrapper {
        position: relative;
        width: 100%;
    }

    .filter-select {
        width: 100%;
        height: 44px;
        padding: 0 34px 0 12px;
        font-size: 0.875rem;
        color: #1e293b;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        outline: none;
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        box-sizing: border-box;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .filter-select:focus {
        background: #ffffff;
        border-color: #0d47a1;
        box-shadow: 0 0 0 3px rgba(13, 71, 161, 0.12);
    }

    .select-chevron {
        position: absolute;
        right: 10px;
        top: 12px;
        color: #64748b;
        font-size: 20px;
        pointer-events: none;
        transition: transform 0.2s;
    }

    /* Nút Áp dụng & Đặt lại */
    .btn-filter-apply {
        height: 44px;
        padding: 0 20px;
        background: #0d47a1;
        color: #ffffff;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.875rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 4px 12px rgba(13, 71, 161, 0.25);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
    }

    .btn-filter-apply:hover {
        background: #0a3880;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(13, 71, 161, 0.32);
    }

    .btn-filter-reset {
        height: 44px;
        padding: 0 14px;
        background: #f1f5f9;
        color: #475569;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.875rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
    }

    .btn-filter-reset:hover {
        background: #fee2e2;
        color: #dc2626;
        border-color: #fca5a5;
    }

    /* Quick Price Chips Bar */
    .quick-price-bar {
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px dashed #e2e8f0;
        display: flex;
