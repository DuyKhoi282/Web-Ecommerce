                    <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-400 via-sky-500 to-indigo-600 rounded-[32px] blur-xl opacity-70 group-hover:opacity-100 transition duration-1000 animate-pulse"></div>
                    <div class="relative bg-[#0c1d3b]/95 backdrop-blur-2xl border-2 border-cyan-400/40 rounded-[28px] p-6 sm:p-7 shadow-2xl text-white">
                        @{
                            var heroProduct = Model != null && Model.Any() ? Model.First() : null;
                            var heroName = heroProduct != null ? heroProduct.Name : "Sản phẩm công nghệ cao cấp";
                            var heroPrice = heroProduct != null ? heroProduct.Price : 29990000m;
                            var heroDiscount = heroProduct != null ? heroProduct.DiscountPrice : (decimal?)null;
                            var heroCategory = heroProduct?.Category?.Name ?? "TheChillShop";
                            var heroImage = heroProduct?.ProductImages?.FirstOrDefault(p => p.IsMain)?.ImageURL
                                            ?? heroProduct?.ProductImages?.FirstOrDefault()?.ImageURL
                                            ?? "https://images.unsplash.com/photo-1592750475338-74b7b21085ab?w=600&auto=format&fit=crop&q=80";
                            var heroStock = heroProduct != null ? heroProduct.StockQuantity : 25;
                            int heroDiscountPercent = 0;
                            if (heroDiscount.HasValue && heroDiscount.Value > 0 && heroDiscount.Value < heroPrice && heroPrice > 0)
                            {
                                heroDiscountPercent = (int)Math.Round((heroPrice - heroDiscount.Value) / heroPrice * 100);
                            }
                        }
                        <div class="flex items-center justify-between mb-5">
                            <span class="px-3.5 py-1 rounded-full bg-gradient-to-r from-rose-500 to-amber-500 text-white text-[11px] font-extrabold uppercase tracking-wider shadow-md">
                                🔥 SẢN PHẨM HOT
                            </span>
                            @if (heroDiscountPercent > 0)
                            {
                                <span class="text-xs text-cyan-300 font-bold flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm text-yellow-300">bolt</span> Giảm sốc @heroDiscountPercent%
                                </span>
                            }
                        </div>

                        <div class="w-full aspect-[4/3] rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center p-4 mb-5 relative overflow-hidden group">
