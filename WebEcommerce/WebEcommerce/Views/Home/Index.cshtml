@foreach (var cat in categories)
{
<a class="flex items-center justify-between px-3 py-2 rounded-lg text-body-medium font-body-medium text-on-surface hover:bg-badge-discount-bg hover:text-badge-discount-text transition-colors group" href="@Url.Action("Index", "Search", new { categoryId = cat.CategoryID })">
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-text-muted group-hover:text-badge-discount-text">label</span>
<span>@cat.Name</span>
</div>
<span class="material-symbols-outlined text-[16px] text-text-muted group-hover:translate-x-0.5 transition-transform">chevron_right</span>
</a>
}
<a class="flex items-center justify-between px-3 py-2 rounded-lg text-body-medium font-body-medium text-badge-discount-text font-bold bg-badge-discount-bg/60 hover:bg-badge-discount-bg transition-colors" href="#">
