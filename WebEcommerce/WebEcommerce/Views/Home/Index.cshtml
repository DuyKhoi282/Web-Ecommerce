@{
    ViewBag.Title = "Trang chủ - Thế giới công nghệ chính hãng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ==========================================
     HERO BANNER SECTION
     ========================================== -->
<section class="relative bg-gradient-to-br from-[#0d47a1] via-[#0b3b82] to-[#002855] text-white overflow-hidden py-16 lg:py-24">
    <!-- Background Glow Effects -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-[#00b4d8]/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-[#0d47a1]/40 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Left Headline & CTA -->
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-semibold tracking-wide text-[#00b4d8]">
                    <span class="w-2 h-2 rounded-full bg-[#00b4d8] animate-ping"></span>
                    THECHILLSHOP - ĐỈNH CAO CÔNG NGHỆ 2026
                </div>

                <h1 class="font-headline font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-tight">
                    Khám phá phong cách <br class="hidden sm:inline" />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-200 to-white">
                        Sống công nghệ hiện đại
                    </span>
                </h1>

                <p class="text-slate-300 text-base sm:text-lg max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
                    Trải nghiệm mua sắm thiết bị di động, laptop, âm thanh và phụ kiện chính hãng với chính sách bảo hành 12 tháng 1 đổi 1 và giao hàng hỏa tốc trong 2 giờ.
                </p>

                <!-- Action CTAs -->
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
                    <a href="#featured-products" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-[#00b4d8] to-[#0096c7] text-white font-bold text-sm shadow-lg shadow-[#00b4d8]/25 hover:shadow-cyan-400/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-lg">shopping_bag</span>
                        <span>Khám phá sản phẩm</span>
                    </a>
                    <a href="#categories-section" class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/20 text-white font-semibold text-sm transition-all duration-200 flex items-center justify-center gap-2">
                        <span>Xem danh mục</span>
                        <span class="material-symbols-outlined text-base">arrow_forward</span>
                    </a>
                </div>

                <!-- Trust Badges -->
                <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-300 font-medium">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#00b4d8] text-base">verified</span>
                        <span>100% Chính hãng</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#00b4d8] text-base">local_shipping</span>
                        <span>Freeship toàn quốc từ 500k</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#00b4d8] text-base">published_with_changes</span>
                        <span>15 ngày đổi trả miễn phí</span>
                    </div>
                </div>
            </div>

            <!-- Right Visual Graphic / Banner Showcase -->
            <div class="lg:col-span-5 flex justify-center">
                <div class="relative w-full max-w-md">
                    <!-- Decorative back card -->
                    <div class="absolute inset-0 bg-gradient-to-tr from-[#00b4d8]/20 to-[#0d47a1]/40 rounded-3xl transform rotate-3 scale-105 filter blur-lg"></div>
                    
                    <!-- Main Featured Showcase Card -->
                    <div class="relative bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-6 sm:p-8 shadow-2xl text-white">
                        <div class="flex items-center justify-between mb-6">
                            <span class="px-3 py-1 rounded-full bg-rose-500 text-white text-[11px] font-bold uppercase tracking-wider">
                                HOT DEAL TUẦN NÀY
                            </span>
                            <span class="text-xs text-cyan-300 font-semibold flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">bolt</span> Flash Sale
                            </span>
                        </div>

                        <div class="w-full aspect-[4/3] rounded-2xl bg-gradient-to-b from-white/10 to-transparent flex items-center justify-center p-4 mb-6 relative overflow-hidden group">
                            <img src="https://images.unsplash.com/photo-1592750475338-74b7b21085ab?w=600&auto=format&fit=crop&q=80" 
                                 alt="Flagship Smartphone" 
                                 class="max-h-56 object-contain drop-shadow-2xl group-hover:scale-105 transition-transform duration-500" 
                                 onerror="this.src='https://placehold.co/500x350/0d47a1/ffffff?text=Flagship+Phone';" />
                        </div>

                        <div class="space-y-2">
                            <p class="text-xs text-cyan-300 uppercase tracking-wider font-semibold">Flagship Phone 2026</p>
                            <h3 class="font-headline font-bold text-xl sm:text-2xl text-white">
                                iPhone 16 Pro Max 256GB Titan Tự Nhiên
                            </h3>
                            <div class="flex items-baseline gap-3 pt-2">
                                <span class="font-headline font-extrabold text-2xl text-cyan-300">29.990.000đ</span>
                                <span class="text-sm text-slate-400 line-through">34.990.000đ</span>
                                <span class="text-xs px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 font-bold">-14%</span>
                            </div>
                        </div>

                        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-slate-300">
                            <span>Đã bán: <strong>142/200</strong></span>
                            <div class="w-32 bg-white/20 rounded-full h-2 overflow-hidden">
                                <div class="bg-gradient-to-r from-amber-400 to-rose-500 h-full rounded-full" style="width: 71%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ==========================================
     VALUE PROPOSITIONS (4 USPs)
     ========================================== -->
<section class="border-b border-slate-200/80 bg-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <div class="flex items-center gap-4 p-4 rounded-xl hover:bg-slate-50 transition-colors">
                <div class="w-12 h-12 rounded-xl bg-[#0d47a1]/10 text-[#0d47a1] flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-2xl">local_shipping</span>
                </div>
                <div>
                    <h4 class="font-headline font-bold text-slate-900 text-sm">Giao hàng hỏa tốc</h4>
                    <p class="text-xs text-slate-500 mt-0.5">Miễn phí giao hàng đơn từ 500k</p>
                </div>
            </div>

            <div class="flex items-center gap-4 p-4 rounded-xl hover:bg-slate-50 transition-colors">
                <div class="w-12 h-12 rounded-xl bg-[#00b4d8]/10 text-[#00b4d8] flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-2xl">verified_user</span>
                </div>
                <div>
                    <h4 class="font-headline font-bold text-slate-900 text-sm">100% Chính hãng</h4>
                    <p class="text-xs text-slate-500 mt-0.5">Cam kết nguồn gốc minh bạch</p>
                </div>
            </div>

            <div class="flex items-center gap-4 p-4 rounded-xl hover:bg-slate-50 transition-colors">
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-2xl">published_with_changes</span>
                </div>
                <div>
                    <h4 class="font-headline font-bold text-slate-900 text-sm">15 ngày đổi trả</h4>
                    <p class="text-xs text-slate-500 mt-0.5">Đổi mới nếu phát sinh lỗi kỹ thuật</p>
                </div>
            </div>

            <div class="flex items-center gap-4 p-4 rounded-xl hover:bg-slate-50 transition-colors">
                <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-2xl">support_agent</span>
                </div>
                <div>
                    <h4 class="font-headline font-bold text-slate-900 text-sm">Hỗ trợ 24/7</h4>
                    <p class="text-xs text-slate-500 mt-0.5">Hotline miễn phí 1900 6868</p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ==========================================
     FEATURED CATEGORIES (Placeholder cho TV2)
     ========================================== -->
