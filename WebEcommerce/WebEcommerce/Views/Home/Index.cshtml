<!-- CLIENT INTERACTIONS FOR HERO BANNER & FLASH SALE COUNTDOWN -->
<script>
  // Dynamic Hero Switcher
  const heroImages = [
    "https://lh3.googleusercontent.com/aida/AEtjO1X_k8mu8wZuhrHDY7v862Du_L2YoQl4cRa40IdulogSnXuE4uhtQirTTT3sBMiXqKCNyXpFYAPU6BdwyUHiYcdLFx76zIWbta4nj0F7HhYnZoK90oay4RlIhxNVJPc_ljLcz9gH0szVM7rEwjE57-i57udLp2y1gs8ENj62IGEr2Liqxbz2Xhc6icGSGDDocF2Yekdr0u-NPGYVYJZLaQgU4KtKo1PyqV3Yx33c0MPKNQ",
    "https://lh3.googleusercontent.com/aida/AEtjO1WremtGVKeBCr7I2BkwFtSO-KwIvLndGSagC9jkINvQuvryGhco7W6PAraSSg4T-wi0XDEc5KOP4x4fhthGzsmyAkafC61Dvyse-ZXNqyF_vrKBtVn4LxG6TP-Xa3QJnoZWdF76dpmkAv29zmxP07DD4eKmvyrOstF35WaCn6v-jwQNWwEMPENPgRmJ7EKjQJUP2O2-vo7CWU73mD9kT_gZdhpQbxNFiYQKzWk8ky2Vdw",
    "https://lh3.googleusercontent.com/aida/AEtjO1VdfjAuEew1SEnfTGRbXas__zgtPySR0HGChvyru6gaHfJ43M99Id7QvF-Q5_MLFpzJuH9qqSYEKf8AOsbb4XfNPnwON1Vtiq8VI_R7fajZ8HTqbiDhkQcLvIWLhzFAcC9h68kMozj16qSwDMwg9JqS4MBq2efTJccfKC46ap1JciZqrIe1CC_9y-beW5KDEVhYQQXRaEFSRV_IuEZaZTyhAeDUiJsNqEWtidfQxLfh"
  ];
  let currentHeroIdx = 0;
  const heroImgEl = document.getElementById('mainHeroImage');

  function setHeroBanner(src) {
    if (heroImgEl) {
      heroImgEl.style.opacity = '0.3';
      setTimeout(() => {
        heroImgEl.src = src;
        heroImgEl.style.opacity = '1';
      }, 150);
    }
  }

  const prevBtn = document.getElementById('heroPrev');
  const nextBtn = document.getElementById('heroNext');

  if (prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => {
      currentHeroIdx = (currentHeroIdx - 1 + heroImages.length) % heroImages.length;
      setHeroBanner(heroImages[currentHeroIdx]);
    });
    nextBtn.addEventListener('click', () => {
      currentHeroIdx = (currentHeroIdx + 1) % heroImages.length;
      setHeroBanner(heroImages[currentHeroIdx]);
    });
  }

  // Flash Sale Timer Countdown Simulation
  let totalSeconds = 2 * 3600 + 45 * 60 + 18;
  const hoursBox = document.getElementById('hoursBox');
  const minsBox = document.getElementById('minsBox');
  const secsBox = document.getElementById('secsBox');

  setInterval(() => {
    if (totalSeconds > 0) {
      totalSeconds--;
      const hrs = Math.floor(totalSeconds / 3600);
      const mns = Math.floor((totalSeconds % 3600) / 60);
      const scs = totalSeconds % 60;
      if (hoursBox) hoursBox.innerText = String(hrs).padStart(2, '0');
      if (minsBox) minsBox.innerText = String(mns).padStart(2, '0');
      if (secsBox) secsBox.innerText = String(scs).padStart(2, '0');
    }
  }, 1000);
</script>

