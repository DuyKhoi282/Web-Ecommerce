<div class="flex items-center gap-3 p-2 rounded-lg bg-surface-canvas/60">
<span class="w-9 h-9 rounded-full bg-primary-fixed flex items-center justify-center text-primary-container shrink-0">
<span class="material-symbols-outlined text-[20px]">verified</span>
</span>
<div class="min-w-0">
<p class="font-title-sm text-title-sm text-on-surface leading-tight text-xs md:text-sm font-semibold truncate">Chính hãng - Xuất VAT</p>
<p class="font-caption-sm text-caption-sm text-text-muted text-[11px] truncate">Hóa đơn điện tử đầy đủ 100%</p>
</div>
</div>
<div class="flex items-center gap-3 p-2 rounded-lg bg-surface-canvas/60">
