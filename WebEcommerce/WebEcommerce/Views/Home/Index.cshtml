    <img alt="Samsung Galaxy S24 Ultra &amp; Z Series" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90" src="https://images.unsplash.com/photo-1565849904461-04a58ad377e0?w=700&h=300&auto=format&fit=crop&q=80"/>
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent flex flex-col justify-end p-3">
