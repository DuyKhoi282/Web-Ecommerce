@{
    var mainCategories = categories.Where(c => c.ParentCategoryID == null).ToList();
    if (!mainCategories.Any()) { mainCategories = categories.Take(8).ToList(); }
}
@foreach (var cat in mainCategories)
{
    var catNameLower = (cat.Name ?? "").ToLower();
    string iconName = "devices";
    if (catNameLower.Contains("điện thoại") || catNameLower.Contains("phone")) { iconName = "smartphone"; }
    else if (catNameLower.Contains("laptop") || catNameLower.Contains("máy tính")) { iconName = "laptop_chromebook"; }
    else if (catNameLower.Contains("đồng hồ") || catNameLower.Contains("watch")) { iconName = "watch"; }
    else if (catNameLower.Contains("âm thanh") || catNameLower.Contains("loa") || catNameLower.Contains("tai nghe")) { iconName = "headphones"; }
    else if (catNameLower.Contains("máy ảnh") || catNameLower.Contains("camera")) { iconName = "photo_camera"; }
    else if (catNameLower.Contains("gaming") || catNameLower.Contains("game")) { iconName = "sports_esports"; }
    else if (catNameLower.Contains("nhà thông minh") || catNameLower.Contains("smart home")) { iconName = "home_iot_device"; }
    else if (catNameLower.Contains("phụ kiện")) { iconName = "cable"; }

<a class="flex items-center justify-between px-3 py-2 rounded-lg text-body-medium font-body-medium text-on-surface hover:bg-badge-discount-bg hover:text-badge-discount-text transition-colors group" href="@Url.Action("Index", "Search", new { categoryId = cat.CategoryID })">
