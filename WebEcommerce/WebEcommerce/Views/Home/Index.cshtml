<!-- CLIENT INTERACTIONS FOR HERO BANNER & FLASH SALE COUNTDOWN -->
<script>
  // Dynamic Hero Slides Data
  const heroSlides = [
    {
      image: "https://images.unsplash.com/photo-1695048133142-1a20484d2569?w=1200&h=520&auto=format&fit=crop&q=80",
      badge: "Flagship Khủng",
      title: "iPhone 18 Pro | 18 Pro Max",
      desc: "Trợ giá thu cũ 5.000.000đ - Trả góp 0% lãi suất xét duyệt nhanh 3 phút"
    },
    {
      image: "https://images.unsplash.com/photo-1610945415295-d9bbf067e59c?w=1200&h=520&auto=format&fit=crop&q=80",
      badge: "Galaxy AI Đỉnh Cao",
      title: "Galaxy Z8 Series | Galaxy S24 Ultra",
      desc: "Gập mở chuẩn AI đỉnh cao - Ưu đãi độc quyền tặng bảo hành Care+ 1 năm"
    },
    {
      image: "https://images.unsplash.com/photo-1542751371-adc38448a05e?w=1200&h=520&auto=format&fit=crop&q=80",
      badge: "Back To School",
      title: "Tuần Lễ Laptop ASUS ZenBook & ROG",
      desc: "Giảm thêm 1 Triệu Sinh Viên - Tặng kèm Balo cao cấp & Chuột không dây"
    }
  ];

  let currentHeroIdx = 0;
  let heroAutoPlayInterval = null;
  const heroImgEl = document.getElementById('mainHeroImage');
  const heroTextContainer = document.getElementById('heroTextContainer');
  const heroBadgeEl = document.getElementById('heroBadge');
  const heroTitleEl = document.getElementById('heroTitle');
  const heroDescEl = document.getElementById('heroDesc');
  const heroTabsContainer = document.getElementById('heroTabsContainer');

  function setHeroSlide(idx) {
    if (idx < 0 || idx >= heroSlides.length) return;
    currentHeroIdx = idx;
    const slide = heroSlides[idx];

    // Fade out image & text slightly
    if (heroImgEl) heroImgEl.style.opacity = '0.3';
    if (heroTextContainer) heroTextContainer.style.opacity = '0.3';

    setTimeout(() => {
      if (heroImgEl) {
        heroImgEl.src = slide.image;
        heroImgEl.style.opacity = '1';
      }
      if (heroBadgeEl) {
        heroBadgeEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-surface-card animate-pulse"></span> ' + slide.badge;
      }
      if (heroTitleEl) {
        heroTitleEl.textContent = slide.title;
      }
      if (heroDescEl) {
        heroDescEl.textContent = slide.desc;
      }
      if (heroTextContainer) {
        heroTextContainer.style.opacity = '1';
      }
    }, 150);

    // Update active tab styles
    if (heroTabsContainer) {
      const tabs = heroTabsContainer.querySelectorAll('.hero-tab');
      tabs.forEach((tab, index) => {
        const titleEl = tab.querySelector('.hero-tab-title');
        if (index === idx) {
          tab.classList.remove('border-transparent');
          tab.classList.add('border-primary-container');
          if (titleEl) {
            titleEl.classList.remove('text-on-surface');
            titleEl.classList.add('text-primary-container');
          }
        } else {
          tab.classList.remove('border-primary-container');
          tab.classList.add('border-transparent');
          if (titleEl) {
            titleEl.classList.remove('text-primary-container');
            titleEl.classList.add('text-on-surface');
          }
        }
      });
    }

    resetAutoPlay();
  }

  function resetAutoPlay() {
    if (heroAutoPlayInterval) clearInterval(heroAutoPlayInterval);
    heroAutoPlayInterval = setInterval(() => {
      const nextIdx = (currentHeroIdx + 1) % heroSlides.length;
      setHeroSlide(nextIdx);
    }, 5000);
  }

  // Backward compatibility fallback for setHeroBanner
  function setHeroBanner(src) {
    const foundIdx = heroSlides.findIndex(s => s.image === src);
    if (foundIdx !== -1) {
      setHeroSlide(foundIdx);
    } else if (heroImgEl) {
      heroImgEl.src = src;
    }
  }

  const prevBtn = document.getElementById('heroPrev');
  const nextBtn = document.getElementById('heroNext');

  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const prevIdx = (currentHeroIdx - 1 + heroSlides.length) % heroSlides.length;
      setHeroSlide(prevIdx);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const nextIdx = (currentHeroIdx + 1) % heroSlides.length;
      setHeroSlide(nextIdx);
    });
  }

  // Start auto play on page load
  resetAutoPlay();

  // Flash Sale Timer Countdown Simulation
  let totalSeconds = 2 * 3600 + 45 * 60 + 18;
  const hoursBox = document.getElementById('hoursBox');
  const minsBox = document.getElementById('minsBox');
  const secsBox = document.getElementById('secsBox');

  setInterval(() => {
    if (totalSeconds > 0) {
      totalSeconds--;
      const hrs = Math.floor(totalSeconds / 3600);
      const mns = Math.floor((totalSeconds % 3600) / 60);
      const scs = totalSeconds % 60;
      if (hoursBox) hoursBox.innerText = String(hrs).padStart(2, '0');
      if (minsBox) minsBox.innerText = String(mns).padStart(2, '0');
      if (secsBox) secsBox.innerText = String(scs).padStart(2, '0');
    }
  }, 1000);
</script>

