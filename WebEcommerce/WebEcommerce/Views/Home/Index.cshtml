@using WebEcommerce.Models
@model List<WebEcommerce.Models.Product>
@{
    ViewBag.Title = "TheChillShop - Thế giới công nghệ & phụ kiện cao cấp";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var featuredProducts = ViewBag.FeaturedProducts as List<Product> ?? new List<Product>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var allProducts = ViewBag.AllProducts as List<Product> ?? new List<Product>();
    var flashSales = ViewBag.FlashSales as List<FlashSale> ?? new List<FlashSale>();
    var activeFlashSale = ViewBag.ActiveFlashSale as FlashSale;
    if (activeFlashSale == null && flashSales.Any())
    {
        activeFlashSale = flashSales.FirstOrDefault();
    }
    var activeFlashSaleId = activeFlashSale != null ? activeFlashSale.FlashSaleID : 0;
    var hasActiveFlashSale = flashSales.Any(fs => fs.FlashSaleItems != null && fs.FlashSaleItems.Any(fsi => fsi.Product != null && fsi.Product.Status != 3));
}


<!-- VALUE PROPOSITION BAR -->
<section class="w-full bg-white border-b border-slate-200/90 shadow-sm py-3.5 px-4">
    <div class="max-w-[1280px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-3 reveal-stagger">
        <div class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 card-hover-smooth hover-lift cursor-default">
            <span class="w-9 h-9 rounded-full bg-primary-fixed flex items-center justify-center text-primary-container shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-[20px]">verified</span>
            </span>
            <div class="min-w-0">
                <p class="font-title-sm text-title-sm text-on-surface leading-tight text-xs md:text-sm font-semibold truncate">Chính hãng - Xuất VAT</p>
                <p class="font-caption-sm text-caption-sm text-text-muted text-[11px] truncate">Hóa đơn điện tử đầy đủ 100%</p>
            </div>
        </div>
        <div class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 card-hover-smooth hover-lift cursor-default">
            <span class="w-9 h-9 rounded-full bg-secondary-fixed flex items-center justify-center text-secondary shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-[20px]">bolt</span>
            </span>
            <div class="min-w-0">
                <p class="font-title-sm text-title-sm text-on-surface leading-tight text-xs md:text-sm font-semibold truncate">Giao nhanh 2h miễn phí</p>
                <p class="font-caption-sm text-caption-sm text-text-muted text-[11px] truncate">Áp dụng cho đơn từ 300.000đ</p>
            </div>
        </div>
        <div class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 card-hover-smooth hover-lift cursor-default">
            <span class="w-9 h-9 rounded-full bg-tertiary-fixed flex items-center justify-center text-tertiary-container shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-[20px]">currency_exchange</span>
            </span>
            <div class="min-w-0">
                <p class="font-title-sm text-title-sm text-on-surface leading-tight text-xs md:text-sm font-semibold truncate">Thu cũ giá ngon</p>
                <p class="font-caption-sm text-caption-sm text-text-muted text-[11px] truncate">Lên đời trợ giá đến 5 triệu</p>
            </div>
        </div>
        <div class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 card-hover-smooth hover-lift cursor-default">
            <span class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-[20px]">published_with_changes</span>
            </span>
            <div class="min-w-0">
                <p class="font-title-sm text-title-sm text-on-surface leading-tight text-xs md:text-sm font-semibold truncate">Bảo hành 1 đổi 1</p>
                <p class="font-caption-sm text-caption-sm text-text-muted text-[11px] truncate">Yên tâm 30 ngày trải nghiệm</p>
            </div>
        </div>
    </div>
</section>
<!-- HERO SHOWCASE SECTION (BENTO GRID WITH VERTICAL MENU + CAROUSEL + PROMO CARDS) -->
<section class="max-w-[1280px] mx-auto px-4 py-4 w-full">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
<!-- LEFT CATEGORIES MENU (2.5 COLS) -->
<div class="hidden lg:block lg:col-span-3 bg-white rounded-2xl shadow-sm border border-slate-200/90 p-3.5 space-y-1 reveal-from-left">
<div class="px-2 py-1.5 text-caption-sm font-caption-sm text-text-muted font-bold tracking-wider uppercase">Khám phá danh mục</div>
@{
    var mainCategories = categories.Where(c => c.ParentCategoryID == null).ToList();
    if (!mainCategories.Any()) { mainCategories = categories.Take(8).ToList(); }
}
@foreach (var cat in mainCategories)
{
    var catNameLower = (cat.Name ?? "").ToLower();
    string iconName = "devices";
    if (catNameLower.Contains("điện thoại") || catNameLower.Contains("phone")) { iconName = "smartphone"; }
    else if (catNameLower.Contains("laptop") || catNameLower.Contains("máy tính")) { iconName = "laptop_chromebook"; }
    else if (catNameLower.Contains("đồng hồ") || catNameLower.Contains("watch")) { iconName = "watch"; }
    else if (catNameLower.Contains("âm thanh") || catNameLower.Contains("loa") || catNameLower.Contains("tai nghe")) { iconName = "headphones"; }
    else if (catNameLower.Contains("máy ảnh") || catNameLower.Contains("camera")) { iconName = "photo_camera"; }
    else if (catNameLower.Contains("gaming") || catNameLower.Contains("game")) { iconName = "sports_esports"; }
    else if (catNameLower.Contains("nhà thông minh") || catNameLower.Contains("smart home")) { iconName = "home_iot_device"; }
    else if (catNameLower.Contains("phụ kiện")) { iconName = "cable"; }

<a class="flex items-center justify-between px-3 py-2 rounded-lg text-body-medium font-body-medium text-on-surface hover:bg-badge-discount-bg hover:text-badge-discount-text transition-colors group" href="@Url.Action("Index", "Search", new { categoryId = cat.CategoryID })">
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px] text-text-muted group-hover:text-badge-discount-text">@iconName</span>
<span>@cat.Name</span>
</div>
<span class="material-symbols-outlined text-[16px] text-text-muted group-hover:translate-x-0.5 transition-transform">chevron_right</span>
</a>
}
<a class="flex items-center justify-between px-3 py-2 rounded-lg text-body-medium font-body-medium text-badge-discount-text font-bold bg-badge-discount-bg/60 hover:bg-badge-discount-bg transition-colors" href="@Url.Action("Index", "Shop")">
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-[20px]">sync_alt</span>
<span>Thu cũ đổi mới</span>
</div>
<span class="text-[10px] uppercase tracking-wide bg-primary-container text-on-primary px-1.5 py-0.5 rounded font-bold">Trợ 5TR</span>
</a>
</div>
