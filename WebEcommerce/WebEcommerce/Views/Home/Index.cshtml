            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="max-w-2xl relative z-10 space-y-4">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider border border-white/20">
                    <span class="material-symbols-outlined text-sm text-yellow-300">stars</span>
