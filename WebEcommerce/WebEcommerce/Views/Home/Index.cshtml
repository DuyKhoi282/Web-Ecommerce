                <span class="font-bold text-xl text-white/60">:</span>
                <div class="flex flex-col items-center bg-black/30 backdrop-blur-md rounded-xl px-3 py-2 min-w-[56px]">
                    <span class="font-headline font-extrabold text-xl text-white">18</span>
                    <span class="text-[10px] text-white/70 uppercase">Giây</span>
                </div>
            </div>
        </div>
    </div>
</section>

