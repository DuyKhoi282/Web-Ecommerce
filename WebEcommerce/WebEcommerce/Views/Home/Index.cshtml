                                    }
                                    else
                                    {
                                        <span>Đã bán @fsi.SoldQuantity/@fsi.MaxQuantity</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
