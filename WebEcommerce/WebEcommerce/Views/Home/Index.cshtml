</button>
<button class="hero-tab text-left p-2.5 rounded-xl bg-white hover:bg-slate-50 transition-all shadow-sm border-2 border-slate-200" onclick="setHeroSlide(1)">
<p class="hero-tab-title font-title-sm text-title-sm text-on-surface text-xs font-bold truncate">GALAXY Z8 SERIES</p>
<p class="hero-tab-sub font-caption-sm text-caption-sm text-text-muted text-[11px] truncate">Gập mở chuẩn AI đỉnh cao</p>
</button>
<button class="hero-tab text-left p-2.5 rounded-xl bg-white hover:bg-slate-50 transition-all shadow-sm border-2 border-slate-200" onclick="setHeroSlide(2)">
