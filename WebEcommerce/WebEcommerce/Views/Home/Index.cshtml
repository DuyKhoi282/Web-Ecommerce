                                <span class="text-[11px] uppercase tracking-wider font-extrabold text-cyan-300">@heroCategory</span>
                            </div>

                            <h3 class="font-headline font-bold text-xl text-white line-clamp-1">
                                @heroName
                            </h3>

                            <div class="flex items-baseline gap-3 pt-1">
                                @if (heroDiscount.HasValue && heroDiscount.Value > 0)
                                {
                                    <span class="font-headline font-black text-2xl text-cyan-300">@string.Format("{0:N0}đ", heroDiscount.Value)</span>
                                    <span class="text-sm text-slate-400 line-through">@string.Format("{0:N0}đ", heroPrice)</span>
                                    <span class="text-xs px-2 py-0.5 rounded-md bg-rose-500/20 text-rose-300 font-bold border border-rose-500/30">-@heroDiscountPercent%</span>
                                }
                                else
                                {
                                    <span class="font-headline font-black text-2xl text-cyan-300">@string.Format("{0:N0}đ", heroPrice)</span>
                                }
                            </div>
                        </div>

                        <div class="mt-5 pt-4 border-t border-white/15 space-y-1.5 text-xs text-slate-200">
