<img alt="Mac Studio M5 Max and Ultra" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src="https://lh3.googleusercontent.com/aida/AEtjO1UGjwKT-vErxyXSkR0mnnmGqli2fKvIFE66nFJzWcRtKdY1KSWxIf-hRIs_rWgzYDc8lpWU_R7HpdZPM7Lx1-prwitj29dm9SkZkdIqztn9xeJa9vuhmE8Y-56sdDghl4U7l-xou-jjTc7VHu_2-rIWsm-br0zR8xvgjTpMMHQUezqv3p3-V9Q-vNIz3a9CNU7kCnZ5sP41g0v7kI1HOnxiQjVfoTyOYYMXZW1uvWcMqw"/>
</a>
<!-- Quick Utility Card: Smember & Trade-in -->
<div class="bg-gradient-to-br from-primary-container via-brand-red-vibrant to-primary rounded-xl p-3 text-on-primary shadow-sm space-y-2">
<div class="flex items-center justify-between">
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-gold-star text-[20px]">stars</span>
<span class="font-title-sm text-title-sm text-xs font-bold uppercase tracking-wider">Đặc Quyền Smember</span>
</div>
<span class="text-[10px] font-bold bg-surface-card/20 px-2 py-0.5 rounded-full">Tích 5%</span>
</div>
<p class="font-caption-sm text-caption-sm text-on-primary-container text-xs">Đăng ký thành viên nhận voucher giảm 10% ngay!</p>
<div class="grid grid-cols-2 gap-2 pt-1">
<button class="bg-surface-card text-primary-container font-semibold text-xs py-1.5 px-2 rounded-lg text-center hover:bg-on-primary-container transition-colors shadow">
              Định giá cũ 2p
            </button>
<button class="bg-black/20 text-on-primary hover:bg-black/30 font-semibold text-xs py-1.5 px-2 rounded-lg text-center transition-colors">
              Đăng nhập ngay
            </button>
</div>
</div>
</div>
</div>
</section>
<!-- FLASH SALE & HOT DEALS SECTION (HIGH VELOCITY RED THEME) -->
<section class="w-full py-6 bg-gradient-to-b from-badge-discount-bg to-surface-canvas">
<div class="max-w-[1280px] mx-auto px-4 space-y-4">
<!-- Flash Sale Header with Animated Flame & Countdown -->
<div class="bg-gradient-to-r from-primary-container via-brand-red-vibrant to-primary rounded-2xl p-4 text-on-primary shadow-lg flex flex-wrap items-center justify-between gap-4">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-xl bg-surface-card/20 backdrop-blur-md flex items-center justify-center animate-bounce">
<span class="material-symbols-outlined text-[26px] text-gold-star">local_fire_department</span>
</div>
<div>
<div class="flex items-center gap-2">
<h2 class="font-headline-lg text-headline-lg font-extrabold uppercase tracking-tight">FLASH SALE TỰU TRƯỜNG</h2>
<span class="px-2 py-0.5 rounded bg-surface-card text-primary-container font-badge-label text-badge-label font-bold uppercase">Giảm Tới 50%</span>
</div>
<p class="font-caption-sm text-caption-sm text-on-primary-container text-xs">Số lượng có hạn • Tự động kết thúc khi hết suất</p>
</div>
</div>
<!-- Interactive Countdown -->
<div class="flex items-center gap-2 font-headline-md text-headline-md">
<span class="text-xs uppercase tracking-wider font-semibold opacity-90 hidden sm:inline">Kết thúc sau:</span>
<div class="flex items-center gap-1.5 text-on-surface">
<div class="bg-surface-card rounded-lg px-2.5 py-1 text-primary-container font-black shadow" id="hoursBox">02</div>
<span class="text-on-primary font-bold">:</span>
<div class="bg-surface-card rounded-lg px-2.5 py-1 text-primary-container font-black shadow" id="minsBox">45</div>
<span class="text-on-primary font-bold">:</span>
<div class="bg-surface-card rounded-lg px-2.5 py-1 text-primary-container font-black shadow" id="secsBox">18</div>
</div>
</div>
</div>
<!-- Flash Sale 5-Card Product Grid -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5">
@foreach (var product in featuredProducts)
{
    var mainImage = product.ProductImages != null && product.ProductImages.Count > 0 
        ? (product.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageURL ?? product.ProductImages.FirstOrDefault()?.ImageURL)
        : "https://via.placeholder.com/400x400";
    <div class="bg-surface-card rounded-xl p-3 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
        <div class="flex items-center justify-between">
            @if (product.DiscountPrice.HasValue && product.Price > 0)
            {
                var discount = Math.Round((1 - (product.DiscountPrice.Value / product.Price)) * 100);
                <span class="bg-badge-discount-bg text-badge-discount-text font-badge-label text-badge-label font-bold px-2 py-0.5 rounded-full">Giảm @discount%</span>
            }
            else
            {
                <span class="bg-badge-discount-bg text-badge-discount-text font-badge-label text-badge-label font-bold px-2 py-0.5 rounded-full">Hot Deal</span>
            }
            <span class="bg-secondary-fixed text-secondary font-badge-label text-badge-label font-bold px-2 py-0.5 rounded-full">Trả góp 0%</span>
        </div>
        <a href="@Url.Action("Details", "Shop", new { id = product.ProductID })" class="my-3 aspect-square relative flex items-center justify-center overflow-hidden rounded-lg">
            <img alt="@product.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src="@mainImage"/>
        </a>
        <div class="space-y-1.5">
            <h3 class="font-title-sm text-title-sm text-on-surface text-sm font-semibold line-clamp-2 group-hover:text-primary-container transition-colors">
                <a href="@Url.Action("Details", "Shop", new { id = product.ProductID })">@product.Name</a>
            </h3>
            <div class="flex flex-wrap gap-1">
                <span class="bg-badge-spec-bg text-badge-spec-text text-[10px] font-semibold px-1.5 py-0.5 rounded">@(product.Category?.Name ?? "Sản phẩm")</span>
            </div>
            <div class="pt-1">
                @if (product.DiscountPrice.HasValue)
                {
                    <div class="font-price-headline text-price-headline text-primary-container font-bold">@string.Format("{0:N0}₫", product.DiscountPrice)</div>
                    <div class="font-price-original text-price-original text-text-muted line-through text-xs">@string.Format("{0:N0}₫", product.Price)</div>
                }
                else
                {
                    <div class="font-price-headline text-price-headline text-primary-container font-bold">@string.Format("{0:N0}₫", product.Price)</div>
                }
            </div>
            <div class="w-full bg-surface-canvas rounded-full h-3 overflow-hidden relative">
                <div class="bg-gradient-to-r from-brand-red-vibrant to-primary-container h-full rounded-full" style="width: 80%"></div>
                <span class="absolute inset-0 flex items-center justify-center text-[9px] font-bold text-on-primary drop-shadow">Đã bán 80/100</span>
            </div>
        </div>
    </div>
}
</div>
</div>
</section>
<!-- B2B CORPORATE PARTNERSHIP BANNER -->
<section class="max-w-[1280px] mx-auto px-4 py-4 w-full">
<a class="block w-full rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" href="#">
<img alt="Trở thành Khách hàng Doanh nghiệp cùng CellphoneS S-Business" class="w-full h-auto object-cover" src="https://lh3.googleusercontent.com/aida/AEtjO1XBf_C_Et0aedpOZnZDtZ19oQRRmny9EJF_b2V2nFX5DT5_3A3_RKyqljiD1d2skOd2x8sJMGaLtPoYD1io-eD8JoMd_mSTEA4pUwjIOEKS9R_M1bv5fICXC-NlnF7pCbYw1BzVN1FgLQ1Axi5jNZ4C17bdirM2oHq3lLVZo2AEi6sHt6IXAOJH1iOn4KXe9iuVwS9U1RJuJLy3I4jN3YhtjUSZZ9QVDE5qPDQ7Fau2"/>
