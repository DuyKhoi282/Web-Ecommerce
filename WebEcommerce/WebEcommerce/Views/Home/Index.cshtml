        <p class="text-slate-300 text-[11px]">Trợ giá thu cũ tới 4 Triệu • Quà tặng 1.5TR</p>
    </div>
</a>
<!-- Stacked Card 2: MacBook M3 -->
<a class="rounded-2xl overflow-hidden shadow-sm border border-slate-200/90 relative group bg-slate-900 aspect-[690/300] block" href="@Url.Action("Index", "Search", new { q = "MacBook" })">
    <img alt="MacBook Air M3 Series" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90" src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=700&h=300&auto=format&fit=crop&q=80"/>
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent flex flex-col justify-end p-3">
        <span class="inline-block px-2 py-0.5 rounded bg-[#d70018] text-white text-[9px] font-black uppercase tracking-wider w-fit">
            APPLE CHÍNH HÃNG
        </span>
        <h4 class="text-white font-extrabold text-sm mt-1 leading-tight">MacBook Air M3 Series</h4>
        <p class="text-slate-300 text-[11px]">Chỉ từ 24.990.000₫ • Trả góp 0% duyệt 3 phút</p>
    </div>
</a>
<!-- Quick Utility Card: ChillMember & Trade-in -->
<div class="bg-gradient-to-br from-primary-container via-brand-red-vibrant to-primary rounded-2xl p-3.5 text-on-primary shadow-sm space-y-2 border border-red-500/30">
<div class="flex items-center justify-between">
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-gold-star text-[20px]">stars</span>
<span class="font-title-sm text-title-sm text-xs font-bold uppercase tracking-wider">Đặc Quyền ChillMember</span>
</div>
<span class="text-[10px] font-bold bg-surface-card/20 px-2 py-0.5 rounded-full">Tích 5%</span>
</div>
<p class="font-caption-sm text-caption-sm text-on-primary-container text-xs">Đăng ký thành viên nhận voucher giảm 10% ngay!</p>
<div class="grid grid-cols-2 gap-2 pt-1">
<button class="bg-surface-card text-primary-container font-semibold text-xs py-1.5 px-2 rounded-lg text-center hover:bg-on-primary-container transition-colors shadow">
              Định giá cũ 2p
            </button>
<button class="bg-black/20 text-on-primary hover:bg-black/30 font-semibold text-xs py-1.5 px-2 rounded-lg text-center transition-colors">
              Đăng nhập ngay
            </button>
</div>
</div>
</div>
</div>
</section>
<!-- FLASH SALE & HOT DEALS SECTION (HIGH VELOCITY RED THEME) -->
<section class="w-full py-8 bg-gradient-to-b from-rose-50/90 via-white to-slate-100/90 border-y border-rose-200/80 shadow-sm" id="flash-sale-section">
<div class="max-w-[1280px] mx-auto px-4 space-y-4">
@if (hasActiveFlashSale)
{
    <!-- FLASH SALE TIMELINE TABS (SHOPEE / LAZADA STYLE) -->
    <div class="flex items-center justify-between gap-3 flex-wrap border-b border-rose-200/80 pb-3">
        <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full">
            @foreach (var fs in flashSales)
            {
                var isLive = fs.StartTime <= DateTime.UtcNow && fs.EndTime > DateTime.UtcNow;
                var isSelected = fs.FlashSaleID == activeFlashSaleId;
                var startTimeLocal = fs.StartTime.ToLocalTime();
                var isToday = startTimeLocal.Date == DateTime.Now.Date;
                var timeLabel = isToday ? startTimeLocal.ToString("HH:mm") : startTimeLocal.ToString("dd/MM HH:mm");
                
                <button type="button" 
                        onclick="switchFlashSaleTab(@fs.FlashSaleID)"
                        id="fs-tab-btn-@fs.FlashSaleID"
                        class="fs-slot-tab px-4 py-2.5 rounded-xl text-left transition-all duration-200 flex flex-col items-center justify-center min-w-[130px] border @(isSelected ? "bg-gradient-to-r from-red-600 via-brand-red-vibrant to-rose-600 text-white shadow-md border-red-600 scale-[1.02]" : "bg-white text-slate-700 hover:bg-rose-50/50 hover:text-red-600 border-slate-200/90")">
                    <span class="font-black text-base leading-tight font-jakarta tracking-tight">@timeLabel</span>
                    <span class="text-[11px] font-bold uppercase tracking-wider flex items-center gap-1 mt-0.5 opacity-90">
                        @if (isLive)
                        {
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-300 animate-ping"></span>
                            <span>Đang diễn ra</span>
                        }
                        else
                        {
                            <span>Sắp diễn ra</span>
                        }
                    </span>
                </button>
            }
        </div>

        <a href="@Url.Action("Live", "FlashSale")" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-extrabold text-brand-red-vibrant hover:text-red-700 transition-colors bg-white px-3.5 py-2 rounded-xl border border-red-200 shadow-sm hover:shadow shrink-0 ml-auto group">
            <span>Xem tất cả Flash Sale</span>
            <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </a>
    </div>

    <!-- FLASH SALE PANELS FOR EACH SALE -->
    foreach (var fs in flashSales)
    {
        var isTabVisible = fs.FlashSaleID == activeFlashSaleId;
        var isLive = fs.StartTime <= DateTime.UtcNow && fs.EndTime > DateTime.UtcNow;
        // DB đã lưu UTC (timestamp không tz, Kind=Unspecified): gọi ToUniversalTime sẽ trừ thêm 7 tiếng
        var targetTimeIso = (isLive ? fs.EndTime : fs.StartTime).ToString("yyyy-MM-ddTHH:mm:ssZ");
        var items = fs.FlashSaleItems?.Where(i => i.Product != null && i.Product.Status != 3).ToList() ?? new List<FlashSaleItem>();
        if (!items.Any()) { continue; }

        <div id="fs-panel-@fs.FlashSaleID" class="fs-slot-panel space-y-4 @(isTabVisible ? "" : "hidden")">
            <!-- Flash Sale Header with Animated Flame & Countdown -->
            <div class="bg-gradient-to-r from-primary-container via-brand-red-vibrant to-primary rounded-2xl p-4 sm:p-5 text-on-primary shadow-lg border border-red-500/40 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-surface-card/20 backdrop-blur-md flex items-center justify-center animate-bounce shadow-sm">
                        <span class="material-symbols-outlined text-[26px] text-gold-star">local_fire_department</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="font-headline-lg text-headline-lg font-extrabold uppercase tracking-tight">@fs.Title</h2>
                            <span class="px-2 py-0.5 rounded bg-surface-card text-primary-container font-badge-label text-badge-label font-bold uppercase shadow-sm">Giảm Sốc Tới 50%</span>
                        </div>
                        <p class="font-caption-sm text-caption-sm text-on-primary-container text-xs">
                            @(string.IsNullOrWhiteSpace(fs.Description) ? "Số lượng có hạn • Tự động kết thúc khi hết suất" : fs.Description)
                        </p>
                    </div>
                </div>

                <!-- Interactive Countdown Timer -->
                <div class="flex items-center gap-2 font-headline-md text-headline-md fs-timer-instance" 
                     data-targettime="@targetTimeIso" 
                     data-islive="@(isLive ? "true" : "false")">
                    <span class="text-xs uppercase tracking-wider font-semibold opacity-90 hidden sm:inline fs-timer-label">
                        @(isLive ? "Kết thúc sau:" : "Bắt đầu sau:")
                    </span>
                    <div class="flex items-center gap-1.5 text-on-surface">
                        <div class="hidden items-center gap-1 fs-days-container">
                            <div class="bg-surface-card rounded-lg px-2.5 py-1 text-primary-container font-black shadow text-sm sm:text-base fs-days-box">00</div>
                            <span class="text-on-primary font-bold">d</span>
                        </div>
                        <div class="bg-surface-card rounded-lg px-2.5 py-1 text-primary-container font-black shadow text-sm sm:text-base fs-hours-box">00</div>
                        <span class="text-on-primary font-bold">:</span>
                        <div class="bg-surface-card rounded-lg px-2.5 py-1 text-primary-container font-black shadow text-sm sm:text-base fs-mins-box">00</div>
                        <span class="text-on-primary font-bold">:</span>
                        <div class="bg-surface-card rounded-lg px-2.5 py-1 text-primary-container font-black shadow text-sm sm:text-base fs-secs-box">00</div>
                    </div>
                </div>
            </div>

            <!-- Flash Sale Product Grid -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5 reveal-stagger">
                @foreach (var fsi in items)
                {
                    var product = fsi.Product;
                    var mainImage = product.ProductImages != null && product.ProductImages.Count > 0 
                        ? (product.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageURL ?? product.ProductImages.FirstOrDefault()?.ImageURL)
                        : "https://via.placeholder.com/400x400";

                    var discountPct = product.Price > 0 
                        ? Math.Round((1 - (fsi.FlashSalePrice / product.Price)) * 100) 
                        : 0;

                    var soldPercent = fsi.MaxQuantity > 0 
                        ? (int)((double)fsi.SoldQuantity / fsi.MaxQuantity * 100) 
                        : 0;
                    if (soldPercent > 100) { soldPercent = 100; }
                    var isSoldOut = fsi.SoldQuantity >= fsi.MaxQuantity || product.StockQuantity <= 0;

                    <div class="bg-white rounded-2xl p-3.5 shadow-sm border border-slate-200/90 hover:border-red-500 hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
                        <!-- Badges -->
                        <div class="flex items-center justify-between">
                            <span class="bg-gradient-to-r from-red-600 to-rose-600 text-white font-badge-label text-badge-label font-bold px-2 py-0.5 rounded-full shadow-sm flex items-center gap-0.5">
                                <span class="material-symbols-outlined text-[12px]">bolt</span>
                                -@discountPct%
                            </span>
                            <span class="bg-secondary-fixed text-secondary font-badge-label text-badge-label font-bold px-2 py-0.5 rounded-full">Trả góp 0%</span>
                        </div>

                        <!-- Product Image -->
                        <a href="@Url.Action("Details", "Shop", new { id = product.ProductID })" class="my-3 aspect-square relative flex items-center justify-center overflow-hidden rounded-xl bg-slate-50 p-2 border border-slate-100 group-hover:border-slate-200 transition-colors">
                            <img alt="@product.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src="@mainImage" onerror="this.src='https://placehold.co/400x400?text=SP';" />
                            @if (isSoldOut)
                            {
                                <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px] flex items-center justify-center">
                                    <span class="bg-red-600 text-white text-xs font-black uppercase px-2.5 py-1 rounded-md shadow">Hết suất sale</span>
                                </div>
                            }
                        </a>

                        <!-- Product Info -->
                        <div class="space-y-1.5">
                            <h3 class="font-title-sm text-title-sm text-on-surface text-sm font-semibold line-clamp-2 group-hover:text-primary-container transition-colors">
                                <a href="@Url.Action("Details", "Shop", new { id = product.ProductID })">@product.Name</a>
                            </h3>
                            <div class="flex flex-wrap gap-1">
                                <span class="bg-slate-100 text-slate-600 text-[10px] font-semibold px-1.5 py-0.5 rounded border border-slate-200/60">@(product.Category?.Name ?? "Sản phẩm")</span>
                            </div>

                            <!-- Pricing -->
                            <div class="pt-1">
                                <div class="font-price-headline text-price-headline text-primary-container font-black text-base sm:text-lg">
                                    @string.Format("{0:N0}₫", fsi.FlashSalePrice)
                                </div>
