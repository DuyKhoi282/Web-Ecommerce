@model WebEcommerce.Models.Product
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var relatedProducts = ViewBag.RelatedProducts as List<WebEcommerce.Models.Product>;
    var mainImage = Model.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageURL 
                    ?? Model.ProductImages.FirstOrDefault()?.ImageURL 
                    ?? "https://placehold.co/800x800/f8faff/0d47a1?text=TheChillShop";
    
    int discountPercent = 0;
    if (Model.DiscountPrice.HasValue && Model.DiscountPrice.Value > 0 && Model.DiscountPrice.Value < Model.Price && Model.Price > 0)
    {
        discountPercent = (int)Math.Round((Model.Price - Model.DiscountPrice.Value) / Model.Price * 100);
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
            <li><a href="@Url.Action("Index", "Home")" class="hover:text-[#0d47a1] transition-colors">Trang chủ</a></li>
            <li><span class="material-symbols-outlined text-sm">chevron_right</span></li>
            <li><a href="@Url.Action("Index", "Shop")" class="hover:text-[#0d47a1] transition-colors">Sản phẩm</a></li>
            @if (Model.Category != null)
            {
                <li><span class="material-symbols-outlined text-sm">chevron_right</span></li>
                <li><a href="@Url.Action("Category", "Shop", new { id = Model.CategoryID })" class="hover:text-[#0d47a1] transition-colors">@Model.Category.Name</a></li>
            }
            <li><span class="material-symbols-outlined text-sm">chevron_right</span></li>
            <li class="font-semibold text-slate-800 line-clamp-1">@Model.Name</li>
        </ol>
    </nav>

    <div class="bg-white rounded-3xl border-2 border-slate-200 p-6 md:p-8 lg:p-10 mb-12 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
            <!-- Cột trái: Hình ảnh -->
            <div class="flex flex-col gap-4">
                <div class="relative w-full aspect-square rounded-2xl border-2 border-slate-100 bg-slate-50 overflow-hidden flex items-center justify-center p-4">
                    @if (discountPercent > 0)
                    {
                        <span class="absolute top-4 left-4 z-10 px-3 py-1.5 rounded-xl text-xs font-black uppercase bg-red-600 text-white shadow-lg tracking-wider">
                            Giảm @discountPercent%
                        </span>
                    }
                    <img id="mainProductImage" src="@mainImage" alt="@Model.Name" class="w-full h-full object-contain mix-blend-multiply" />
                </div>
                
                @if (Model.ProductImages.Count > 1)
                {
                    <div class="flex items-center gap-3 overflow-x-auto pb-2 custom-scrollbar">
                        @foreach (var img in Model.ProductImages.OrderBy(i => i.DisplayOrder))
                        {
                            <button onclick="changeMainImage('@img.ImageURL', this)" class="thumbnail-btn w-20 h-20 flex-shrink-0 rounded-xl border-2 @(img.ImageURL == mainImage ? "border-[#0d47a1] ring-2 ring-[#00b4d8]/30" : "border-slate-200 hover:border-[#0d47a1]/50") bg-slate-50 overflow-hidden p-1 transition-all">
                                <img src="@img.ImageURL" class="w-full h-full object-contain mix-blend-multiply pointer-events-none" />
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Cột phải: Thông tin -->
            <div class="flex flex-col">
                @if (Model.Category != null)
                {
                    <a href="@Url.Action("Category", "Shop", new { id = Model.CategoryID })" class="text-sm font-black uppercase tracking-wider text-[#00b4d8] mb-2 hover:text-[#0d47a1] transition-colors inline-block w-fit">
                        @Model.Category.Name
                    </a>
                }
                
                <h1 class="font-headline font-extrabold text-2xl sm:text-3xl lg:text-4xl text-slate-900 leading-tight mb-4">
                    @Model.Name
                </h1>

                <div class="flex items-center gap-4 mb-6 pb-6 border-b-2 border-slate-100">
                    <div class="flex items-center gap-1.5">
                        <div class="flex items-center text-amber-500 text-sm">
                            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">star</span>
                        </div>
                        <span class="text-sm text-slate-600 font-bold">5.0 <span class="font-normal text-slate-400">(@Model.Reviews.Count đánh giá)</span></span>
                    </div>
                    <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                    <span class="text-sm text-slate-500 font-medium">Đã bán: <span class="text-slate-800 font-bold">120+</span></span>
                    <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                    <span class="text-sm text-slate-500 font-medium">Kho: <span class="text-slate-800 font-bold">@Model.StockQuantity</span></span>
                </div>

                <div class="mb-8">
                    @if (Model.DiscountPrice.HasValue && Model.DiscountPrice.Value > 0)
                    {
                        <div class="flex items-end gap-3">
                            <span class="font-headline font-black text-3xl sm:text-4xl text-[#0d47a1]">
                                @Model.DiscountPrice.Value.ToString("N0")₫
                            </span>
                            <span class="text-lg text-slate-400 line-through font-bold pb-1">
                                @Model.Price.ToString("N0")₫
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="font-headline font-black text-3xl sm:text-4xl text-[#0d47a1]">
                            @Model.Price.ToString("N0")₫
                        </span>
                    }
                </div>

                <!-- Tình trạng / CTA -->
                <div class="mt-auto pt-6 border-t-2 border-slate-100">
                    @if (Model.StockQuantity > 0)
                    {
                        <div class="flex items-center gap-3 mb-6">
                            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-emerald-100 text-emerald-600">
                                <span class="material-symbols-outlined text-sm font-bold">check</span>
                            </span>
                            <span class="font-bold text-emerald-600">Còn hàng</span>
                            @if (Model.StockQuantity < 5)
                            {
                                <span class="text-xs bg-amber-100 text-amber-700 px-2 py-1 rounded-lg font-bold ml-2">Chỉ còn @Model.StockQuantity SP</span>
                            }
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3">
                            <!-- Input Số lượng -->
                            <div class="flex items-center border-2 border-slate-200 rounded-xl overflow-hidden h-12 w-full sm:w-32 flex-shrink-0">
                                <button type="button" onclick="updateQty(-1)" class="w-10 h-full flex items-center justify-center bg-slate-50 hover:bg-slate-100 text-slate-600 transition-colors"><span class="material-symbols-outlined text-sm">remove</span></button>
                                <input type="number" id="qtyInput" value="1" min="1" max="@Model.StockQuantity" class="w-full h-full text-center font-bold text-slate-800 outline-none p-0 border-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
                                <button type="button" onclick="updateQty(1)" class="w-10 h-full flex items-center justify-center bg-slate-50 hover:bg-slate-100 text-slate-600 transition-colors"><span class="material-symbols-outlined text-sm">add</span></button>
                            </div>

                            <!-- Buttons -->
                            <button type="button" onclick="if(window.addToCart){addToCart(@Model.ProductID, document.getElementById('qtyInput').value);}else{alert('Thêm giỏ hàng (TV3)')}" 
                                    class="flex-1 h-12 flex items-center justify-center gap-2 bg-[#0d47a1] hover:bg-[#0a3880] text-white rounded-xl font-bold transition-all shadow-lg shadow-[#0d47a1]/20 group">
                                <span class="material-symbols-outlined text-lg group-hover:scale-110 transition-transform">shopping_cart</span>
                                Thêm vào giỏ hàng
                            </button>
                            <button type="button" class="w-12 h-12 flex-shrink-0 flex items-center justify-center rounded-xl border-2 border-slate-200 text-slate-400 hover:text-red-500 hover:border-red-500 bg-white transition-all" title="Yêu thích">
                                <span class="material-symbols-outlined text-xl">favorite</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 mb-6">
                            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 text-slate-500">
                                <span class="material-symbols-outlined text-sm font-bold">close</span>
                            </span>
                            <span class="font-bold text-slate-500">Đã hết hàng</span>
                        </div>
                        <button type="button" disabled class="w-full h-12 flex items-center justify-center bg-slate-200 text-slate-500 rounded-xl font-bold cursor-not-allowed">
                            Không thể đặt mua
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Chi tiết mô tả -->
    <div class="bg-white rounded-3xl border-2 border-slate-200 p-6 md:p-8 lg:p-10 mb-12 shadow-sm">
        <h2 class="font-headline font-bold text-xl md:text-2xl text-slate-900 mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-[#0d47a1]">description</span>
            Đặc điểm nổi bật
        </h2>
        <div class="prose prose-slate max-w-none text-slate-600 prose-headings:text-slate-900 prose-a:text-[#0d47a1] hover:prose-a:text-[#00b4d8]">
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                @Html.Raw(Model.Description)
            }
            else
            {
                <p class="text-slate-400 italic">Đang cập nhật mô tả chi tiết cho sản phẩm này.</p>
            }
        </div>
    </div>

    <!-- Sản phẩm liên quan -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <div>
            <h2 class="font-headline font-bold text-2xl text-slate-900 mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-[#0d47a1]">recommend</span>
                Có thể bạn cũng thích
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
                @foreach (var p in relatedProducts)
                {
                    @Html.Partial("_ProductCard", p)
                }
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        function changeMainImage(url, btn) {
            document.getElementById('mainProductImage').src = url;
            // Xóa active class từ tất cả
            var btns = document.querySelectorAll('.thumbnail-btn');
            btns.forEach(b => {
                b.classList.remove('border-[#0d47a1]', 'ring-2', 'ring-[#00b4d8]/30');
                b.classList.add('border-slate-200');
            });
            // Thêm vào button hiện tại
            btn.classList.remove('border-slate-200');
            btn.classList.add('border-[#0d47a1]', 'ring-2', 'ring-[#00b4d8]/30');
        }

        function updateQty(change) {
            var input = document.getElementById('qtyInput');
            var current = parseInt(input.value) || 1;
            var max = parseInt(input.getAttribute('max')) || 1;
            
            var newVal = current + change;
            if (newVal >= 1 && newVal <= max) {
                input.value = newVal;
            }
        }
    </script>
}
