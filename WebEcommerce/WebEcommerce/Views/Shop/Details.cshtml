@section scripts {
    <script>
        function changeMainImage(url, btn) {
            var img = document.getElementById('mainProductImage');
            if (img) img.src = url;
            
            // Xóa active class từ tất cả thumbnail
            var btns = document.querySelectorAll('.thumbnail-btn');
            btns.forEach(b => {
                b.classList.remove('border-primary', 'ring-2', 'ring-primary/20');
                b.classList.add('border-slate-200');
            });
            // Thêm active vào button được click
            btn.classList.remove('border-slate-200');
            btn.classList.add('border-primary', 'ring-2', 'ring-primary/20');
        }

        function updateQty(change) {
            var input = document.getElementById('qtyInput');
            if (!input) return;
            var current = parseInt(input.value) || 1;
            var max = parseInt(input.getAttribute('max')) || 1;
            
            var newVal = current + change;
            if (newVal >= 1 && newVal <= max) {
                input.value = newVal;
            }
        }

        function toggleWishlist(btn) {
            var icon = btn.querySelector('.material-symbols-outlined');
            if (!icon) return;
            
            var isLiked = icon.style.fontVariationSettings && icon.style.fontVariationSettings.includes("'FILL' 1");
            if (isLiked) {
                icon.style.fontVariationSettings = "'FILL' 0";
                icon.classList.remove('text-primary');
                if (window.showToast) {
                    showToast({ type: 'info', message: 'Đã bỏ sản phẩm khỏi danh sách yêu thích.' });
                }
            } else {
                icon.style.fontVariationSettings = "'FILL' 1";
                icon.classList.add('text-primary');
                if (window.showToast) {
                    showToast({ type: 'success', title: 'Yêu thích', message: 'Đã lưu sản phẩm vào danh sách yêu thích của bạn!' });
                }
            }
        }

        function buyNow(productId) {
            var input = document.getElementById('qtyInput');
            var qty = input ? (parseInt(input.value) || 1) : 1;
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new URLSearchParams();
            formData.append('productId', productId);
            formData.append('quantity', qty);
            if (token) formData.append('__RequestVerificationToken', token);
            
            fetch('@Url.Action("AddToCart", "Cart")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            })
            .then(res => {
                if (res.redirected && res.url.toLowerCase().includes('login')) {
                    return { success: false, isAuth: true };
                }
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    // Chuyển ngay đến giỏ hàng để hoàn tất thanh toán
                    window.location.href = '@Url.Action("Index", "Cart")';
                } else {
                    if (data.isAuth || (data.message && (data.message.includes('Phiên đăng nhập') || data.message.includes('đăng nhập')))) {
                        if (window.showToast) {
                            showToast({
                                type: 'warning',
                                title: 'Yêu cầu đăng nhập',
                                message: 'Vui lòng đăng nhập tài khoản để tiến hành đặt mua.',
                                actionText: 'Đăng nhập ngay',
                                duration: 3000,
                                onAction: function() { window.location.href = '@Url.Action("Login", "Account")'; }
                            });
                        }
                        setTimeout(function() {
                            window.location.href = '@Url.Action("Login", "Account")';
                        }, 1800);
                    } else {
                        if (window.showToast) {
                            showToast({ type: 'error', title: 'Thông báo', message: data.message || 'Không thể tiến hành đặt mua.' });
                        }
                    }
                }
            })
            .catch(() => {
                window.location.href = '@Url.Action("Index", "Cart")';
            });
        }

        function toggleDescription() {
            var container = document.getElementById('productDescriptionContainer');
            var overlay = document.getElementById('descGradientOverlay');
            var text = document.getElementById('toggleDescText');
            var icon = document.getElementById('toggleDescIcon');
            
            if (container.classList.contains('max-h-[500px]')) {
                container.classList.remove('max-h-[500px]');
                overlay.classList.add('hidden');
                text.innerText = 'Thu gọn mô tả';
                icon.innerText = 'expand_less';
            } else {
                container.classList.add('max-h-[500px]');
                overlay.classList.remove('hidden');
                text.innerText = 'Xem thêm toàn bộ mô tả';
                icon.innerText = 'expand_more';
                container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    </script>
}
